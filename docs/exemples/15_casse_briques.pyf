# 15. Casse-briques
# La souris (ou les flèches du clavier, tenues enfoncées) déplace la raquette.
# Clic ou Espace : lancer la balle. Casse toutes les briques sans laisser
# tomber la balle : tu as 3 vies ! (Clique d'abord dans le canevas pour
# que le clavier fonctionne.)
# Ton meilleur score est gardé dans l'onglet don0 : voir « Le meilleur score » plus bas.

# --- La taille du canevas ---
# Sur une tablette ou un téléphone, le canevas prend à peu près la forme de l'écran,
# qu'on le tienne en hauteur (portrait) ou en largeur (paysage) : le petit côté garde
# 600 points, le grand côté s'allonge comme celui de l'écran. Sur un ordinateur,
# rien ne change : 800 × 600.
écran = appareil()
si écran[0] != "ordinateur":
    long = entier(600 * minimum(maximum(écran[1], écran[2]) / minimum(écran[1], écran[2]), 1.8))
    long = maximum(long, 800)
    portrait(600, long)
    paysage(long, 600)

# Le mur de briques : 5 rangées de 10 briques
COLONNES = 10
RANGÉES = 5
HAUTEUR_BRIQUE = 24
ÉCART = 4
# les briques se partagent la largeur du canevas (75 points sur 800)
LARGEUR_BRIQUE = (largeur() - 10) // COLONNES - ÉCART
HAUT_DU_MUR = 60
COULEURS = ["rouge", "orange", "jaune", "vert", "bleu"]

ding = charge_son("médias/sounds/ding.wav")
pop = charge_son("médias/sounds/pop.wav")

raquette_l = 110
raquette_h = 14
raquette_x = (largeur() - raquette_l) // 2
raquette_y = hauteur() - 40
rayon = 9

# briques[i] vaut Vrai tant que la brique numéro i n'est pas cassée
briques = [Vrai pour i dans intervalle(COLONNES * RANGÉES)]
restantes = COLONNES * RANGÉES
balle_x = 400.0
balle_y = 540.0
vx = 0.0
vy = 0.0
vitesse = 6.0
vies = 3
score = 0
état = "attente"      # "attente", "jeu", "perdu" ou "gagné"

# --- Le meilleur score ---
# Les records des jeux sont rangés dans l'onglet don0 (bouton ▦ Base), en JSON :
# un dictionnaire qui donne le record de chaque jeu, par exemple {"Astéroïdes": 1250, "Serpent": 18}.
# Si don0 contient déjà autre chose (tes propres données), on n'y touche pas :
# le record ne vaut alors que le temps de l'exécution.
JEU = "Casse-briques"
records_rangés = Vrai     # Faux si don0 contient autre chose que les records

# le dictionnaire des records ({} si don0 est vide)
fonction lit_records():
    t = prend_base("don0")
    si t == "":
        retourne {}
    essaie:
        d = analyse_json(t)
    sauf:
        records_rangés =: Faux     # don0 contient un texte qui n'est pas du JSON
        retourne {}
    si typede(d) == "dictionnaire":
        retourne d
    records_rangés =: Faux         # du JSON, mais pas un dictionnaire
    retourne {}

fonction record_du_jeu():
    d = lit_records()
    si JEU dans d:
        retourne d[JEU]
    retourne 0

fonction range_record(valeur):
    d = lit_records()
    si records_rangés:
        d[JEU] = valeur
        range_base("don0", en_json(d))

record = record_du_jeu()
nouveau_record = Faux

# Appelée quand la partie est finie : un meilleur score devient le record
fonction fin_de_partie():
    si score > record:
        record =: score
        nouveau_record =: Vrai
        range_record(score)

# La position d'une brique se calcule à partir de son numéro
fonction brique_x(i):
    retourne 5 + (i % COLONNES) * (LARGEUR_BRIQUE + ÉCART)

fonction brique_y(i):
    retourne HAUT_DU_MUR + (i // COLONNES) * (HAUTEUR_BRIQUE + ÉCART)

# La balle attend, posée sur la raquette
fonction pose_balle():
    balle_x =: raquette_x + raquette_l / 2
    balle_y =: raquette_y - rayon - 1

fonction recommence():
    pour i dans intervalle(longueur(briques)):
        briques[i] = Vrai
    restantes =: COLONNES * RANGÉES
    vies =: 3
    score =: 0
    vitesse =: 6.0
    nouveau_record =: Faux
    état =: "attente"
    pose_balle()

fonction lance():
    si état == "attente":
        vx =: choisis([-3.0, 3.0])
        vy =: -vitesse
        état =: "jeu"
    sinonsi état == "perdu" ou état == "gagné":
        recommence()

# La raquette ne sort pas du canevas
fonction place_raquette(centre):
    raquette_x =: minimum(maximum(centre - raquette_l / 2, 0.0), largeur() - raquette_l)
    si état == "attente":
        pose_balle()

fonction souris(x, y):
    place_raquette(x)

fonction clic(x, y):
    lance()

# Espace lance la balle ; les flèches sont lues dans image(), tant qu'elles sont tenues
fonction clavier(t):
    si t == "espace":
        lance()

# Les flèches tenues déplacent la raquette doucement, à chaque image
fonction pilote_clavier():
    centre = raquette_x + raquette_l / 2
    si touche_enfoncée("gauche"):
        place_raquette(centre - 9)
    si touche_enfoncée("droite"):
        place_raquette(centre + 9)

# Une brique touchée disparaît, et la balle rebondit
fonction casse_brique():
    pour i dans intervalle(longueur(briques)):
        si briques[i]:
            x = brique_x(i)
            y = brique_y(i)
            dedans_x = balle_x + rayon > x et balle_x - rayon < x + LARGEUR_BRIQUE
            dedans_y = balle_y + rayon > y et balle_y - rayon < y + HAUTEUR_BRIQUE
            si dedans_x et dedans_y:
                briques[i] = Faux
                restantes -= 1
                # les rangées du haut rapportent plus de points
                score += 10 * (RANGÉES - i // COLONNES)
                # touchée par le côté : la balle repart de côté, sinon vers le haut ou le bas
                si balle_x < x ou balle_x > x + LARGEUR_BRIQUE:
                    vx =: -vx
                sinon:
                    vy =: -vy
                # la balle va un peu plus vite à chaque brique
                vitesse =: minimum(vitesse + 0.08, 11.0)
                joue_son(ding)
                si restantes == 0:
                    état =: "gagné"
                    fin_de_partie()
                sortir

fonction avance_balle():
    balle_x += vx
    balle_y += vy
    # Les murs de gauche, de droite et du haut
    si balle_x < rayon:
        balle_x =: rayon
        vx =: absolu(vx)
    sinonsi balle_x > largeur() - rayon:
        balle_x =: largeur() - rayon
        vx =: -absolu(vx)
    si balle_y < rayon:
        balle_y =: rayon
        vy =: absolu(vy)
    # La raquette : plus la balle la touche loin du centre, plus elle part de côté
    sur_raquette = balle_x > raquette_x - rayon et balle_x < raquette_x + raquette_l + rayon
    à_hauteur = balle_y + rayon >= raquette_y et balle_y < raquette_y + raquette_h
    si vy > 0 et sur_raquette et à_hauteur:
        décalage = (balle_x - (raquette_x + raquette_l / 2)) / (raquette_l / 2)
        décalage = minimum(maximum(décalage, -0.85), 0.85)
        vx =: décalage * vitesse
        vy =: -racine(vitesse * vitesse - vx * vx)
        balle_y =: raquette_y - rayon
        joue_son(pop)
    casse_brique()
    # La balle est tombée
    si balle_y > hauteur() + rayon:
        vies -= 1
        si vies == 0:
            état =: "perdu"
            fin_de_partie()
        sinon:
            état =: "attente"
            pose_balle()

# Un texte centré dans la largeur, à la hauteur y
fonction texte_centré(y, t):
    texte((largeur() - largeur_texte(t)) / 2, y, t)

fonction dessine():
    fond("bleu marine")
    pour i dans intervalle(longueur(briques)):
        si briques[i]:
            couleur(COULEURS[i // COLONNES])
            rectangle_plein(brique_x(i), brique_y(i), LARGEUR_BRIQUE, HAUTEUR_BRIQUE)
    couleur("blanc")
    rectangle_plein(raquette_x, raquette_y, raquette_l, raquette_h)
    couleur("jaune")
    disque(balle_x, balle_y, rayon)
    couleur("blanc")
    taille_texte(18)
    texte(10, 20, f"Score : {score}")
    texte(largeur() - 100, 20, f"Vies : {vies}")
    taille_texte(26)
    milieu = hauteur() // 2
    si état == "attente":
        texte_centré(milieu + 80, "Clic ou Espace : lancer la balle")
        si record > 0:
            texte_centré(milieu + 130, f"Meilleur score : {record}")
    sinonsi état == "perdu":
        texte_centré(milieu + 40, f"Perdu ! Score : {score}")
        texte_centré(milieu + 90, "Clic ou Espace : rejouer")
        si nouveau_record:
            couleur("jaune")
            texte_centré(milieu + 140, "Nouveau record !")
        sinon:
            texte_centré(milieu + 140, f"Meilleur score : {record}")
    sinonsi état == "gagné":
        couleur("jaune")
        texte_centré(milieu + 40, f"Bravo, tout est cassé ! Score : {score}")
        texte_centré(milieu + 90, "Clic ou Espace : rejouer")
        si nouveau_record:
            couleur("jaune")
            texte_centré(milieu + 140, "Nouveau record !")
        sinon:
            texte_centré(milieu + 140, f"Meilleur score : {record}")

# On a tourné le téléphone : le canevas a changé de taille.
# On refait le mur à la nouvelle largeur et on ramène la raquette et la balle dedans.
ancienne_largeur = largeur()
ancienne_hauteur = hauteur()

fonction recale():
    ancienne_largeur =: largeur()
    ancienne_hauteur =: hauteur()
    LARGEUR_BRIQUE =: (largeur() - 10) // COLONNES - ÉCART
    raquette_y =: hauteur() - 40
    place_raquette(raquette_x + raquette_l / 2)
    balle_x =: minimum(balle_x, largeur() - rayon)
    balle_y =: minimum(balle_y, raquette_y - rayon - 1)

fonction image():
    si largeur() != ancienne_largeur ou hauteur() != ancienne_hauteur:
        recale()
    pilote_clavier()
    si état == "jeu":
        avance_balle()
    dessine()

cache_tortue()
pose_balle()
quand_souris(souris)
quand_glisse(souris)      # sur une tablette : glisser le doigt
quand_clic(clic)
quand_touche(clavier)
animer(image, 16)
