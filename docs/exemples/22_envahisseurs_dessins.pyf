# 22. Les envahisseurs de l'espace, avec des dessins
# Le même jeu que l'exemple 17, en plus riche : un ciel en dégradé, une nébuleuse,
# une planète à anneau, une ville illuminée, des envahisseurs détaillés et quatre
# boucliers en petits blocs que les tirs et les bombes grignotent.
# La souris (ou les flèches) déplace ton vaisseau, un clic (ou Espace) tire.
# Détruis les envahisseurs avant qu'ils n'arrivent en bas, et évite leurs bombes :
# tu as 3 vies ! (Clique d'abord dans le canevas pour que le clavier fonctionne,
# ou passe en plein écran.)
#
# Ce qui change rarement est préparé dans des dessins (nouveau_dessin) : le décor une
# fois pour toutes, la flotte à chacun de ses pas, les boucliers quand un bloc saute.
# À chaque image, montre_dessin les dessine en un seul appel chacun.
# Touche D : compare avec les mêmes dessins refaits à chaque image, ce qui revient à
# dessiner chaque forme une par une. Le temps de dessin s'affiche en bas.
# Ton meilleur score est gardé dans l'onglet don0 : voir « Le meilleur score » plus bas.
# Sur une tablette ou un téléphone : le bouton 🔥 Feu tire, et le doigt pilote.

# La flotte : 5 rangées de 10 envahisseurs
COLONNES = 10
RANGÉES = 5
PAS_X = 56            # distance entre deux envahisseurs
PAS_Y = 44
LARGEUR_ENV = 36
HAUTEUR_ENV = 24
COULEURS = ["magenta", "violet clair", "bleu clair", "turquoise", "vert clair"]

son_tir = charge_son("médias/sounds/tir.wav")
son_explosion = charge_son("médias/sounds/explosion.wav")
son_boum = charge_son("médias/sounds/boum.wav")
# la marche des envahisseurs : quatre notes graves, jouées l'une après l'autre
pas_de_marche = [charge_son(f"médias/sounds/pas_{i}.wav") pour i dans intervalle(1, 5)]

# Le vaisseau
vaisseau_x = 400
VAISSEAU_Y = 550

# vivants[i] vaut Vrai tant que l'envahisseur numéro i n'est pas détruit
vivants = []
flotte_x = 100        # le coin en haut à gauche de la flotte
flotte_y = 70
sens = 1              # 1 : vers la droite, -1 : vers la gauche
attente = 0           # images avant le prochain pas de la flotte
pas_joué = 0          # le numéro de la note de marche
tir_actif = Faux
tir_x = 0
tir_y = 0
bombes = []           # chaque bombe est [x, y]
explosions = []       # [x, y, durée] : le petit éclat d'un envahisseur touché
vies = 3
score = 0
vague = 1
clignote = 0          # le vaisseau clignote après avoir été touché
état = "attente"      # "attente", "jeu" ou "perdu"

# --- Le meilleur score ---
# Les records des jeux sont rangés dans l'onglet don0 (bouton ▦ Données), en JSON :
# un dictionnaire qui donne le record de chaque jeu, par exemple {"Astéroïdes": 1250, "Serpent": 18}.
# Si don0 contient déjà autre chose (tes propres données), on n'y touche pas :
# le record ne vaut alors que le temps de l'exécution.
JEU = "Envahisseurs (dessins)"
records_rangés = Vrai     # Faux si don0 contient autre chose que les records

# le dictionnaire des records ({} si don0 est vide)
fonction lit_records():
    t = prend_données("don0")
    si t == "":
        retourne {}
    essaie:
        d = analyse_json(t)
    sauf:
        records_rangés =: Faux     # don0 contient un texte qui n'est pas du JSON
        retourne {}
    si typede(d) == "dictionnaire":
        retourne d
    records_rangés =: Faux         # du JSON, mais pas un dictionnaire
    retourne {}

fonction record_du_jeu():
    d = lit_records()
    si JEU dans d:
        retourne d[JEU]
    retourne 0

fonction range_record(valeur):
    d = lit_records()
    si records_rangés:
        d[JEU] = valeur
        range_données("don0", en_json(d))

record = record_du_jeu()
nouveau_record = Faux

# Appelée quand la partie est finie : un meilleur score devient le record
fonction fin_de_partie():
    si score > record:
        record =: score
        nouveau_record =: Vrai
        range_record(score)

fonction env_x(i):
    retourne flotte_x + (i % COLONNES) * PAS_X

fonction env_y(i):
    retourne flotte_y + (i // COLONNES) * PAS_Y

fonction restants():
    retourne longueur([v pour v dans vivants si v])

# Une nouvelle vague : plus elle est loin, plus la flotte part bas
fonction nouvelle_vague():
    vivants =: [Vrai pour i dans intervalle(COLONNES * RANGÉES)]
    flotte_x =: 100
    flotte_y =: 70 + minimum(vague - 1, 4) * 15
    sens =: 1
    bombes =: []
    tir_actif =: Faux
    flotte_à_refaire =: Vrai

fonction recommence():
    pose_boucliers()
    vies =: 3
    score =: 0
    vague =: 1
    nouvelle_vague()
    nouveau_record =: Faux
    état =: "jeu"

fonction tire():
    si état != "jeu":
        recommence()
    sinonsi non tir_actif:
        tir_actif =: Vrai
        tir_x =: vaisseau_x
        tir_y =: VAISSEAU_Y - 20
        joue_son(son_tir)

fonction place_vaisseau(x):
    vaisseau_x =: minimum(maximum(x, 30), largeur() - 30)

fonction souris(x, y):
    place_vaisseau(x)

# Sur une tablette ou un téléphone, il n'y a pas de clavier, et toucher l'écran sert à
# piloter : c'est le bouton 🔥 Feu (créé tout en bas) qui tire, à la place du clic
TACTILE = appareil()[0] != "ordinateur"
TIRER = "Clic ou Espace"
si TACTILE:
    TIRER = "Touche 🔥 Feu"

fonction bouton_feu(clef, texte):
    tire()

fonction clic(x, y):
    place_vaisseau(x)
    # sur une tablette, toucher l'écran pilote ; le bouton 🔥 Feu tire (un toucher lance encore la partie)
    si TACTILE et état == "jeu":
        retourne Rien
    tire()

# Espace (ou haut) tire ; les flèches sont lues dans image(), tant qu'elles sont tenues
fonction clavier(t):
    si t == "espace" ou t == "haut":
        tire()
    sinonsi minuscules(t) == "d":
        préparé =: non préparé

# Les flèches tenues déplacent le vaisseau en douceur, à chaque image
fonction pilote_clavier():
    si touche_enfoncée("gauche"):
        place_vaisseau(vaisseau_x - 6)
    si touche_enfoncée("droite"):
        place_vaisseau(vaisseau_x + 6)

# La flotte avance par petits pas ; moins il reste d'envahisseurs, plus elle va vite
fonction avance_flotte():
    attente -= 1
    si attente > 0:
        retourne Rien
    attente =: maximum(2, restants() // 2 + 4 - vague)
    joue_son(pas_de_marche[pas_joué % 4])
    pas_joué += 1
    # Le bord le plus à gauche et le plus à droite des envahisseurs encore là
    gauche = largeur()
    droite = 0
    pour i dans intervalle(longueur(vivants)):
        si vivants[i]:
            gauche = minimum(gauche, env_x(i))
            droite = maximum(droite, env_x(i) + LARGEUR_ENV)
    au_bord_droit = sens == 1 et droite + 12 > largeur()
    au_bord_gauche = sens == -1 et gauche - 12 < 0
    si au_bord_droit ou au_bord_gauche:
        # au bord : la flotte descend et repart dans l'autre sens
        flotte_y += 20
        sens =: -sens
    sinon:
        flotte_x += 12 * sens
    flotte_à_refaire =: Vrai

# De temps en temps, un envahisseur lâche une bombe
fonction lâche_bombes():
    si aléatoire(1, 100) <= 2 + vague et longueur(bombes) < 3 + vague:
        i = aléatoire(0, longueur(vivants) - 1)
        si vivants[i]:
            bombes.ajoute([env_x(i) + LARGEUR_ENV / 2, env_y(i) + HAUTEUR_ENV])

fonction avance_tir():
    si non tir_actif:
        retourne Rien
    tir_y -= 12
    si tir_y < 0:
        tir_actif =: Faux
        retourne Rien
    si touche_bouclier(tir_x, tir_y):
        tir_actif =: Faux
        retourne Rien
    pour i dans intervalle(longueur(vivants)):
        si vivants[i]:
            x = env_x(i)
            y = env_y(i)
            si tir_x > x et tir_x < x + LARGEUR_ENV et tir_y > y et tir_y < y + HAUTEUR_ENV:
                vivants[i] = Faux
                tir_actif =: Faux
                flotte_à_refaire =: Vrai
                # les rangées du haut rapportent plus de points
                score += 10 * (RANGÉES - i // COLONNES)
                explosions.ajoute([x + LARGEUR_ENV / 2, y + HAUTEUR_ENV / 2, 8])
                joue_son(son_explosion)
                sortir

fonction avance_bombes():
    bombes =: [[b[0], b[1] + 5 + vague] pour b dans bombes si b[1] < hauteur() et non touche_bouclier(b[0], b[1] + 10)]
    si clignote > 0:
        retourne Rien
    # on cherche d'abord si une bombe touche le vaisseau ; touché() vide la liste
    # des bombes, ce qu'on ne fait pas pendant qu'on la parcourt
    atteint = Faux
    pour b dans bombes:
        si absolu(b[0] - vaisseau_x) < 24 et absolu(b[1] - VAISSEAU_Y) < 12:
            atteint = Vrai
            sortir
    si atteint:
        touché()

fonction touché():
    vies -= 1
    bombes =: []
    clignote =: 60
    joue_son(son_boum)
    si vies == 0:
        état =: "perdu"
        fin_de_partie()

fonction vérifie_vague():
    si restants() == 0:
        vague += 1
        score += 100
        nouvelle_vague()
        retourne Rien
    # Les envahisseurs arrivent à la hauteur du vaisseau : c'est perdu
    pour i dans intervalle(longueur(vivants)):
        si vivants[i] et env_y(i) + HAUTEUR_ENV > VAISSEAU_Y - 20:
            vies =: 0
            état =: "perdu"
            fin_de_partie()
            joue_son(son_boum)
            sortir

# --- Les boucliers : 12 x 6 blocs de 6 points, avec une arche en bas ---
BOUCLIER_X = [110, 290, 470, 650]
BOUCLIER_Y = 470
BLOC = 6
VERTS = ["#43a047", "#66bb6a"]
boucliers = []        # pour chaque bouclier, Vrai tant que le bloc est là (ligne après ligne)

fonction pose_boucliers():
    boucliers =: []
    pour k dans intervalle(4):
        blocs = []
        pour b dans intervalle(72):
            ligne_b = b // 12
            colonne = b % 12
            arche = ligne_b >= 4 et colonne >= 4 et colonne <= 7
            coin = ligne_b == 0 et (colonne == 0 ou colonne == 11)
            plein = non (arche ou coin)
            blocs.ajoute(plein)
        boucliers.ajoute(blocs)
    boucliers_à_refaire =: Vrai

# Un tir ou une bombe en (x, y) touche-t-il un bloc ? Le bloc saute, avec un voisin
fonction touche_bouclier(x, y):
    si y < BOUCLIER_Y ou y >= BOUCLIER_Y + 6 * BLOC:
        retourne Faux
    pour k dans intervalle(4):
        si x >= BOUCLIER_X[k] et x < BOUCLIER_X[k] + 12 * BLOC:
            colonne = entier((x - BOUCLIER_X[k]) // BLOC)
            ligne_b = entier((y - BOUCLIER_Y) // BLOC)
            b = ligne_b * 12 + colonne
            si boucliers[k][b]:
                boucliers[k][b] = Faux
                voisin = b + choisis([-1, 1, -12, 12])
                si voisin >= 0 et voisin < 72:
                    boucliers[k][voisin] = Faux
                boucliers_à_refaire =: Vrai
                retourne Vrai
    retourne Faux

# --- Les dessins ---
# Le décor est tiré une fois au hasard : il est le même à chaque image
étoiles = [[aléatoire(0, 800), aléatoire(0, 470), 0.5 + hasard() * 1.5, choisis(["#ffffff", "#bbdefb", "#fff9c4", "#f8bbd0"])] pour i dans intervalle(260)]
nuages = [[480 + (hasard() - 0.5) * 300, 150 + (hasard() - 0.5) * 160, 15 + hasard() * 45, choisis(["150, 80, 200", "80, 120, 220", "200, 80, 160"])] pour i dans intervalle(110)]
immeubles = []        # chaque immeuble : [x, largeur, hauteur, fenêtres allumées]
x_imm = 0
tantque x_imm < 800:
    l_imm = aléatoire(20, 44)
    h_imm = aléatoire(18, 60)
    fenêtres = [[aléatoire(0, l_imm // 7 - 1) * 7 + 3, aléatoire(0, h_imm // 8 - 1) * 8 + 3] pour k dans intervalle(aléatoire(2, 9))]
    immeubles.ajoute([x_imm, l_imm, h_imm, fenêtres])
    x_imm += l_imm + aléatoire(0, 4)

décor = nouveau_dessin()
flotte = nouveau_dessin()
défenses = nouveau_dessin()
flotte_à_refaire = Vrai
boucliers_à_refaire = Vrai
préparé = Vrai        # Faux (touche D) : les dessins sont refaits à chaque image
temps_cumulé = 0
images_comptées = 0
temps_moyen = 0.0

fonction prépare_décor():
    vide_dessin(décor)
    # le ciel : 60 bandes, du bleu nuit au violet
    pour i dans intervalle(60):
        décor.couleur(rgb(4 + i * 0.5, 4 + i * 0.3, 20 + i * 0.9))
        décor.rectangle_plein(0, i * 10, 800, 10)
    pour n dans nuages:
        décor.couleur(f"rgba({n[3]}, 0.05)")
        décor.disque(n[0], n[1], n[2])
    pour é dans étoiles:
        décor.couleur(é[3])
        décor.disque(é[0], é[1], é[2])
    # une planète à anneau, au loin
    décor.couleur("#5d4037")
    décor.disque(120, 130, 46)
    décor.couleur("#8d6e63")
    décor.ellipse_pleine(120, 118, 44, 8)
    décor.ellipse_pleine(120, 146, 40, 6)
    décor.couleur("rgba(0, 0, 0, 0.35)")
    décor.disque(136, 140, 40)
    décor.couleur_trait("#d7ccc8")
    décor.épaisseur(3)
    décor.ellipse(120, 130, 80, 14)
    décor.épaisseur(1)
    # la ville, et ses fenêtres allumées
    pour imm dans immeubles:
        décor.couleur("#1a1a2e")
        décor.rectangle_plein(imm[0], 575 - imm[2], imm[1], imm[2])
        décor.couleur("rgba(255, 213, 79, 0.8)")
        pour f dans imm[3]:
            décor.rectangle_plein(imm[0] + f[0], 575 - imm[2] + f[1], 3, 4)
    décor.couleur("vert clair")
    décor.ligne(0, 575, 800, 575)

# Le nombre de formes du décor (le ciel, les nuages, les étoiles, la planète, la ville)
fonction compte_décor():
    n = 60 + longueur(nuages) + longueur(étoiles) + 6 + 1
    pour imm dans immeubles:
        n += 1 + longueur(imm[3])
    retourne n

fonction blocs_restants():
    n = 0
    pour bl dans boucliers:
        n += longueur([b pour b dans bl si b])
    retourne n

formes_décor = compte_décor()

# Un envahisseur : un corps, deux antennes, des yeux, et des pattes qui bougent à chaque pas
fonction ajoute_envahisseur(d, x, y, c):
    d.couleur(c)
    d.rectangle_plein(x + 6, y, LARGEUR_ENV - 12, 6)
    d.rectangle_plein(x, y + 6, LARGEUR_ENV, 10)
    d.rectangle_plein(x + 9, y - 5, 3, 5)
    d.rectangle_plein(x + LARGEUR_ENV - 12, y - 5, 3, 5)
    d.couleur("rgba(255, 255, 255, 0.35)")
    d.rectangle_plein(x + 6, y, LARGEUR_ENV - 12, 2)
    d.couleur("noir")
    d.carré_plein(x + 8, y + 8, 5)
    d.carré_plein(x + LARGEUR_ENV - 13, y + 8, 5)
    d.couleur("rouge clair")
    d.carré_plein(x + 10, y + 10, 2)
    d.carré_plein(x + LARGEUR_ENV - 11, y + 10, 2)
    d.couleur(c)
    si pas_joué % 2 == 0:
        d.rectangle_plein(x + 2, y + 16, 5, 8)
        d.rectangle_plein(x + LARGEUR_ENV - 7, y + 16, 5, 8)
    sinon:
        d.rectangle_plein(x + 8, y + 16, 5, 8)
        d.rectangle_plein(x + LARGEUR_ENV - 13, y + 16, 5, 8)

fonction prépare_flotte():
    vide_dessin(flotte)
    pour i dans intervalle(longueur(vivants)):
        si vivants[i]:
            ajoute_envahisseur(flotte, env_x(i), env_y(i), COULEURS[i // COLONNES])

fonction prépare_défenses():
    vide_dessin(défenses)
    pour k dans intervalle(4):
        pour b dans intervalle(72):
            si boucliers[k][b]:
                # deux verts en damier, pour que les blocs se voient
                défenses.couleur(VERTS[(b // 12 + b) % 2])
                défenses.carré_plein(BOUCLIER_X[k] + (b % 12) * BLOC, BOUCLIER_Y + (b // 12) * BLOC, BLOC)

# Les dessins : préparés quand ils changent, ou refaits à chaque image pour comparer
fonction montre_dessins():
    si non préparé:
        prépare_décor()
        prépare_flotte()
        prépare_défenses()
    sinon:
        si flotte_à_refaire:
            prépare_flotte()
            flotte_à_refaire =: Faux
        si boucliers_à_refaire:
            prépare_défenses()
            boucliers_à_refaire =: Faux
    montre_dessin(décor)
    montre_dessin(défenses)
    montre_dessin(flotte)

fonction dessine_vaisseau():
    # après un choc, le vaisseau clignote : on ne le dessine qu'une image sur deux
    si clignote > 0 et (clignote // 5) % 2 == 0:
        retourne Rien
    couleur("#00c853")
    rectangle_plein(vaisseau_x - 24, VAISSEAU_Y, 48, 12)
    couleur("vert clair")
    rectangle_plein(vaisseau_x - 20, VAISSEAU_Y + 2, 40, 3)
    rectangle_plein(vaisseau_x - 4, VAISSEAU_Y - 10, 8, 10)
    couleur("rgba(0, 230, 118, 0.25)")
    disque(vaisseau_x, VAISSEAU_Y + 6, 30)

fonction dessine():
    # le temps des dessins, en moyenne sur 30 images
    temps_cumulé += a_durée(montre_dessins())
    images_comptées += 1
    si images_comptées == 30:
        temps_moyen =: temps_cumulé / 30
        temps_cumulé =: 0
        images_comptées =: 0
    # les éclats des envahisseurs touchés
    pour e dans explosions:
        couleur(f"rgba(255, 152, 0, {arrondi(e[2] / 8, 2)})")
        disque(e[0], e[1], 22 - e[2] * 2)
        couleur("jaune")
        cercle(e[0], e[1], 12 - e[2])
    dessine_vaisseau()
    si tir_actif:
        couleur("rgba(255, 255, 255, 0.3)")
        rectangle_plein(tir_x - 4, tir_y, 8, 20)
        couleur("blanc")
        rectangle_plein(tir_x - 2, tir_y, 4, 14)
    couleur("rouge clair")
    pour b dans bombes:
        rectangle_plein(b[0] - 2, b[1], 4, 10)
    # le score, les vies, et ce que coûtent les dessins
    couleur("blanc")
    taille_texte(18)
    texte(10, 20, f"Score : {score}")
    texte(340, 20, f"Vague {vague}")
    texte(largeur() - 100, 20, f"Vies : {vies}")
    formes = formes_décor + 10 * restants() + blocs_restants()
    taille_texte(14)
    couleur("rgba(255, 255, 255, 0.8)")
    si préparé:
        texte(10, 580, f"Dessins préparés : {formes} formes en 3 appels par image, {arrondi(temps_moyen, 1)} ms (D : comparer)")
    sinon:
        texte(10, 580, f"Refaits à chaque image : {formes} formes une par une, {arrondi(temps_moyen, 1)} ms (D : revenir)")
    taille_texte(26)
    couleur("blanc")
    si état == "attente":
        texte(165, 330, f"{TIRER} : défendre la Terre !")
        si record > 0:
            texte(270, 380, f"Meilleur score : {record}")
    sinonsi état == "perdu":
        couleur("rouge clair")
        texte(240, 300, f"La Terre est envahie !")
        couleur("blanc")
        texte(270, 345, f"Score : {score}, vague {vague}")
        texte(255, 390, f"{TIRER} : rejouer")
        si nouveau_record:
            couleur("jaune")
            texte(300, 440, "Nouveau record !")
        sinon:
            texte(270, 440, f"Meilleur score : {record}")

fonction image():
    si état == "jeu":
        pilote_clavier()
        avance_flotte()
        lâche_bombes()
        avance_tir()
        avance_bombes()
        vérifie_vague()
        si clignote > 0:
            clignote -= 1
    # les éclats s'effacent peu à peu
    explosions =: [[e[0], e[1], e[2] - 1] pour e dans explosions si e[2] > 1]
    dessine()

cache_tortue()
pose_boucliers()
prépare_décor()
nouvelle_vague()
quand_souris(souris)
quand_glisse(souris)      # sur une tablette : glisser le doigt
# sur une tablette ou un téléphone, le bouton qui tire, à la place du clic
si TACTILE:
    taille_texte(26)
    bouton("feu", 10, 420, "🔥 Feu", bouton_feu)
quand_clic(clic)
quand_touche(clavier)
animer(image, 20)
