(println "Bonjour tout le monde !")
(setq prénom "Léa")
(setq âge 12)
(println "Je m'appelle" (_texte prénom) "et j'ai" (_texte âge) "ans.")
(println (+ "Dans 5 ans, " (_texte prénom) " aura " (_texte (+ âge 5)) " ans."))
(println "7 + 3 =" (_texte (+ 7 3)))
(println "7 / 2 =" (_texte (/ 7 2)))
(println "7 // 2 =" (_texte (_/ 7 2)) "(division entière)")
(println "7 % 2 =" (_texte (_% 7 2)) "(reste)")
(println "2 ** 10 =" (_texte (^^ 2 10)) "(puissance)")
(defun bonjour (nom)
   (println "Enchanté," (_texte nom) "!")
   (demande_nombre "En quelle année es-tu né(e) ?" naissance)
)
(defun naissance (année)
   (println "Tu as environ" (_texte (entier (- 2026 année))) "ans.")
)
(demande "Comment t'appelles-tu ?" bonjour)
