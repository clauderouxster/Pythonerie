(setq note (aléatoire 0 20))
(println "Ta note :" (_texte note))
(if (>= note 16)
   (println "Excellent !")
   (if (>= note 12)
      (println "Bien.")
      (if (>= note 10)
         (println "C'est juste.")
         (println "Il faut retravailler.")
      )
   )
)
(setq pluie true)
(setq température 25)
(if (andvalue (> température 20) (¬ pluie))
   (println "On va à la plage.")
   (println "On reste à la maison.")
)
(println "Fin du programme")
