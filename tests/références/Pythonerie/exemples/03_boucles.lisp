(println "Table de 7 :")
(loop i 
   (irange 1 11 1)
   (println (_texte i) "x 7 =" (_texte (* i 7)))
)
(setq fruits (list "pomme" "poire" "cerise"))
(loop fruit fruits
   (println "J'aime les" (_texte (+ fruit "s")))
)
(setq n 1)
(while (< n 1000) (setq n (* n 2)))
(println "Première puissance de 2 au-delà de 1000 :" (_texte n))
(loop i 
   (irange 0 10 1)
   (if (= i 3)
      (continue)
   )
   (if (= i 7)
      (break)
   )
   (println "i =" (_texte i))
)
