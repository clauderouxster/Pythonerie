(defun aire_rectangle (largeur hauteur)
   (return (* largeur hauteur))
)
(println "Aire :" (_texte (aire_rectangle 5 3)))
(defun factorielle (n)
   (if (<= n 1)
      (return 1)
   )
   (return (* n (factorielle (- n 1))))
)
(loop i 
   (irange 1 8 1)
   (println (_texte i) "! =" (_texte (factorielle i)))
)
(defun fibonacci (n)
   (setq a 0)
   (setq b 1)
   (loop i 
      (irange 0 n 1)
      (setq (a b) (list b (p+ a b)))
   )
   (return a)
)
(println "Les 15 premiers nombres de Fibonacci :")
(println (_texte (mapcar (λ (i) (fibonacci i)) (irange 0 15 1))))
(defun somme (liste)
   (setq total 0)
   (loop x liste
      (setq total (p+ total x))
   )
   (return total)
)
(println "Ma somme :" (_texte (somme (list 4 8 15 16 23 42))))
