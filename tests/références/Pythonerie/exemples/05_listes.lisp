(setq notes (list 12 15 9 18))
(push notes 14)
(println "Notes :" (_texte notes))
(println "Nombre de notes :" (_texte (longueur notes)))
(println "Première :" (_texte (at notes 0)) " dernière :" (_texte (at notes -1)))
(println "Les trois premières :" (_texte (extract notes 0 3)))
(println "Moyenne :" (_texte (arrondi (/ (somme notes) (longueur notes)) 2)))
(println "Meilleure :" (_texte (maximum notes)) " moins bonne :" (_texte (minimum notes)))
(println "Triées :" (_texte (trie notes)))
(setq carrés (mapcar (λ (x) (* x x)) (intervalle 10)))
(setq pairs (filtercar (λ (x) (= (_% x 2) 0)) carrés))
(println (_texte carrés))
(println (_texte pairs))
(if (in_it notes 18)
   (println "Il y a un 18 !")
)
(setq capitales (dictionary "France" "Paris" "Italie" "Rome" "Japon" "Tokyo"))
(set@ capitales "Espagne" "Madrid")
(loop pays capitales
   (println "La capitale de" (_texte pays) "est" (_texte (at capitales pays)))
)
(setq phrase "le petit chat dort")
(setq mots (découpe phrase " "))
(println (_texte mots) (_texte (longueur mots)) "mots")
(println (_texte (majuscules phrase)))
(println (_texte (join mots "-")))
