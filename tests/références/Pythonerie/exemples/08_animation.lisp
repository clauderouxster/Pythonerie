(setq x 100)
(setq y 100)
(setq dx 6)
(setq dy 4.5)
(setq rayon 25)
(defun image ()
   (setg x (p+ x dx))
   (setg y (p+ y dy))
   (if (orvalue (< x rayon) (> x (- (largeur) rayon)))
      (*= dx -1)
   )
   (if (orvalue (< y rayon) (> y (- (hauteur) rayon)))
      (*= dy -1)
   )
   (fond "gris foncé")
   (couleur "orange")
   (disque x y rayon)
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 10 (+ "x = " (_texte (arrondi x)) "   y = " (_texte (arrondi y))))
)
(cache_tortue)
(animer image 20)
