(setq px 400)
(setq py 300)
(setq taille 40)
(setq couleur_carré "bleu")
(defun dessine ()
   (fond "blanc")
   (couleur "gris")
   (taille_texte 16)
   (texte 10 10 "Flèches : déplacer   Espace : changer de couleur   Clic : déposer un point")
   (couleur couleur_carré)
   (carré_plein (- px (/ taille 2)) (- py (/ taille 2)) taille)
)
(defun touche (t)
   (if (= t "gauche")
      (-= px 20)
      (if (= t "droite")
         (+= px 20)
         (if (= t "haut")
            (-= py 20)
            (if (= t "bas")
               (+= py 20)
               (if (= t "espace")
                  (setg couleur_carré (choisis (list "rouge" "vert" "bleu" "violet" "orange")))
               )
            )
         )
      )
   )
   (dessine)
)
(defun clic (x y)
   (couleur "rouge")
   (disque x y 6)
)
(cache_tortue)
(dessine)
(quand_touche touche)
(quand_clic clic)
