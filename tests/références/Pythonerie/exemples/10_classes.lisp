(class@ Compte_ (init)
   (defun __init__ (titulaire solde)
      (setqi titulaire titulaire)
      (setqi solde solde)
   )
   (defun dépose_ (montant)
      (+= solde montant)
      (return solde)
   )
   (defun retire_ (montant)
      (check (> montant solde)
         (println "Refusé : solde insuffisant pour" (_texte titulaire))
         (return solde)
      )
      (-= solde montant)
      (return solde)
   )
   (defun décris_ ()
      (println (_texte titulaire) "possède" (_texte solde) "euros")
   )
)
(defun Compte (titulaire solde)
   (Compte_ (__init__ titulaire solde))
)
(defpat dépose ([Compte_ r] montant)
   (r (dépose_ montant))
)
(defpat retire ([Compte_ r] montant)
   (r (retire_ montant))
)
(defpat décris ([Compte_ r])
   (r (décris_))
)
(setq lea (Compte "Léa" 100))
(setq tom (Compte "Tom" 20))
(dépose lea 50)
(retire tom 30)
(retire lea 30)
(décris lea)
(décris tom)
(defun divise (a b)
   (if (= b 0)
      (throw "division par zéro")
   )
   (return (/ a b))
)
(maybe
   (println (_texte (divise 10 4)))
   (println (_texte (divise 1 0)))
   (λ (e) 
      (setq e (_message_erreur e))
      (println "Problème :" (_texte e))
   )
)
