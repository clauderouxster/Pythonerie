(defun courbe (x)
   (return (- (/ (* x x) 4) 2))
)
(setq début -5)
(setq fin 5)
(setq titre "y = x² / 4 - 2")
(setq largeur_canevas (largeur))
(setq hauteur_canevas (hauteur))
(setq marge 50)
(setq nombre_de_points 400)
(setq xs (list))
(setq ys (list))
(setq pas (/ (- fin début) nombre_de_points))
(loop i 
   (intervalle (+ nombre_de_points 1))
   (setq x (p+ début (* i pas)))
   (push xs x)
   (push ys (courbe x))
)
(setq y_min (minimum ys))
(setq y_max (maximum ys))
(if (> y_min 0)
   (setq y_min 0)
)
(if (< y_max 0)
   (setq y_max 0)
)
(check (= y_min y_max)
   (-= y_min 1)
   (+= y_max 1)
)
(defun écran_x (x)
   (return (p+ marge (/ (* (- x début) (- largeur_canevas (* 2 marge))) (- fin début))))
)
(defun écran_y (y)
   (return
      (- (- hauteur_canevas marge) (/ (* (- y y_min) (- hauteur_canevas (* 2 marge))) (- y_max y_min)))
   )
)
(fond "blanc")
(couleur "gris foncé")
(épaisseur 2)
(setq axe_x (écran_y 0))
(if (andvalue (<= début 0) (>= fin 0))
   (setq axe_y (écran_x 0))
   (setq axe_y (écran_x début))
)
(ligne marge axe_x (- largeur_canevas marge) axe_x)
(ligne axe_y marge axe_y (- hauteur_canevas marge))
(taille_texte 16)
(texte (+ (- largeur_canevas marge) 8) (- axe_x 8) "x")
(texte (- axe_y 5) (- marge 24) "y")
(defun joli_pas (étendue)
   (setq brut (/ étendue 10))
   (setq p 1)
   (while (<= (* p 10) brut) (setq p (* p 10)))
   (while (> p brut) (setq p (/ p 10)))
   (if (>= (/ brut p) 5)
      (return (* 5 p))
      (if (>= (/ brut p) 2)
         (return (* 2 p))
      )
   )
   (return p)
)
(defun première_graduation (début_axe pas_axe)
   (setq g (* (floor (/ début_axe pas_axe)) pas_axe))
   (if (< g début_axe)
      (setq g (p+ g pas_axe))
   )
   (return g)
)
(épaisseur 1)
(taille_texte 12)
(setq pas_x (joli_pas (- fin début)))
(setq x (première_graduation début pas_x))
(while (<= x (p+ fin (/ pas_x 1000)))
   (setq px (écran_x x))
   (ligne px (- axe_x 4) px (+ axe_x 4))
   (texte (- px 10) (+ axe_x 8) (chaîne (arrondi x 2)))
   (setq x (p+ x pas_x))
)
(setq pas_y (joli_pas (- y_max y_min)))
(setq y (première_graduation y_min pas_y))
(while (<= y (p+ y_max (/ pas_y 1000)))
   (setq py (écran_y y))
   (ligne (- axe_y 4) py (+ axe_y 4) py)
   (if (!= (arrondi y 6) 0)
      (texte (- axe_y 42) (- py 6) (chaîne (arrondi y 2)))
   )
   (setq y (p+ y pas_y))
)
(couleur "bleu")
(épaisseur 3)
(loop i 
   (intervalle nombre_de_points)
   (
      ligne
      (écran_x (at xs i))
      (écran_y (at ys i))
      (écran_x (at xs (+ i 1)))
      (écran_y (at ys (+ i 1)))
   )
)
(couleur "bleu")
(taille_texte 20)
(texte (+ marge 10) 12 titre)
(println "Courbe dessinée de x =" (_texte début) "à x =" (_texte fin))
(println "y va de" (_texte (arrondi (minimum ys) 2)) "à" (_texte (arrondi (maximum ys) 2)))
