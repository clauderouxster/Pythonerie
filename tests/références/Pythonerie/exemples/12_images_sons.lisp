(setq étoile (charge_image "médias/images/étoile.svg"))
(setq ding (charge_son "médias/sounds/ding.wav"))
(setq pop (charge_son "médias/sounds/pop.wav"))
(fond "bleu marine")
(couleur "blanc")
(taille_texte 22)
(texte 20 20 "Clique dans le ciel pour allumer des étoiles !")
(place_image étoile 320 220 160 160)
(setq nombre 0)
(defun clic (x y)
   (place_image étoile (- x 30) (- y 30) 60 60)
   (+= nombre 1)
   (if (= (_% nombre 5) 0)
      (block (joue_son ding) (println (_texte nombre) "étoiles !"))
      (joue_son pop)
   )
)
(quand_clic clic)
