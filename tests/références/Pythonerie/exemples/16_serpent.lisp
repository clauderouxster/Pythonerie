(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(setq CASE 40)
(setq COLONNES (entier (/ (largeur) CASE)))
(setq LIGNES (entier (/ (hauteur) CASE)))
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(setq croque (charge_son "médias/sounds/pop.wav"))
(setq perdu (charge_son "médias/sounds/ding.wav"))
(setq serpent (list (list 3 7) (list 4 7) (list 5 7)))
(setq direction (list 1 0))
(setq prochaine (list 1 0))
(setq pomme (list 12 7))
(setq score 0)
(setq lenteur 8)
(setq compteur 0)
(setq état "attente")
(setq JEU "Serpent")
(setq records_rangés true)
(defun lit_records ()
   (setq t (prend_base "don0"))
   (if (= t "")
      (return (dictionary))
   )
   (maybe (setq d (json_parse t)) (block (setg records_rangés false) (return (dictionary))))
   (if (= (typede d) "dictionnaire")
      (return d)
   )
   (setg records_rangés false)
   (return (dictionary))
)
(defun record_du_jeu ()
   (setq d (lit_records))
   (if (in_it d JEU)
      (return (at d JEU))
   )
   (return 0)
)
(defun range_record (valeur)
   (setq d (lit_records))
   (check records_rangés
      (set@ d JEU valeur)
      (range_base "don0" (json d))
   )
)
(setq record (record_du_jeu))
(setq nouveau_record false)
(defun fin_de_partie ()
   (check (> score record)
      (setg record score)
      (setg nouveau_record true)
      (range_record score)
   )
)
(defun sur_le_serpent (x y)
   (loop morceau serpent
      (if (andvalue (= (at morceau 0) x) (= (at morceau 1) y))
         (return true)
      )
   )
   (return false)
)
(defun place_pomme ()
   (setq x (aléatoire 0 (- COLONNES 1)))
   (setq y (aléatoire 0 (- LIGNES 1)))
   (while (sur_le_serpent x y)
      (setq x (aléatoire 0 (- COLONNES 1)))
      (setq y (aléatoire 0 (- LIGNES 1)))
   )
   (setg pomme (list x y))
)
(defun nouvelle_grille ()
   (setg COLONNES (entier (/ (largeur) CASE)))
   (setg LIGNES (entier (/ (hauteur) CASE)))
   (setq dx 0)
   (setq dy 0)
   (loop morceau serpent
      (setq dx (maximum dx (+ (- (at morceau 0) COLONNES) 1)))
      (setq dy (maximum dy (+ (- (at morceau 1) LIGNES) 1)))
   )
   (setq nouveau (list))
   (loop morceau serpent
      (push nouveau (list (- (at morceau 0) dx) (- (at morceau 1) dy)))
   )
   (setg serpent nouveau)
   (loop morceau serpent
      (check (orvalue (< (at morceau 0) 0) (< (at morceau 1) 0))
         (setg serpent (list (list 3 7) (list 4 7) (list 5 7)))
         (setg direction (list 1 0))
         (setg prochaine (list 1 0))
      )
   )
   (if (orvalue
         (orvalue (>= (at pomme 0) COLONNES) (>= (at pomme 1) LIGNES))
         (sur_le_serpent (at pomme 0) (at pomme 1))
      )
      (place_pomme)
   )
   (if (= état "jeu")
      (setg état "pause")
   )
)
(defun recommence ()
   (setg serpent (list (list 3 7) (list 4 7) (list 5 7)))
   (setg direction (list 1 0))
   (setg prochaine (list 1 0))
   (setg score 0)
   (setg lenteur 8)
   (setg nouveau_record false)
   (setg état "jeu")
   (place_pomme)
)
(defun tourne (dx dy)
   (if (= état "pause")
      (setg état "jeu")
      (if (!= état "jeu")
         (recommence)
      )
   )
   (if (orvalue (!= dx (sign (at direction 0))) (!= dy (sign (at direction 1))))
      (setg prochaine (list dx dy))
   )
)
(defun clavier (t)
   (if (orvalue (= t "gauche") (= t "q"))
      (tourne -1 0)
      (if (orvalue (= t "droite") (= t "d"))
         (tourne 1 0)
         (if (orvalue (= t "haut") (= t "z"))
            (tourne 0 -1)
            (if (orvalue (= t "bas") (= t "s"))
               (tourne 0 1)
               (if (andvalue (= t "espace") (= état "pause"))
                  (setg état "jeu")
                  (if (andvalue (= t "espace") (!= état "jeu"))
                     (recommence)
                  )
               )
            )
         )
      )
   )
)
(defun clic (x y)
   (setq tête (at serpent -1))
   (setq écart_x (- x (p+ (* (at tête 0) CASE) (/ CASE 2))))
   (setq écart_y (- y (p+ (* (at tête 1) CASE) (/ CASE 2))))
   (if (> (absolu écart_x) (absolu écart_y))
      (if (> écart_x 0)
         (tourne 1 0)
         (tourne -1 0)
      )
      (if (> écart_y 0)
         (tourne 0 1)
         (tourne 0 -1)
      )
   )
)
(defun avance ()
   (setg direction prochaine)
   (setq tête (at serpent -1))
   (setq x (p+ (at tête 0) (at direction 0)))
   (setq y (p+ (at tête 1) (at direction 1)))
   (check (orvalue
         (orvalue (orvalue (orvalue (< x 0) (>= x COLONNES)) (< y 0)) (>= y LIGNES))
         (sur_le_serpent x y)
      )
      (setg état "perdu")
      (fin_de_partie)
      (joue_son perdu)
      (return ())
   )
   (push serpent (list x y))
   (if (andvalue (= x (at pomme 0)) (= y (at pomme 1)))
      (block (+= score 1) (setg lenteur (maximum (- lenteur 0.25) 3)) (joue_son croque) (place_pomme))
      (setg serpent (extract serpent 1))
   )
)
(defun centre (y t)
   (texte (- (/ (largeur) 2) (/ (largeur_texte t) 2)) y t)
)
(setq début "Une flèche ou Espace pour commencer")
(setq rejouer "Une flèche ou Espace : rejouer")
(setq suite "Une flèche ou Espace pour continuer")
(check (!= (at écran 0) "ordinateur")
   (setq début "Touche l'écran pour commencer")
   (setq rejouer "Touche l'écran pour rejouer")
   (setq suite "Touche l'écran pour continuer")
)
(defun dessine ()
   (fond (rgb 30 95 30))
   (couleur (rgb 40 110 40))
   (loop ligne 
      (intervalle LIGNES)
      (loop colonne 
         (intervalle COLONNES)
         (if (= (_% (p+ ligne colonne) 2) 0)
            (carré_plein (* colonne CASE) (* ligne CASE) CASE)
         )
      )
   )
   (couleur "rouge")
   (
      disque
      (p+ (* (at pomme 0) CASE) (/ CASE 2))
      (p+ (* (at pomme 1) CASE) (/ CASE 2))
      (- (/ CASE 2) 4)
   )
   (couleur "vert clair")
   (ellipse_pleine (p+ (* (at pomme 0) CASE) (/ CASE 2) 5) (+ (* (at pomme 1) CASE) 6) 7 4)
   (loop morceau serpent
      (couleur "jaune")
      (carré_plein (+ (* (at morceau 0) CASE) 2) (+ (* (at morceau 1) CASE) 2) (- CASE 4))
   )
   (setq tête (at serpent -1))
   (setq cx (p+ (* (at tête 0) CASE) (/ CASE 2)))
   (setq cy (p+ (* (at tête 1) CASE) (/ CASE 2)))
   (couleur "orange")
   (carré_plein (+ (* (at tête 0) CASE) 2) (+ (* (at tête 1) CASE) 2) (- CASE 4))
   (couleur "noir")
   (
      disque
      (- (p+ cx (* (at direction 0) 8)) (* (at direction 1) 8))
      (- (p+ cy (* (at direction 1) 8)) (* (at direction 0) 8))
      4
   )
   (
      disque
      (p+ cx (* (at direction 0) 8) (* (at direction 1) 8))
      (p+ cy (* (at direction 1) 8) (* (at direction 0) 8))
      4
   )
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 20 (+ "Pommes : " (_texte score)))
   (texte (- (largeur) 170) 20 (+ "Meilleur : " (_texte record)))
   (taille_texte 26)
   (if (= état "attente")
      (centre (- (hauteur) 200) début)
      (if (= état "pause")
         (centre (- (hauteur) 200) suite)
         (check (= état "perdu")
            (setq mot "pommes")
            (if (<= score 1)
               (setq mot "pomme")
            )
            (centre (- (/ (hauteur) 2) 40) (+ "Perdu ! Tu as mangé " (_texte score) " " (_texte mot) "."))
            (centre (+ (/ (hauteur) 2) 10) rejouer)
            (check nouveau_record
               (couleur "jaune")
               (centre (+ (/ (hauteur) 2) 60) "Nouveau record !")
            )
         )
      )
   )
)
(defun image ()
   (check (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (setg ancienne_largeur (largeur))
      (setg ancienne_hauteur (hauteur))
      (nouvelle_grille)
   )
   (check (= état "jeu")
      (+= compteur 1)
      (check (>= compteur lenteur)
         (setg compteur 0)
         (avance)
      )
   )
   (dessine)
)
(cache_tortue)
(quand_touche clavier)
(quand_clic clic)
(animer image 20)
