(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(setq COLONNES 10)
(setq RANGÉES 5)
(setq PAS_X (minimum 56 (_/ (* (largeur) 7) 100)))
(setq PAS_Y 44)
(setq LARGEUR_ENV 36)
(setq HAUTEUR_ENV 24)
(setq COULEURS (list "magenta" "violet clair" "bleu clair" "turquoise" "vert clair"))
(setq son_tir (charge_son "médias/sounds/tir.wav"))
(setq son_explosion (charge_son "médias/sounds/explosion.wav"))
(setq son_boum (charge_son "médias/sounds/boum.wav"))
(setq pas_de_marche
   (mapcar (λ (i) (charge_son (+ "médias/sounds/pas_" (_texte i) ".wav"))) (intervalle 1 5))
)
(setq vaisseau_x (_/ (largeur) 2))
(setq VAISSEAU_Y (- (hauteur) 50))
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(setq vivants (list))
(setq flotte_x 100)
(setq flotte_y 70)
(setq sens 1)
(setq attente 0)
(setq pas_joué 0)
(setq tir_actif false)
(setq tir_x 0)
(setq tir_y 0)
(setq bombes (list))
(setq étoiles
   (mapcar (λ (i) (list (aléatoire 0 (largeur)) (aléatoire 0 (hauteur)))) (intervalle 60))
)
(setq explosions (list))
(setq vies 3)
(setq score 0)
(setq vague 1)
(setq clignote 0)
(setq état "attente")
(setq JEU "Envahisseurs")
(setq records_rangés true)
(defun lit_records ()
   (setq t (prend_base "don0"))
   (if (= t "")
      (return (dictionary))
   )
   (maybe (setq d (json_parse t)) (block (setg records_rangés false) (return (dictionary))))
   (if (= (typede d) "dictionnaire")
      (return d)
   )
   (setg records_rangés false)
   (return (dictionary))
)
(defun record_du_jeu ()
   (setq d (lit_records))
   (if (in_it d JEU)
      (return (at d JEU))
   )
   (return 0)
)
(defun range_record (valeur)
   (setq d (lit_records))
   (check records_rangés
      (set@ d JEU valeur)
      (range_base "don0" (json d))
   )
)
(setq record (record_du_jeu))
(setq nouveau_record false)
(defun fin_de_partie ()
   (check (> score record)
      (setg record score)
      (setg nouveau_record true)
      (range_record score)
   )
)
(defun env_x (i)
   (return (p+ flotte_x (* (_% i COLONNES) PAS_X)))
)
(defun env_y (i)
   (return (p+ flotte_y (* (_/ i COLONNES) PAS_Y)))
)
(defun restants ()
   (return (longueur (filtercar (λ (v) v) vivants)))
)
(defun nouvelle_vague ()
   (setg vivants (mapcar (λ (i) true) (intervalle (* COLONNES RANGÉES))))
   (setg flotte_x (_/ (largeur) 8))
   (setg flotte_y (p+ 70 (* (minimum (- vague 1) 4) 15)))
   (setg sens 1)
   (setg bombes (list))
   (setg tir_actif false)
)
(defun recommence ()
   (setg vies 3)
   (setg score 0)
   (setg vague 1)
   (nouvelle_vague)
   (setg nouveau_record false)
   (setg état "jeu")
)
(defun tire ()
   (if (!= état "jeu")
      (recommence)
      (check (¬ tir_actif)
         (setg tir_actif true)
         (setg tir_x vaisseau_x)
         (setg tir_y (- VAISSEAU_Y 20))
         (joue_son son_tir)
      )
   )
)
(defun place_vaisseau (x)
   (setg vaisseau_x (minimum (maximum x 30) (- (largeur) 30)))
)
(defun souris (x y)
   (place_vaisseau x)
)
(setq TACTILE (!= (at (appareil) 0) "ordinateur"))
(setq TIRER "Clic ou Espace")
(if TACTILE
   (setq TIRER "Touche 🔥 Feu")
)
(defun bouton_feu (clef texte)
   (tire)
)
(defun clic (x y)
   (place_vaisseau x)
   (if (andvalue TACTILE (= état "jeu"))
      (return ())
   )
   (tire)
)
(defun clavier (t)
   (if (orvalue (= t "espace") (= t "haut"))
      (tire)
   )
)
(defun pilote_clavier ()
   (if (touche_enfoncée "gauche")
      (place_vaisseau (- vaisseau_x 6))
   )
   (if (touche_enfoncée "droite")
      (place_vaisseau (+ vaisseau_x 6))
   )
)
(defun avance_flotte ()
   (-= attente 1)
   (if (> attente 0)
      (return ())
   )
   (setg attente (maximum 2 (- (+ (_/ (restants) 2) 4) vague)))
   (joue_son (at pas_de_marche (_% pas_joué 4)))
   (+= pas_joué 1)
   (setq gauche (largeur))
   (setq droite 0)
   (loop i 
      (intervalle (longueur vivants))
      (check (at vivants i)
         (setq gauche (minimum gauche (env_x i)))
         (setq droite (maximum droite (p+ (env_x i) LARGEUR_ENV)))
      )
   )
   (setq au_bord_droit (andvalue (= sens 1) (> (+ droite 12) (largeur))))
   (setq au_bord_gauche (andvalue (= sens -1) (< (- gauche 12) 0)))
   (if (orvalue au_bord_droit au_bord_gauche)
      (block (+= flotte_y 20) (setg sens (sign sens)))
      (setg flotte_x (p+ flotte_x (* 12 sens)))
   )
)
(defun lâche_bombes ()
   (check (andvalue (<= (aléatoire 1 100) (p+ 2 vague)) (< (longueur bombes) (p+ 3 vague)))
      (setq i (aléatoire 0 (- (longueur vivants) 1)))
      (if (at vivants i)
         (push bombes (list (p+ (env_x i) (/ LARGEUR_ENV 2)) (p+ (env_y i) HAUTEUR_ENV)))
      )
   )
)
(defun avance_tir ()
   (if (¬ tir_actif)
      (return ())
   )
   (-= tir_y 12)
   (check (< tir_y 0)
      (setg tir_actif false)
      (return ())
   )
   (loop i 
      (intervalle (longueur vivants))
      (check (at vivants i)
         (setq x (env_x i))
         (setq y (env_y i))
         (check (andvalue
               (andvalue (andvalue (> tir_x x) (< tir_x (p+ x LARGEUR_ENV))) (> tir_y y))
               (< tir_y (p+ y HAUTEUR_ENV))
            )
            (set@ vivants i false)
            (setg tir_actif false)
            (setg score (p+ score (* 10 (- RANGÉES (_/ i COLONNES)))))
            (push explosions (list (p+ x (/ LARGEUR_ENV 2)) (p+ y (/ HAUTEUR_ENV 2)) 8))
            (joue_son son_explosion)
            (break)
         )
      )
   )
)
(defun avance_bombes ()
   (setg bombes
      (mapcar
         (λ (b) 
            (list (at b 0) (p+ (+ (at b 1) 5) vague))
         )
         (filtercar (λ (b) (< (at b 1) (hauteur))) bombes)
      )
   )
   (if (> clignote 0)
      (return ())
   )
   (setq atteint false)
   (loop b bombes
      (check (andvalue (< (absolu (- (at b 0) vaisseau_x)) 24) (< (absolu (- (at b 1) VAISSEAU_Y)) 12))
         (setq atteint true)
         (break)
      )
   )
   (if atteint
      (touché)
   )
)
(defun touché ()
   (-= vies 1)
   (setg bombes (list))
   (setg clignote 60)
   (joue_son son_boum)
   (check (= vies 0)
      (setg état "perdu")
      (fin_de_partie)
   )
)
(defun vérifie_vague ()
   (check (= (restants) 0)
      (+= vague 1)
      (+= score 100)
      (nouvelle_vague)
      (return ())
   )
   (loop i 
      (intervalle (longueur vivants))
      (check (andvalue (at vivants i) (> (p+ (env_y i) HAUTEUR_ENV) (- VAISSEAU_Y 20)))
         (setg vies 0)
         (setg état "perdu")
         (fin_de_partie)
         (joue_son son_boum)
         (break)
      )
   )
)
(defun recale ()
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
   (setg PAS_X (minimum 56 (_/ (* (largeur) 7) 100)))
   (setg VAISSEAU_Y (- (hauteur) 50))
   (place_vaisseau vaisseau_x)
   (setg étoiles
      (mapcar (λ (i) (list (aléatoire 0 (largeur)) (aléatoire 0 (hauteur)))) (intervalle 60))
   )
   (setg flotte_x (minimum flotte_x (- (- (- (largeur) 12) (* (- COLONNES 1) PAS_X)) LARGEUR_ENV)))
   (setg flotte_y (minimum flotte_y (- (- VAISSEAU_Y 100) (* RANGÉES PAS_Y))))
   (check TACTILE
      (taille_texte 26)
      (bouton "feu" 10 (- (hauteur) 180) "🔥 Feu" bouton_feu)
   )
)
(defun centre (y t)
   (texte (- (/ (largeur) 2) (/ (largeur_texte t) 2)) y t)
)
(defun dessine_envahisseur (x y c)
   (couleur c)
   (rectangle_plein (+ x 6) y (- LARGEUR_ENV 12) 6)
   (rectangle_plein x (+ y 6) LARGEUR_ENV 10)
   (couleur "noir")
   (carré_plein (+ x 8) (+ y 8) 5)
   (carré_plein (- (p+ x LARGEUR_ENV) 13) (+ y 8) 5)
   (couleur c)
   (ife (= (_% pas_joué 2) 0)
      (block
         (rectangle_plein (+ x 2) (+ y 16) 5 8)
         (rectangle_plein (- (p+ x LARGEUR_ENV) 7) (+ y 16) 5 8)
      )
      (rectangle_plein (+ x 8) (+ y 16) 5 8)
      (rectangle_plein (- (p+ x LARGEUR_ENV) 13) (+ y 16) 5 8)
   )
)
(defun dessine_vaisseau ()
   (if (andvalue (> clignote 0) (= (_% (_/ clignote 5) 2) 0))
      (return ())
   )
   (couleur "vert clair")
   (rectangle_plein (- vaisseau_x 24) VAISSEAU_Y 48 12)
   (rectangle_plein (- vaisseau_x 4) (- VAISSEAU_Y 10) 8 10)
)
(defun dessine ()
   (fond "noir")
   (couleur "gris")
   (loop é étoiles
      (point (at é 0) (at é 1))
   )
   (loop i 
      (intervalle (longueur vivants))
      (if (at vivants i)
         (dessine_envahisseur (env_x i) (env_y i) (at COULEURS (_/ i COLONNES)))
      )
   )
   (couleur "orange")
   (loop e explosions
      (cercle (at e 0) (at e 1) (- 22 (* (at e 2) 2)))
   )
   (dessine_vaisseau)
   (check tir_actif
      (couleur "blanc")
      (rectangle_plein (- tir_x 2) tir_y 4 14)
   )
   (couleur "rouge clair")
   (loop b bombes
      (rectangle_plein (- (at b 0) 2) (at b 1) 4 10)
   )
   (couleur "vert clair")
   (ligne 0 (- (hauteur) 25) (largeur) (- (hauteur) 25))
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 20 (+ "Score : " (_texte score)))
   (texte (- (/ (largeur) 2) 60) 20 (+ "Vague " (_texte vague)))
   (texte (- (largeur) 100) 20 (+ "Vies : " (_texte vies)))
   (taille_texte 26)
   (setq m (_/ (hauteur) 2))
   (if (= état "attente")
      (block
         (centre (+ m 30) (+ (_texte TIRER) " : défendre la Terre !"))
         (if (> record 0)
            (centre (+ m 80) (+ "Meilleur score : " (_texte record)))
         )
      )
      (check (= état "perdu")
         (couleur "rouge clair")
         (centre m "La Terre est envahie !")
         (couleur "blanc")
         (centre (+ m 45) (+ "Score : " (_texte score) ", vague " (_texte vague)))
         (centre (+ m 90) (+ (_texte TIRER) " : rejouer"))
         (if nouveau_record
            (block (couleur "jaune") (centre (+ m 140) "Nouveau record !"))
            (centre (+ m 140) (+ "Meilleur score : " (_texte record)))
         )
      )
   )
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (check (= état "jeu")
      (pilote_clavier)
      (avance_flotte)
      (lâche_bombes)
      (avance_tir)
      (avance_bombes)
      (vérifie_vague)
      (if (> clignote 0)
         (-= clignote 1)
      )
   )
   (setg explosions
      (mapcar
         (λ (e) 
            (list (at e 0) (at e 1) (- (at e 2) 1))
         )
         (filtercar (λ (e) (> (at e 2) 1)) explosions)
      )
   )
   (dessine)
)
(cache_tortue)
(nouvelle_vague)
(quand_souris souris)
(quand_glisse souris)
(check TACTILE
   (taille_texte 26)
   (bouton "feu" 10 (- (hauteur) 180) "🔥 Feu" bouton_feu)
)
(quand_clic clic)
(quand_touche clavier)
(animer image 20)
