(canevas 1000 720)
(cache_tortue)
(setq PANNEAU 260)
(setq FORMES (list "disque" "carré" "triangle" "étoile"))
(setq COULEURS
   (list
      (list "Chaudes" (list "rouge" "rouge clair" "orange" "jaune" "rose"))
      (list "Froides" (list "bleu" "bleu clair" "bleu marine" "vert" "turquoise" "violet"))
      (list "Neutres" (list "noir" "gris" "gris clair" "marron" "blanc"))
   )
)
(setq forme_actuelle "disque")
(setq couleur_actuelle "rouge")
(setq taille_actuelle 30)
(setq mode "poser")
(setq contour false)
(setq grille false)
(setq titre "")
(setq légende "")
(setq dessin (list))
(defun trace (f x y c t plein)
   (couleur c)
   (if (= f "disque")
      (if plein
         (disque x y t)
         (cercle x y t)
      )
      (if (= f "carré")
         (if plein
            (carré_plein (- x t) (- y t) (* 2 t))
            (carré (- x t) (- y t) (* 2 t))
         )
         (ife (= f "triangle")
            (if plein
               (triangle_plein x (- y t) (- x t) (p+ y t) (p+ x t) (p+ y t))
               (triangle x (- y t) (- x t) (p+ y t) (p+ x t) (p+ y t))
            )
            (setq points (list))
            (loop i 
               (intervalle 10)
               (setq r t)
               (if (= (_% i 2) 1)
                  (setq r (/ t 2))
               )
               (setq angle (- (* i 36) 90))
               (push points (list (p+ x (* r (cosinus angle))) (p+ y (* r (sinus angle)))))
            )
            (if plein
               (polygone_plein points)
               (polygone points)
            )
         )
      )
   )
)
(defun dessine ()
   (fond "blanc")
   (couleur "gris clair")
   (rectangle_plein 0 0 PANNEAU (hauteur))
   (couleur "noir")
   (taille_texte 15)
   (texte 12 10 "Titre du dessin")
   (texte 12 66 "Forme")
   (texte 12 168 (+ "Taille : " (_texte taille_actuelle)))
   (texte 12 218 (+ "Couleur : " (_texte couleur_actuelle)))
   (couleur couleur_actuelle)
   (disque (- PANNEAU 24) 226 9)
   (couleur "noir")
   (texte 12 440 "Un clic dans le dessin :")
   (texte 12 616 "Légende")
   (check grille
      (couleur "gris clair")
      (épaisseur 1)
      (loop gx 
         (intervalle (+ PANNEAU 20) (largeur) 40)
         (ligne gx 0 gx (hauteur))
      )
      (loop gy 
         (intervalle 0 (hauteur) 40)
         (ligne PANNEAU gy (largeur) gy)
      )
   )
   (loop f dessin
      (trace (at f 2) (at f 0) (at f 1) (at f 3) (at f 4) true)
      (check contour
         (épaisseur 2)
         (trace (at f 2) (at f 0) (at f 1) "noir" (at f 4) false)
      )
   )
   (couleur "bleu marine")
   (taille_texte 28)
   (texte (+ PANNEAU 20) 14 titre)
   (taille_texte 18)
   (texte (+ PANNEAU 20) (- (hauteur) 80) légende)
   (taille_texte 15)
   (couleur "gris")
   (texte (- (largeur) 130) (- (hauteur) 24) (+ (_texte (longueur dessin)) " formes"))
)
(defun titre_changé (clef valeur)
   (setg titre valeur)
   (dessine)
)
(defun forme_choisie (clef valeur)
   (choisit_forme valeur)
)
(defun choisit_forme (f)
   (setg forme_actuelle f)
   (change_objet "forme" f)
   (loop g FORMES
      (if (= g f)
         (change_objet (+ "icône_" (_texte g)) (at icônes g 1))
         (change_objet (+ "icône_" (_texte g)) (at icônes g 0))
      )
   )
)
(defun icône_choisie (clef image)
   (choisit_forme (extract clef 6))
)
(defun taille_changée (clef valeur)
   (setg taille_actuelle valeur)
   (dessine)
)
(defun couleur_choisie (clef chemin)
   (check (= (longueur chemin) 2)
      (setg couleur_actuelle (at chemin 1))
      (dessine)
   )
)
(defun option (clef cochée)
   (if (= clef "contour")
      (setg contour cochée)
      (setg grille cochée)
   )
   (dessine)
)
(defun mode_choisi (groupe clef)
   (setg mode clef)
)
(defun pipette (x y)
   (setq p (couleur_pixel x y))
   (setg couleur_actuelle (rgb (at p 0) (at p 1) (at p 2)))
   (setg mode "poser")
   (change_objet "poser" true)
)
(defun légende_changée (clef valeur)
   (setg légende valeur)
   (dessine)
)
(defun toutes_les_couleurs ()
   (setq liste (list))
   (loop groupe COULEURS
      (loop c 
         (at groupe 1)
         (push liste c)
      )
   )
   (return liste)
)
(defun action (clef texte)
   (if (= clef "hasard")
      (block
         (setq plus_grande (valeur_objet "taille"))
         (loop i 
            (intervalle 10)
            (setq x (aléatoire (+ PANNEAU 40) (- (largeur) 40)))
            (setq y (aléatoire 60 (- (hauteur) 100)))
            (push
               dessin
               (list x y (choisis FORMES) (choisis (toutes_les_couleurs)) (aléatoire 10 plus_grande))
            )
         )
      )
      (if (= clef "annuler")
         (if (> (longueur dessin) 0)
            (setg dessin (extract dessin 0 (- (longueur dessin) 1)))
         )
         (if (= clef "vider")
            (setg dessin (list))
            (if (= clef "recommencer")
               (recommence)
            )
         )
      )
   )
   (dessine)
)
(defun recommence ()
   (setg dessin (list))
   (setg titre "")
   (setg légende "")
   (setg forme_actuelle "disque")
   (setg couleur_actuelle "rouge")
   (setg taille_actuelle 30)
   (setg contour false)
   (setg grille false)
   (setg mode "poser")
   (change_objet "titre" "")
   (choisit_forme "disque")
   (change_objet "taille" 30)
   (change_objet "couleurs" (list "Chaudes" "rouge"))
   (change_objet "contour" false)
   (change_objet "grille" false)
   (change_objet "poser" true)
   (change_objet "légende" "")
)
(defun clic (x y)
   (if (< x PANNEAU)
      (return ())
   )
   (if (= mode "poser")
      (push dessin (list x y forme_actuelle couleur_actuelle taille_actuelle))
      (ife (= mode "pipette")
         (pipette x y)
         (setq plus_proche -1)
         (setq distance 100000)
         (loop i 
            (intervalle (longueur dessin))
            (setq f (at dessin i))
            (setq d (p+ (* (- (at f 0) x) (- (at f 0) x)) (* (- (at f 1) y) (- (at f 1) y))))
            (check (andvalue (< d distance) (< d (* (at f 4) (at f 4))))
               (setq distance d)
               (setq plus_proche i)
            )
         )
         (if (>= plus_proche 0)
            (setg dessin
               (mapcar
                  (λ (i) 
                     (at dessin i)
                  )
                  (filtercar (λ (i) (!= i plus_proche)) (intervalle (longueur dessin)))
               )
            )
         )
      )
   )
   (dessine)
)
(defun icône (f couleur_fond couleur_forme)
   (couleur couleur_fond)
   (rectangle_plein 0 0 36 36)
   (épaisseur 1)
   (couleur "gris")
   (rectangle 0 0 36 36)
   (trace f 18 18 couleur_forme 12 true)
   (return (capture_image 0 0 36 36))
)
(setq icônes (dictionary))
(loop f FORMES
   (set@ icônes f (list (icône f "gris clair" "gris foncé") (icône f "blanc" "bleu")))
)
(couleur "noir")
(taille_texte 12)
(largeur_saisie (- PANNEAU 24))
(saisie "titre" 12 28 titre_changé)
(liste_déroulante "forme" 12 84 FORMES forme_choisie)
(loop i 
   (intervalle (longueur FORMES))
   (setq f (at FORMES i))
   (
      bouton_image
      (+ "icône_" (_texte f))
      (p+ 12 (* i 46))
      116
      (at icônes f 0)
      (at icônes f 1)
      icône_choisie
   )
)
(glissière "taille" 12 188 10 80 30 taille_changée)
(liste_hiérarchique "couleurs" 12 238 6 COULEURS couleur_choisie)
(case_à_cocher "contour" 12 382 "Contour noir" option)
(case_à_cocher "grille" 12 408 "Afficher la grille" option)
(bouton_radio "poser" "clic" 12 460 "pose une forme" mode_choisi)
(bouton_radio "effacer" "clic" 12 484 "efface une forme" mode_choisi)
(bouton_radio "pipette" "clic" 12 508 "prend une couleur (pipette)" mode_choisi)
(bouton "hasard" 12 540 "Au hasard" action)
(bouton "annuler" 130 540 "Annuler" action)
(bouton "vider" 12 578 "Tout effacer" action)
(bouton "recommencer" 130 578 "Recommencer" action)
(zone_édition "légende" 12 634 2 légende_changée)
(recommence)
(dessine)
(quand_clic clic)
