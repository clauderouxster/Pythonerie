(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(setq COLONNES 10)
(setq RANGÉES 5)
(setq HAUTEUR_BRIQUE 24)
(setq ÉCART 4)
(setq LARGEUR_BRIQUE (- (_/ (- (largeur) 10) COLONNES) ÉCART))
(setq HAUT_DU_MUR 60)
(setq COULEURS
   (list
      (list "#e53935" "#ff8a80" "#8e1c1a")
      (list "#fb8c00" "#ffcc80" "#9a5200")
      (list "#fdd835" "#fff59d" "#9e8500")
      (list "#43a047" "#a5d6a7" "#1b5e20")
      (list "#1e88e5" "#90caf9" "#0d47a1")
   )
)
(setq ding (charge_son "médias/sounds/ding.wav"))
(setq pop (charge_son "médias/sounds/pop.wav"))
(setq raquette_l 110)
(setq raquette_h 14)
(setq raquette_x (_/ (- (largeur) raquette_l) 2))
(setq raquette_y (- (hauteur) 40))
(setq rayon 9)
(setq briques (mapcar (λ (i) true) (irange 0 (* COLONNES RANGÉES) 1)))
(setq restantes (* COLONNES RANGÉES))
(setq balle_x 400.0)
(setq balle_y 540.0)
(setq vx 0.0)
(setq vy 0.0)
(setq vitesse 6.0)
(setq vies 3)
(setq score 0)
(setq état "attente")
(setq traînée (list))
(setq éclats (list))
(setq JEU "Casse-briques (dessins)")
(setq records_rangés true)
(defun lit_records ()
   (setq t (prend_base "don0"))
   (if (= t "")
      (return (dictionary))
   )
   (maybe (setq d (json_parse t)) (block (setg records_rangés false) (return (dictionary))))
   (if (= (typede d) "dictionnaire")
      (return d)
   )
   (setg records_rangés false)
   (return (dictionary))
)
(defun record_du_jeu ()
   (setq d (lit_records))
   (if (in_it d JEU)
      (return (at d JEU))
   )
   (return 0)
)
(defun range_record (valeur)
   (setq d (lit_records))
   (check records_rangés
      (set@ d JEU valeur)
      (range_base "don0" (json d))
   )
)
(setq record (record_du_jeu))
(setq nouveau_record false)
(defun fin_de_partie ()
   (check (> score record)
      (setg record score)
      (setg nouveau_record true)
      (range_record score)
   )
)
(defun brique_x (i)
   (return (p+ 5 (* (_% i COLONNES) (p+ LARGEUR_BRIQUE ÉCART))))
)
(defun brique_y (i)
   (return (p+ HAUT_DU_MUR (* (_/ i COLONNES) (p+ HAUTEUR_BRIQUE ÉCART))))
)
(defun pose_balle ()
   (setg balle_x (p+ raquette_x (/ raquette_l 2)))
   (setg balle_y (- raquette_y rayon 1))
)
(defun recommence ()
   (loop i 
      (irange 0 (longueur briques) 1)
      (set@ briques i true)
   )
   (setg restantes (* COLONNES RANGÉES))
   (setg mur_à_refaire true)
   (setg vies 3)
   (setg score 0)
   (setg vitesse 6.0)
   (setg nouveau_record false)
   (setg état "attente")
   (pose_balle)
)
(defun lance ()
   (if (= état "attente")
      (block (setg vx (choisis (list -3.0 3.0))) (setg vy (sign vitesse)) (setg état "jeu"))
      (if (orvalue (= état "perdu") (= état "gagné"))
         (recommence)
      )
   )
)
(defun place_raquette (centre)
   (setg raquette_x (minimum (maximum (- centre (/ raquette_l 2)) 0.0) (- (largeur) raquette_l)))
   (if (= état "attente")
      (pose_balle)
   )
)
(defun souris (x y)
   (place_raquette x)
)
(defun clic (x y)
   (lance)
)
(defun clavier (t)
   (if (= t "espace")
      (lance)
      (if (= (minuscules t) "d")
         (setg préparé (¬ préparé))
      )
   )
)
(defun pilote_clavier ()
   (setq centre (p+ raquette_x (/ raquette_l 2)))
   (if (touche_enfoncée "gauche")
      (place_raquette (- centre 9))
   )
   (if (touche_enfoncée "droite")
      (place_raquette (+ centre 9))
   )
)
(defun casse_brique ()
   (loop i 
      (irange 0 (longueur briques) 1)
      (check (at briques i)
         (setq x (brique_x i))
         (setq y (brique_y i))
         (setq dedans_x (andvalue (> (p+ balle_x rayon) x) (< (- balle_x rayon) (p+ x LARGEUR_BRIQUE))))
         (setq dedans_y (andvalue (> (p+ balle_y rayon) y) (< (- balle_y rayon) (p+ y HAUTEUR_BRIQUE))))
         (check (andvalue dedans_x dedans_y)
            (set@ briques i false)
            (-= restantes 1)
            (setg mur_à_refaire true)
            (loop k 
               (irange 0 10 1)
               (push
                  éclats
                  (list
                     (p+ x (* (hasard) LARGEUR_BRIQUE))
                     (p+ y (* (hasard) HAUTEUR_BRIQUE))
                     (- (* (hasard) 4) 2)
                     (* (hasard) -3)
                     (aléatoire 20 40)
                     (at COULEURS (_/ i COLONNES) 0)
                  )
               )
            )
            (setg score (p+ score (* 10 (- RANGÉES (_/ i COLONNES)))))
            (if (orvalue (< balle_x x) (> balle_x (p+ x LARGEUR_BRIQUE)))
               (setg vx (sign vx))
               (setg vy (sign vy))
            )
            (setg vitesse (minimum (p+ vitesse 0.08) 11.0))
            (joue_son ding)
            (check (= restantes 0)
               (setg état "gagné")
               (fin_de_partie)
            )
            (break)
         )
      )
   )
)
(defun avance_balle ()
   (setg balle_x (p+ balle_x vx))
   (setg balle_y (p+ balle_y vy))
   (if (< balle_x rayon)
      (block (setg balle_x rayon) (setg vx (absolu vx)))
      (check (> balle_x (- (largeur) rayon))
         (setg balle_x (- (largeur) rayon))
         (setg vx (sign (absolu vx)))
      )
   )
   (check (< balle_y rayon)
      (setg balle_y rayon)
      (setg vy (absolu vy))
   )
   (setq sur_raquette
      (andvalue (> balle_x (- raquette_x rayon)) (< balle_x (p+ raquette_x raquette_l rayon)))
   )
   (setq à_hauteur
      (andvalue (>= (p+ balle_y rayon) raquette_y) (< balle_y (p+ raquette_y raquette_h)))
   )
   (check (andvalue (andvalue (> vy 0) sur_raquette) à_hauteur)
      (setq décalage (/ (- balle_x (p+ raquette_x (/ raquette_l 2))) (/ raquette_l 2)))
      (setq décalage (minimum (maximum décalage -0.85) 0.85))
      (setg vx (* décalage vitesse))
      (setg vy (sign (racine (- (* vitesse vitesse) (* vx vx)))))
      (setg balle_y (- raquette_y rayon))
      (joue_son pop)
   )
   (casse_brique)
   (check (> balle_y (p+ (hauteur) rayon))
      (-= vies 1)
      (ife (= vies 0)
         (block (setg état "perdu") (fin_de_partie))
         (setg état "attente")
         (pose_balle)
      )
   )
)
(defun tire_bulles ()
   (return
      (mapcar
         (λ (i) 
            (list
               (aléatoire 0 (largeur))
               (aléatoire 0 (hauteur))
               (p+ 2 (* (hasard) 12))
               (arrondi (+ 0.03 (* (hasard) 0.12)) 2)
            )
         )
         (irange 0 220 1)
      )
   )
)
(setq bulles (tire_bulles))
(setq décor (nouveau_dessin))
(setq mur (nouveau_dessin))
(setq mur_à_refaire true)
(setq préparé true)
(setq temps_cumulé 0)
(setq images_comptées 0)
(setq temps_moyen 0.0)
(defun prépare_décor ()
   (vide_dessin décor)
   (setq l (largeur))
   (setq h (hauteur))
   (setq bande (/ h 75))
   (loop i 
      (irange 0 75 1)
      (couleur décor (rgb (p+ 8 i) (p+ 12 (* i 0.8)) (p+ 50 (* i 1.6))))
      (rectangle_plein décor 0 (* i bande) l (+ bande 1))
   )
   (loop b bulles
      (couleur décor (+ "rgba(255, 255, 255, " (_texte (at b 3)) ")"))
      (disque décor (at b 0) (at b 1) (at b 2))
   )
   (couleur décor "#37474f")
   (rectangle_plein décor 0 0 l 4)
   (rectangle_plein décor 0 0 4 h)
   (rectangle_plein décor (- l 4) 0 4 h)
   (couleur décor "#90a4ae")
   (loop k 
      (irange 0 (_/ l 40) 1)
      (disque décor (p+ 20 (* k 40)) 2 1.5)
   )
)
(defun ajoute_brique (d i)
   (setq x (brique_x i))
   (setq y (brique_y i))
   (setq c (at COULEURS (_/ i COLONNES)))
   (couleur d (at c 2))
   (rectangle_plein d x y LARGEUR_BRIQUE HAUTEUR_BRIQUE)
   (couleur d (at c 0))
   (rectangle_plein d x y (- LARGEUR_BRIQUE 3) (- HAUTEUR_BRIQUE 3))
   (couleur d (at c 1))
   (rectangle_plein d x y (- LARGEUR_BRIQUE 3) 4)
   (couleur d "rgba(255, 255, 255, 0.35)")
   (ellipse_pleine d (+ x 16) (+ y 9) 9 3)
)
(defun prépare_mur ()
   (vide_dessin mur)
   (loop i 
      (irange 0 (longueur briques) 1)
      (if (at briques i)
         (ajoute_brique mur i)
      )
   )
)
(defun montre_dessins ()
   (if (¬ préparé)
      (block (prépare_décor) (prépare_mur))
      (check mur_à_refaire
         (prépare_mur)
         (setg mur_à_refaire false)
      )
   )
   (montre_dessin décor)
   (montre_dessin mur)
)
(defun texte_centré (y t)
   (texte (/ (- (largeur) (largeur_texte t)) 2) y t)
)
(defun dessine ()
   (setg temps_cumulé (p+ temps_cumulé (elapse (montre_dessins))))
   (+= images_comptées 1)
   (check (= images_comptées 30)
      (setg temps_moyen (/ temps_cumulé 30))
      (setg temps_cumulé 0)
      (setg images_comptées 0)
   )
   (loop k 
      (irange 0 (longueur traînée) 1)
      (couleur (+ "rgba(255, 235, 59, " (_texte (arrondi (+ 0.05 (* k 0.05)) 2)) ")"))
      (disque (at traînée k 0) (at traînée k 1) (* rayon (+ 0.4 (* k 0.07))))
   )
   (couleur "orange")
   (loop e éclats
      (couleur (at e 5))
      (rectangle_plein (at e 0) (at e 1) 4 4)
   )
   (couleur "#b0bec5")
   (rectangle_plein raquette_x raquette_y raquette_l raquette_h)
   (couleur "#eceff1")
   (rectangle_plein (+ raquette_x 4) (+ raquette_y 2) (- raquette_l 8) 4)
   (couleur "#78909c")
   (disque raquette_x (p+ raquette_y (/ raquette_h 2)) (/ raquette_h 2))
   (disque (p+ raquette_x raquette_l) (p+ raquette_y (/ raquette_h 2)) (/ raquette_h 2))
   (couleur "jaune")
   (disque balle_x balle_y rayon)
   (couleur "blanc")
   (disque (- balle_x 3) (- balle_y 3) 2.5)
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 20 (+ "Score : " (_texte score)))
   (texte (- (largeur) 100) 20 (+ "Vies : " (_texte vies)))
   (setq formes (p+ 75 (longueur bulles) 3 (_/ (largeur) 40) (* 4 restantes)))
   (taille_texte 14)
   (couleur "rgba(255, 255, 255, 0.8)")
   (if préparé
      (
         texte
         10
         (- (hauteur) 22)
         (+
            "Dessins préparés : "
            (_texte formes)
            " formes en 2 appels par image, "
            (_texte (arrondi temps_moyen 1))
            " ms (D : comparer)"
         )
      )
      (
         texte
         10
         (- (hauteur) 22)
         (+
            "Refaits à chaque image : "
            (_texte formes)
            " formes une par une, "
            (_texte (arrondi temps_moyen 1))
            " ms (D : revenir)"
         )
      )
   )
   (taille_texte 26)
   (setq milieu (_/ (hauteur) 2))
   (couleur "blanc")
   (if (= état "attente")
      (block
         (texte_centré (+ milieu 80) "Clic ou Espace : lancer la balle")
         (if (> record 0)
            (texte_centré (+ milieu 130) (+ "Meilleur score : " (_texte record)))
         )
      )
      (if (= état "perdu")
         (block
            (texte_centré (+ milieu 40) (+ "Perdu ! Score : " (_texte score)))
            (texte_centré (+ milieu 90) "Clic ou Espace : rejouer")
            (if nouveau_record
               (block (couleur "jaune") (texte_centré (+ milieu 140) "Nouveau record !"))
               (texte_centré (+ milieu 140) (+ "Meilleur score : " (_texte record)))
            )
         )
         (check (= état "gagné")
            (couleur "jaune")
            (texte_centré (+ milieu 40) (+ "Bravo, tout est cassé ! Score : " (_texte score)))
            (texte_centré (+ milieu 90) "Clic ou Espace : rejouer")
            (if nouveau_record
               (block (couleur "jaune") (texte_centré (+ milieu 140) "Nouveau record !"))
               (texte_centré (+ milieu 140) (+ "Meilleur score : " (_texte record)))
            )
         )
      )
   )
)
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(defun recale ()
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
   (setg LARGEUR_BRIQUE (- (_/ (- (largeur) 10) COLONNES) ÉCART))
   (setg raquette_y (- (hauteur) 40))
   (place_raquette (p+ raquette_x (/ raquette_l 2)))
   (check (= état "jeu")
      (setg état "attente")
      (pose_balle)
   )
   (setg bulles (tire_bulles))
   (prépare_décor)
   (setg mur_à_refaire true)
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (pilote_clavier)
   (if (= état "jeu")
      (block
         (avance_balle)
         (push traînée (list balle_x balle_y))
         (if (> (longueur traînée) 10)
            (popvalue traînée 0)
         )
      )
      (setg traînée (list))
   )
   (setg éclats
      (mapcar
         (λ (e) 
            (list
               (p+ (at e 0) (at e 2))
               (p+ (at e 1) (at e 3))
               (at e 2)
               (p+ (at e 3) 0.2)
               (- (at e 4) 1)
               (at e 5)
            )
         )
         (filtercar (λ (e) (> (at e 4) 1)) éclats)
      )
   )
   (dessine)
)
(cache_tortue)
(prépare_décor)
(pose_balle)
(quand_souris souris)
(quand_glisse souris)
(quand_clic clic)
(quand_touche clavier)
(animer image 16)
