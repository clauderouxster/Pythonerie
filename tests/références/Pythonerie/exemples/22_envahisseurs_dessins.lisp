(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(setq COLONNES 10)
(setq RANGÉES 5)
(setq PAS_X (minimum 56 (_/ (* (largeur) 7) 100)))
(setq PAS_Y 44)
(setq LARGEUR_ENV 36)
(setq HAUTEUR_ENV 24)
(setq COULEURS (list "magenta" "violet clair" "bleu clair" "turquoise" "vert clair"))
(setq son_tir (charge_son "médias/sounds/tir.wav"))
(setq son_explosion (charge_son "médias/sounds/explosion.wav"))
(setq son_boum (charge_son "médias/sounds/boum.wav"))
(setq pas_de_marche
   (mapcar (λ (i) (charge_son (+ "médias/sounds/pas_" (_texte i) ".wav"))) (intervalle 1 5))
)
(setq vaisseau_x (_/ (largeur) 2))
(setq VAISSEAU_Y (- (hauteur) 50))
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(setq vivants (list))
(setq flotte_x 100)
(setq flotte_y 70)
(setq sens 1)
(setq attente 0)
(setq pas_joué 0)
(setq tir_actif false)
(setq tir_x 0)
(setq tir_y 0)
(setq bombes (list))
(setq explosions (list))
(setq vies 3)
(setq score 0)
(setq vague 1)
(setq clignote 0)
(setq état "attente")
(setq JEU "Envahisseurs (dessins)")
(setq records_rangés true)
(defun lit_records ()
   (setq t (prend_base "don0"))
   (if (= t "")
      (return (dictionary))
   )
   (maybe (setq d (json_parse t)) (block (setg records_rangés false) (return (dictionary))))
   (if (= (typede d) "dictionnaire")
      (return d)
   )
   (setg records_rangés false)
   (return (dictionary))
)
(defun record_du_jeu ()
   (setq d (lit_records))
   (if (in_it d JEU)
      (return (at d JEU))
   )
   (return 0)
)
(defun range_record (valeur)
   (setq d (lit_records))
   (check records_rangés
      (set@ d JEU valeur)
      (range_base "don0" (json d))
   )
)
(setq record (record_du_jeu))
(setq nouveau_record false)
(defun fin_de_partie ()
   (check (> score record)
      (setg record score)
      (setg nouveau_record true)
      (range_record score)
   )
)
(defun env_x (i)
   (return (p+ flotte_x (* (_% i COLONNES) PAS_X)))
)
(defun env_y (i)
   (return (p+ flotte_y (* (_/ i COLONNES) PAS_Y)))
)
(defun restants ()
   (return (longueur (filtercar (λ (v) v) vivants)))
)
(defun nouvelle_vague ()
   (setg vivants (mapcar (λ (i) true) (intervalle (* COLONNES RANGÉES))))
   (setg flotte_x (_/ (largeur) 8))
   (setg flotte_y (p+ 70 (* (minimum (- vague 1) 4) 15)))
   (setg sens 1)
   (setg bombes (list))
   (setg tir_actif false)
   (setg flotte_à_refaire true)
)
(defun recommence ()
   (pose_boucliers)
   (setg vies 3)
   (setg score 0)
   (setg vague 1)
   (nouvelle_vague)
   (setg nouveau_record false)
   (setg état "jeu")
)
(defun tire ()
   (if (!= état "jeu")
      (recommence)
      (check (¬ tir_actif)
         (setg tir_actif true)
         (setg tir_x vaisseau_x)
         (setg tir_y (- VAISSEAU_Y 20))
         (joue_son son_tir)
      )
   )
)
(defun place_vaisseau (x)
   (setg vaisseau_x (minimum (maximum x 30) (- (largeur) 30)))
)
(defun souris (x y)
   (place_vaisseau x)
)
(setq TACTILE (!= (at (appareil) 0) "ordinateur"))
(setq TIRER "Clic ou Espace")
(if TACTILE
   (setq TIRER "Touche 🔥 Feu")
)
(defun bouton_feu (clef texte)
   (tire)
)
(defun clic (x y)
   (place_vaisseau x)
   (if (andvalue TACTILE (= état "jeu"))
      (return ())
   )
   (tire)
)
(defun clavier (t)
   (if (orvalue (= t "espace") (= t "haut"))
      (tire)
      (if (= (minuscules t) "d")
         (setg préparé (¬ préparé))
      )
   )
)
(defun pilote_clavier ()
   (if (touche_enfoncée "gauche")
      (place_vaisseau (- vaisseau_x 6))
   )
   (if (touche_enfoncée "droite")
      (place_vaisseau (+ vaisseau_x 6))
   )
)
(defun avance_flotte ()
   (-= attente 1)
   (if (> attente 0)
      (return ())
   )
   (setg attente (maximum 2 (- (+ (_/ (restants) 2) 4) vague)))
   (joue_son (at pas_de_marche (_% pas_joué 4)))
   (+= pas_joué 1)
   (setq gauche (largeur))
   (setq droite 0)
   (loop i 
      (intervalle (longueur vivants))
      (check (at vivants i)
         (setq gauche (minimum gauche (env_x i)))
         (setq droite (maximum droite (p+ (env_x i) LARGEUR_ENV)))
      )
   )
   (setq au_bord_droit (andvalue (= sens 1) (> (+ droite 12) (largeur))))
   (setq au_bord_gauche (andvalue (= sens -1) (< (- gauche 12) 0)))
   (if (orvalue au_bord_droit au_bord_gauche)
      (block (+= flotte_y 20) (setg sens (sign sens)))
      (setg flotte_x (p+ flotte_x (* 12 sens)))
   )
   (setg flotte_à_refaire true)
)
(defun lâche_bombes ()
   (check (andvalue (<= (aléatoire 1 100) (p+ 2 vague)) (< (longueur bombes) (p+ 3 vague)))
      (setq i (aléatoire 0 (- (longueur vivants) 1)))
      (if (at vivants i)
         (push bombes (list (p+ (env_x i) (/ LARGEUR_ENV 2)) (p+ (env_y i) HAUTEUR_ENV)))
      )
   )
)
(defun avance_tir ()
   (if (¬ tir_actif)
      (return ())
   )
   (-= tir_y 12)
   (check (< tir_y 0)
      (setg tir_actif false)
      (return ())
   )
   (check (touche_bouclier tir_x tir_y)
      (setg tir_actif false)
      (return ())
   )
   (loop i 
      (intervalle (longueur vivants))
      (check (at vivants i)
         (setq x (env_x i))
         (setq y (env_y i))
         (check (andvalue
               (andvalue (andvalue (> tir_x x) (< tir_x (p+ x LARGEUR_ENV))) (> tir_y y))
               (< tir_y (p+ y HAUTEUR_ENV))
            )
            (set@ vivants i false)
            (setg tir_actif false)
            (setg flotte_à_refaire true)
            (setg score (p+ score (* 10 (- RANGÉES (_/ i COLONNES)))))
            (push explosions (list (p+ x (/ LARGEUR_ENV 2)) (p+ y (/ HAUTEUR_ENV 2)) 8))
            (joue_son son_explosion)
            (break)
         )
      )
   )
)
(defun avance_bombes ()
   (setg bombes
      (mapcar
         (λ (b) 
            (list (at b 0) (p+ (+ (at b 1) 5) vague))
         )
         (filtercar
            (λ (b) 
               (andvalue (< (at b 1) (hauteur)) (¬ (touche_bouclier (at b 0) (+ (at b 1) 10))))
            )
            bombes
         )
      )
   )
   (if (> clignote 0)
      (return ())
   )
   (setq atteint false)
   (loop b bombes
      (check (andvalue (< (absolu (- (at b 0) vaisseau_x)) 24) (< (absolu (- (at b 1) VAISSEAU_Y)) 12))
         (setq atteint true)
         (break)
      )
   )
   (if atteint
      (touché)
   )
)
(defun touché ()
   (-= vies 1)
   (setg bombes (list))
   (setg clignote 60)
   (joue_son son_boum)
   (check (= vies 0)
      (setg état "perdu")
      (fin_de_partie)
   )
)
(defun vérifie_vague ()
   (check (= (restants) 0)
      (+= vague 1)
      (+= score 100)
      (nouvelle_vague)
      (return ())
   )
   (loop i 
      (intervalle (longueur vivants))
      (check (andvalue (at vivants i) (> (p+ (env_y i) HAUTEUR_ENV) (- VAISSEAU_Y 20)))
         (setg vies 0)
         (setg état "perdu")
         (fin_de_partie)
         (joue_son son_boum)
         (break)
      )
   )
)
(setq BOUCLIER_X (mapcar (λ (x) (_/ (* (largeur) x) 800)) (list 110 290 470 650)))
(setq BOUCLIER_Y (- (hauteur) 130))
(setq BLOC 6)
(setq VERTS (list "#43a047" "#66bb6a"))
(setq boucliers (list))
(defun pose_boucliers ()
   (setg boucliers (list))
   (loop k 
      (intervalle 4)
      (setq blocs (list))
      (loop b 
         (intervalle 72)
         (setq ligne_b (_/ b 12))
         (setq colonne (_% b 12))
         (setq arche (andvalue (andvalue (>= ligne_b 4) (>= colonne 4)) (<= colonne 7)))
         (setq coin (andvalue (= ligne_b 0) (orvalue (= colonne 0) (= colonne 11))))
         (setq plein (¬ (orvalue arche coin)))
         (push blocs plein)
      )
      (push boucliers blocs)
   )
   (setg boucliers_à_refaire true)
)
(defun touche_bouclier (x y)
   (if (orvalue (< y BOUCLIER_Y) (>= y (p+ BOUCLIER_Y (* 6 BLOC))))
      (return false)
   )
   (loop k 
      (intervalle 4)
      (check (andvalue (>= x (at BOUCLIER_X k)) (< x (p+ (at BOUCLIER_X k) (* 12 BLOC))))
         (setq colonne (entier (_/ (- x (at BOUCLIER_X k)) BLOC)))
         (setq ligne_b (entier (_/ (- y BOUCLIER_Y) BLOC)))
         (setq b (p+ (* ligne_b 12) colonne))
         (check (at boucliers k b)
            (set@ boucliers k b false)
            (setq voisin (p+ b (choisis (list -1 1 -12 12))))
            (if (andvalue (>= voisin 0) (< voisin 72))
               (set@ boucliers k voisin false)
            )
            (setg boucliers_à_refaire true)
            (return true)
         )
      )
   )
   (return false)
)
(setq étoiles (list))
(setq nuages (list))
(setq immeubles (list))
(defun tire_décor ()
   (setg étoiles
      (mapcar
         (λ (i) 
            (list
               (aléatoire 0 (largeur))
               (aléatoire 0 (- (hauteur) 130))
               (+ 0.5 (* (hasard) 1.5))
               (choisis (list "#ffffff" "#bbdefb" "#fff9c4" "#f8bbd0"))
            )
         )
         (intervalle 260)
      )
   )
   (setg nuages
      (mapcar
         (λ (i) 
            (list
               (p+ (* (largeur) 0.6) (* (- (hasard) 0.5) 300))
               (p+ 150 (* (- (hasard) 0.5) 160))
               (p+ 15 (* (hasard) 45))
               (choisis (list "150, 80, 200" "80, 120, 220" "200, 80, 160"))
            )
         )
         (intervalle 110)
      )
   )
   (setg immeubles (list))
   (setq x_imm 0)
   (while (< x_imm (largeur))
      (setq l_imm (aléatoire 20 44))
      (setq h_imm (aléatoire 18 60))
      (setq fenêtres
         (mapcar
            (λ (k) 
               (list (+ (* (aléatoire 0 (- (_/ l_imm 7) 1)) 7) 3) (+ (* (aléatoire 0 (- (_/ h_imm 8) 1)) 8) 3))
            )
            (intervalle (aléatoire 2 9))
         )
      )
      (push immeubles (list x_imm l_imm h_imm fenêtres))
      (setq x_imm (p+ x_imm (p+ l_imm (aléatoire 0 4))))
   )
)
(tire_décor)
(setq décor (nouveau_dessin))
(setq flotte (nouveau_dessin))
(setq défenses (nouveau_dessin))
(setq flotte_à_refaire true)
(setq boucliers_à_refaire true)
(setq préparé true)
(setq temps_cumulé 0)
(setq images_comptées 0)
(setq temps_moyen 0.0)
(defun prépare_décor ()
   (vide_dessin décor)
   (setq bande (/ (hauteur) 60))
   (loop i 
      (intervalle 60)
      (couleur décor (rgb (p+ 4 (* i 0.5)) (p+ 4 (* i 0.3)) (p+ 20 (* i 0.9))))
      (rectangle_plein décor 0 (* i bande) (largeur) (+ bande 1))
   )
   (loop n nuages
      (couleur décor (+ "rgba(" (_texte (at n 3)) ", 0.05)"))
      (disque décor (at n 0) (at n 1) (at n 2))
   )
   (loop é étoiles
      (couleur décor (at é 3))
      (disque décor (at é 0) (at é 1) (at é 2))
   )
   (couleur décor "#5d4037")
   (disque décor 120 130 46)
   (couleur décor "#8d6e63")
   (ellipse_pleine décor 120 118 44 8)
   (ellipse_pleine décor 120 146 40 6)
   (couleur décor "rgba(0, 0, 0, 0.35)")
   (disque décor 136 140 40)
   (couleur_trait décor "#d7ccc8")
   (épaisseur décor 3)
   (ellipse décor 120 130 80 14)
   (épaisseur décor 1)
   (setq sol (- (hauteur) 25))
   (loop imm immeubles
      (couleur décor "#1a1a2e")
      (rectangle_plein décor (at imm 0) (- sol (at imm 2)) (at imm 1) (at imm 2))
      (couleur décor "rgba(255, 213, 79, 0.8)")
      (loop f 
         (at imm 3)
         (rectangle_plein décor (p+ (at imm 0) (at f 0)) (p+ (- sol (at imm 2)) (at f 1)) 3 4)
      )
   )
   (couleur décor "vert clair")
   (ligne décor 0 sol (largeur) sol)
)
(defun compte_décor ()
   (setq n (p+ 60 (longueur nuages) (longueur étoiles) 6 1))
   (loop imm immeubles
      (setq n (p+ n (p+ 1 (longueur (at imm 3)))))
   )
   (return n)
)
(defun blocs_restants ()
   (setq n 0)
   (loop bl boucliers
      (setq n (p+ n (longueur (filtercar (λ (b) b) bl))))
   )
   (return n)
)
(setq formes_décor (compte_décor))
(defun ajoute_envahisseur (d x y c)
   (couleur d c)
   (rectangle_plein d (+ x 6) y (- LARGEUR_ENV 12) 6)
   (rectangle_plein d x (+ y 6) LARGEUR_ENV 10)
   (rectangle_plein d (+ x 9) (- y 5) 3 5)
   (rectangle_plein d (- (p+ x LARGEUR_ENV) 12) (- y 5) 3 5)
   (couleur d "rgba(255, 255, 255, 0.35)")
   (rectangle_plein d (+ x 6) y (- LARGEUR_ENV 12) 2)
   (couleur d "noir")
   (carré_plein d (+ x 8) (+ y 8) 5)
   (carré_plein d (- (p+ x LARGEUR_ENV) 13) (+ y 8) 5)
   (couleur d "rouge clair")
   (carré_plein d (+ x 10) (+ y 10) 2)
   (carré_plein d (- (p+ x LARGEUR_ENV) 11) (+ y 10) 2)
   (couleur d c)
   (ife (= (_% pas_joué 2) 0)
      (block
         (rectangle_plein d (+ x 2) (+ y 16) 5 8)
         (rectangle_plein d (- (p+ x LARGEUR_ENV) 7) (+ y 16) 5 8)
      )
      (rectangle_plein d (+ x 8) (+ y 16) 5 8)
      (rectangle_plein d (- (p+ x LARGEUR_ENV) 13) (+ y 16) 5 8)
   )
)
(defun prépare_flotte ()
   (vide_dessin flotte)
   (loop i 
      (intervalle (longueur vivants))
      (if (at vivants i)
         (ajoute_envahisseur flotte (env_x i) (env_y i) (at COULEURS (_/ i COLONNES)))
      )
   )
)
(defun prépare_défenses ()
   (vide_dessin défenses)
   (loop k 
      (intervalle 4)
      (loop b 
         (intervalle 72)
         (check (at boucliers k b)
            (couleur défenses (at VERTS (_% (p+ (_/ b 12) b) 2)))
            (
               carré_plein
               défenses
               (p+ (at BOUCLIER_X k) (* (_% b 12) BLOC))
               (p+ BOUCLIER_Y (* (_/ b 12) BLOC))
               BLOC
            )
         )
      )
   )
)
(defun montre_dessins ()
   (ife (¬ préparé)
      (block (prépare_décor) (prépare_flotte) (prépare_défenses))
      (check flotte_à_refaire
         (prépare_flotte)
         (setg flotte_à_refaire false)
      )
      (check boucliers_à_refaire
         (prépare_défenses)
         (setg boucliers_à_refaire false)
      )
   )
   (montre_dessin décor)
   (montre_dessin défenses)
   (montre_dessin flotte)
)
(defun recale ()
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
   (setg PAS_X (minimum 56 (_/ (* (largeur) 7) 100)))
   (setg VAISSEAU_Y (- (hauteur) 50))
   (place_vaisseau vaisseau_x)
   (setg BOUCLIER_X (mapcar (λ (x) (_/ (* (largeur) x) 800)) (list 110 290 470 650)))
   (setg BOUCLIER_Y (- (hauteur) 130))
   (setg flotte_x (minimum flotte_x (- (- (- (largeur) 12) (* (- COLONNES 1) PAS_X)) LARGEUR_ENV)))
   (setg flotte_y (minimum flotte_y (- (- VAISSEAU_Y 100) (* RANGÉES PAS_Y))))
   (tire_décor)
   (prépare_décor)
   (setg formes_décor (compte_décor))
   (setg flotte_à_refaire true)
   (setg boucliers_à_refaire true)
   (check TACTILE
      (taille_texte 26)
      (bouton "feu" 10 (- (hauteur) 180) "🔥 Feu" bouton_feu)
   )
)
(defun centre (y t)
   (texte (- (/ (largeur) 2) (/ (largeur_texte t) 2)) y t)
)
(defun dessine_vaisseau ()
   (if (andvalue (> clignote 0) (= (_% (_/ clignote 5) 2) 0))
      (return ())
   )
   (couleur "#00c853")
   (rectangle_plein (- vaisseau_x 24) VAISSEAU_Y 48 12)
   (couleur "vert clair")
   (rectangle_plein (- vaisseau_x 20) (+ VAISSEAU_Y 2) 40 3)
   (rectangle_plein (- vaisseau_x 4) (- VAISSEAU_Y 10) 8 10)
   (couleur "rgba(0, 230, 118, 0.25)")
   (disque vaisseau_x (+ VAISSEAU_Y 6) 30)
)
(defun dessine ()
   (setg temps_cumulé (p+ temps_cumulé (elapse (montre_dessins))))
   (+= images_comptées 1)
   (check (= images_comptées 30)
      (setg temps_moyen (/ temps_cumulé 30))
      (setg temps_cumulé 0)
      (setg images_comptées 0)
   )
   (loop e explosions
      (couleur (+ "rgba(255, 152, 0, " (_texte (arrondi (/ (at e 2) 8) 2)) ")"))
      (disque (at e 0) (at e 1) (- 22 (* (at e 2) 2)))
      (couleur "jaune")
      (cercle (at e 0) (at e 1) (- 12 (at e 2)))
   )
   (dessine_vaisseau)
   (check tir_actif
      (couleur "rgba(255, 255, 255, 0.3)")
      (rectangle_plein (- tir_x 4) tir_y 8 20)
      (couleur "blanc")
      (rectangle_plein (- tir_x 2) tir_y 4 14)
   )
   (couleur "rouge clair")
   (loop b bombes
      (rectangle_plein (- (at b 0) 2) (at b 1) 4 10)
   )
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 20 (+ "Score : " (_texte score)))
   (texte (- (/ (largeur) 2) 60) 20 (+ "Vague " (_texte vague)))
   (texte (- (largeur) 100) 20 (+ "Vies : " (_texte vies)))
   (setq formes (p+ formes_décor (* 10 (restants)) (blocs_restants)))
   (taille_texte 14)
   (couleur "rgba(255, 255, 255, 0.8)")
   (if préparé
      (
         texte
         10
         (- (hauteur) 20)
         (+
            "Dessins préparés : "
            (_texte formes)
            " formes en 3 appels par image, "
            (_texte (arrondi temps_moyen 1))
            " ms (D : comparer)"
         )
      )
      (
         texte
         10
         (- (hauteur) 20)
         (+
            "Refaits à chaque image : "
            (_texte formes)
            " formes une par une, "
            (_texte (arrondi temps_moyen 1))
            " ms (D : revenir)"
         )
      )
   )
   (taille_texte 26)
   (couleur "blanc")
   (setq m (_/ (hauteur) 2))
   (if (= état "attente")
      (block
         (centre (+ m 30) (+ (_texte TIRER) " : défendre la Terre !"))
         (if (> record 0)
            (centre (+ m 80) (+ "Meilleur score : " (_texte record)))
         )
      )
      (check (= état "perdu")
         (couleur "rouge clair")
         (centre m "La Terre est envahie !")
         (couleur "blanc")
         (centre (+ m 45) (+ "Score : " (_texte score) ", vague " (_texte vague)))
         (centre (+ m 90) (+ (_texte TIRER) " : rejouer"))
         (if nouveau_record
            (block (couleur "jaune") (centre (+ m 140) "Nouveau record !"))
            (centre (+ m 140) (+ "Meilleur score : " (_texte record)))
         )
      )
   )
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (check (= état "jeu")
      (pilote_clavier)
      (avance_flotte)
      (lâche_bombes)
      (avance_tir)
      (avance_bombes)
      (vérifie_vague)
      (if (> clignote 0)
         (-= clignote 1)
      )
   )
   (setg explosions
      (mapcar
         (λ (e) 
            (list (at e 0) (at e 1) (- (at e 2) 1))
         )
         (filtercar (λ (e) (> (at e 2) 1)) explosions)
      )
   )
