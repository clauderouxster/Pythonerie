(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(setq son_tir (charge_son "médias/sounds/tir.wav"))
(setq son_explosion (charge_son "médias/sounds/explosion.wav"))
(setq son_boum (charge_son "médias/sounds/boum.wav"))
(setq sons_battement
   (list (charge_son "médias/sounds/pas_1.wav") (charge_son "médias/sounds/pas_3.wav"))
)
(setq rayons (list 0 12 22 40))
(setq points (list 0 100 50 20))
(setq vaisseau_x (/ (largeur) 2))
(setq vaisseau_y (/ (hauteur) 2))
(setq vit_x 0.0)
(setq vit_y 0.0)
(setq cap_x 0.0)
(setq cap_y -1.0)
(setq flamme 0)
(setq invincible 0)
(setq souris_x (/ (largeur) 2))
(setq souris_y (/ (hauteur) 2))
(setq mode_souris false)
(setq astéroïdes (list))
(setq tirs (list))
(setq particules (list))
(setq vies 3)
(setq score 0)
(setq vague 1)
(setq tempo 50)
(setq attente_battement 0)
(setq note 0)
(setq état "attente")
(setq JEU "Astéroïdes (dessins)")
(setq records_rangés true)
(defun lit_records ()
   (setq t (prend_base "don0"))
   (if (= t "")
      (return (dictionary))
   )
   (maybe (setq d (json_parse t)) (block (setg records_rangés false) (return (dictionary))))
   (if (= (typede d) "dictionnaire")
      (return d)
   )
   (setg records_rangés false)
   (return (dictionary))
)
(defun record_du_jeu ()
   (setq d (lit_records))
   (if (in_it d JEU)
      (return (at d JEU))
   )
   (return 0)
)
(defun range_record (valeur)
   (setq d (lit_records))
   (check records_rangés
      (set@ d JEU valeur)
      (range_base "don0" (json d))
   )
)
(setq record (record_du_jeu))
(setq nouveau_record false)
(defun fin_de_partie ()
   (check (> score record)
      (setg record score)
      (setg nouveau_record true)
      (range_record score)
   )
)
(defun enveloppe (v maxi)
   (if (< v 0)
      (return (p+ v maxi))
   )
   (if (>= v maxi)
      (return (- v maxi))
   )
   (return v)
)
(defun nouvel_astéroïde (x y taille)
   (setq direction (aléatoire 0 359))
   (setq v (p+ (* (- 4 taille) 0.6) (* (hasard) 1.2) (* vague 0.1)))
   (setq forme (mapcar (λ (i) (+ 0.75 (* (hasard) 0.35))) (intervalle 10)))
   (return
      (list
         x
         y
         (* (cosinus direction) v)
         (* (sinus direction) v)
         taille
         (aléatoire 0 359)
         (- (* (hasard) 2) 1)
         forme
      )
   )
)
(defun nouvelle_vague ()
   (setg astéroïdes (list))
   (loop i 
      (intervalle (minimum (p+ 3 vague) 10))
      (if (< (hasard) 0.5)
         (push astéroïdes (nouvel_astéroïde (aléatoire 0 (largeur)) 0 3))
         (push astéroïdes (nouvel_astéroïde 0 (aléatoire 0 (hauteur)) 3))
      )
   )
   (setg tempo 50)
)
(defun place_au_centre ()
   (setg vaisseau_x (/ (largeur) 2))
   (setg vaisseau_y (/ (hauteur) 2))
   (setg vit_x 0.0)
   (setg vit_y 0.0)
   (setg cap_x 0.0)
   (setg cap_y -1.0)
)
(defun commence ()
   (setg vies 3)
   (setg score 0)
   (setg vague 1)
   (setg tirs (list))
   (setg particules (list))
   (place_au_centre)
   (setg invincible 120)
   (nouvelle_vague)
   (setg nouveau_record false)
   (setg état "jeu")
)
(defun pivote (angle)
   (setq c (cosinus angle))
   (setq s (sinus angle))
   (setq nx (- (* cap_x c) (* cap_y s)))
   (setq ny (p+ (* cap_x s) (* cap_y c)))
   (setg cap_x nx)
   (setg cap_y ny)
)
(defun pousse (force)
   (setg vit_x (p+ vit_x (* cap_x force)))
   (setg vit_y (p+ vit_y (* cap_y force)))
   (setg flamme 4)
)
(defun feu ()
   (check (!= état "jeu")
      (commence)
      (return ())
   )
   (if (>= (longueur tirs) 4)
      (return ())
   )
   (push
      tirs
      (list
         (p+ vaisseau_x (* cap_x 16))
         (p+ vaisseau_y (* cap_y 16))
         (p+ (* cap_x 9) vit_x)
         (p+ (* cap_y 9) vit_y)
         45
      )
   )
   (joue_son son_tir)
)
(defun éclats (x y n)
   (loop i 
      (intervalle n)
      (setq d (aléatoire 0 359))
      (setq v (p+ 1 (* (hasard) 3)))
      (push particules (list x y (* (cosinus d) v) (* (sinus d) v) (aléatoire 20 40)))
   )
)
(defun souris (x y)
   (setg souris_x x)
   (setg souris_y y)
   (setg mode_souris true)
)
(setq TACTILE (!= (at (appareil) 0) "ordinateur"))
(setq TIRER "Clic ou Espace")
(if TACTILE
   (setq TIRER "Touche 🔥 Feu")
)
(defun bouton_feu (clef texte)
   (feu)
)
(defun place_bouton_feu ()
   (check TACTILE
      (taille_texte 26)
      (bouton "feu" (- (largeur) 140) (- (hauteur) 95) "🔥 Feu" bouton_feu)
   )
)
(defun clic (x y)
   (if (andvalue TACTILE (= état "jeu"))
      (return ())
   )
   (feu)
)
(defun clavier (t)
   (setq t (minuscules t))
   (if (= t "espace")
      (feu)
      (if (= t "c")
         (setg préparé (¬ préparé))
         (if (in_it (list "gauche" "droite" "haut" "q" "d" "z") t)
            (setg mode_souris false)
         )
      )
   )
)
(defun pilote_clavier ()
   (if (orvalue (touche_enfoncée "gauche") (touche_enfoncée "q"))
      (pivote -4)
   )
   (if (orvalue (touche_enfoncée "droite") (touche_enfoncée "d"))
      (pivote 4)
   )
   (if (orvalue (touche_enfoncée "haut") (touche_enfoncée "z"))
      (pousse 0.15)
   )
)
(defun pilote_souris ()
   (setq dx (- souris_x vaisseau_x))
   (setq dy (- souris_y vaisseau_y))
   (setq d (racine (p+ (* dx dx) (* dy dy))))
   (if (< d 1)
      (return ())
   )
   (setg cap_x (/ dx d))
   (setg cap_y (/ dy d))
   (if (> d 160)
      (pousse 0.12)
   )
)
(defun recale ()
   (setq fx (/ (largeur) ancienne_largeur))
   (setq fy (/ (hauteur) ancienne_hauteur))
   (setg vaisseau_x (* vaisseau_x fx))
   (setg vaisseau_y (* vaisseau_y fy))
   (setg souris_x (* souris_x fx))
   (setg souris_y (* souris_y fy))
   (setg astéroïdes
      (mapcar
         (λ (a) 
            (list (* (at a 0) fx) (* (at a 1) fy) (at a 2) (at a 3) (at a 4) (at a 5) (at a 6) (at a 7))
         )
         astéroïdes
      )
   )
   (setg tirs
      (mapcar (λ (t) (list (* (at t 0) fx) (* (at t 1) fy) (at t 2) (at t 3) (at t 4))) tirs)
   )
   (setg particules
      (mapcar (λ (p) (list (* (at p 0) fx) (* (at p 1) fy) (at p 2) (at p 3) (at p 4))) particules)
   )
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
   (place_bouton_feu)
   (tire_ciel)
   (prépare_ciel)
)
(defun avance_vaisseau ()
   (setg vit_x (* vit_x 0.99))
   (setg vit_y (* vit_y 0.99))
   (setq v (racine (p+ (* vit_x vit_x) (* vit_y vit_y))))
   (check (> v 7)
      (setg vit_x (/ (* vit_x 7) v))
      (setg vit_y (/ (* vit_y 7) v))
   )
   (setg vaisseau_x (enveloppe (p+ vaisseau_x vit_x) (largeur)))
   (setg vaisseau_y (enveloppe (p+ vaisseau_y vit_y) (hauteur)))
)
(defun bouge (a)
   (setq x (enveloppe (p+ (at a 0) (at a 2)) (largeur)))
   (setq y (enveloppe (p+ (at a 1) (at a 3)) (hauteur)))
   (return (list x y (at a 2) (at a 3) (at a 4) (p+ (at a 5) (at a 6)) (at a 6) (at a 7)))
)
(defun avance_tirs ()
   (setg tirs
      (mapcar
         (λ (t) 
            (list
               (enveloppe (p+ (at t 0) (at t 2)) (largeur))
               (enveloppe (p+ (at t 1) (at t 3)) (hauteur))
               (at t 2)
               (at t 3)
               (- (at t 4) 1)
            )
         )
         (filtercar (λ (t) (> (at t 4) 1)) tirs)
      )
   )
)
(defun avance_particules ()
   (setg particules
      (mapcar
         (λ (p) 
            (list
               (p+ (at p 0) (at p 2))
               (p+ (at p 1) (at p 3))
               (* (at p 2) 0.97)
               (* (at p 3) 0.97)
               (- (at p 4) 1)
            )
         )
         (filtercar (λ (p) (> (at p 4) 1)) particules)
      )
   )
)
(defun chocs ()
   (setq restants (list))
   (setq utilisés (list))
   (loop a astéroïdes
      (setq r (at rayons (at a 4)))
      (setq touché -1)
      (loop j 
         (intervalle (longueur tirs))
         (check (andvalue (< touché 0) (¬ (in_it utilisés j)))
            (setq dx (- (at tirs j 0) (at a 0)))
            (setq dy (- (at tirs j 1) (at a 1)))
            (if (< (p+ (* dx dx) (* dy dy)) (* r r))
               (setq touché j)
            )
         )
      )
      (if (>= touché 0)
         (block
            (push utilisés touché)
            (setg score (p+ score (at points (at a 4))))
            (éclats (at a 0) (at a 1) 8)
            (joue_son son_explosion)
            (check (> (at a 4) 1)
               (push restants (nouvel_astéroïde (at a 0) (at a 1) (- (at a 4) 1)))
               (push restants (nouvel_astéroïde (at a 0) (at a 1) (- (at a 4) 1)))
            )
         )
         (push restants a)
      )
   )
   (setg astéroïdes restants)
   (setg tirs
      (mapcar
         (λ (j) 
            (at tirs j)
         )
         (filtercar (λ (j) (¬ (in_it utilisés j))) (intervalle (longueur tirs)))
      )
   )
)
(defun perd_une_vie ()
   (-= vies 1)
   (éclats vaisseau_x vaisseau_y 20)
   (joue_son son_boum)
   (ife (<= vies 0)
      (block (setg état "perdu") (fin_de_partie))
      (place_au_centre)
      (setg invincible 150)
   )
)
(defun choc_vaisseau ()
   (if (> invincible 0)
      (return ())
   )
   (loop a astéroïdes
      (setq dx (- (at a 0) vaisseau_x))
      (setq dy (- (at a 1) vaisseau_y))
      (setq r (+ (at rayons (at a 4)) 10))
      (check (< (p+ (* dx dx) (* dy dy)) (* r r))
         (perd_une_vie)
         (break)
      )
   )
)
(defun battement_de_cœur ()
   (-= attente_battement 1)
   (if (> attente_battement 0)
      (return ())
   )
   (joue_son (at sons_battement (_% note 2)))
   (+= note 1)
   (setg tempo (maximum 12 (- tempo 1)))
   (setg attente_battement tempo)
)
(setq NÉBULEUSES
   (list
      (list 0.225 0.7 "120, 60, 200")
      (list 0.75 0.75 "40, 120, 200")
      (list 0.475 0.2 "200, 60, 120")
   )
)
(setq étoiles (list))
(setq nuages (list))
(setq cratères (list))
(defun tire_ciel ()
   (setg étoiles
      (mapcar
         (λ (i) 
            (list
               (aléatoire 0 (largeur))
               (aléatoire 0 (hauteur))
               (+ 0.4 (* (hasard) 1.4))
               (choisis (list "#ffffff" "#bbdefb" "#fff9c4" "#ffccbc"))
            )
         )
         (intervalle 350)
      )
   )
   (setg nuages (list))
   (loop n NÉBULEUSES
      (loop k 
         (intervalle 50)
         (push
            nuages
            (list
               (p+ (* (at n 0) (largeur)) (* (- (hasard) 0.5) 260))
               (p+ (* (at n 1) (hauteur)) (* (- (hasard) 0.5) 160))
               (p+ 12 (* (hasard) 40))
               (at n 2)
            )
         )
      )
   )
   (setg cratères
      (mapcar
         (λ (i) 
            (list
               (p+ 60 (* (- (hasard) 0.5) 60))
               (p+ (- (hauteur) 40) (* (- (hasard) 0.5) 50))
               (p+ 4 (* (hasard) 9))
            )
         )
         (intervalle 9)
      )
   )
)
(tire_ciel)
(setq ciel (nouveau_dessin))
(setq préparé true)
(setq temps_cumulé 0)
(setq images_comptées 0)
(setq temps_moyen 0.0)
(setq PAS_GALAXIE 80)
(defun prépare_ciel ()
   (vide_dessin ciel)
   (setq bande (/ (hauteur) 60))
   (loop i 
      (intervalle 60)
      (couleur ciel (rgb 0 (* i 0.3) (p+ 8 (* i 0.6))))
      (rectangle_plein ciel 0 (* i bande) (largeur) bande)
   )
   (loop n nuages
      (couleur ciel (+ "rgba(" (_texte (at n 3)) ", 0.05)"))
      (disque ciel (at n 0) (at n 1) (at n 2))
   )
   (loop é étoiles
      (couleur ciel (at é 3))
      (disque ciel (at é 0) (at é 1) (at é 2))
   )
   (setq gx (- (largeur) 160))
   (setq gy 130)
   (couleur ciel "rgba(170, 150, 255, 0.08)")
   (disque ciel gx gy 40)
   (disque ciel gx gy 26)
   (couleur ciel "rgba(230, 220, 255, 0.7)")
   (disque ciel gx gy 6)
   (loop passe 
      (list (list 5 "rgba(170, 150, 255, 0.10)") (list 1.5 "rgba(210, 200, 255, 0.55)"))
      (épaisseur ciel (at passe 0))
      (couleur_trait ciel (at passe 1))
      (loop bras 
         (intervalle 3)
         (lève_crayon ciel)
         (va_à ciel gx gy)
         (oriente ciel (* bras 120))
         (baisse_crayon ciel)
         (setq pas 0.5)
         (loop k 
            (intervalle PAS_GALAXIE)
            (avance ciel pas)
            (droite ciel 5)
            (setq pas (* pas 1.035))
         )
      )
   )
   (lève_crayon ciel)
   (épaisseur ciel 2)
   (couleur ciel "#455a64")
   (disque ciel 60 (- (hauteur) 40) 70)
   (couleur ciel "#37474f")
   (loop c cratères
      (disque ciel (at c 0) (at c 1) (at c 2))
   )
   (couleur ciel "rgba(0, 0, 0, 0.4)")
   (disque ciel 85 (- (hauteur) 20) 62)
)
(setq FORMES_CIEL
   (p+ 60 (longueur nuages) (longueur étoiles) 3 (* (* 2 3) PAS_GALAXIE) 1 (longueur cratères) 1)
)
(defun montre_ciel ()
   (if (¬ préparé)
      (prépare_ciel)
   )
   (montre_dessin ciel)
)
(defun dessine_astéroïde (a)
   (setq r (at rayons (at a 4)))
   (setq pts (list))
   (loop i 
      (intervalle 10)
      (setq angle (p+ (at a 5) (* i 36)))
      (push
         pts
         (list
            (p+ (at a 0) (* (* (cosinus angle) r) (at a 7 i)))
            (p+ (at a 1) (* (* (sinus angle) r) (at a 7 i)))
         )
      )
   )
   (couleur "#3e2723")
   (polygone_plein pts)
   (couleur "#bcaaa4")
   (polygone pts)
)
(defun dessine_vaisseau ()
   (if (andvalue (> invincible 0) (= (_% (_/ invincible 6) 2) 0))
      (return ())
   )
   (setq px (sign cap_y))
   (setq py cap_x)
   (setq arrière_x (- vaisseau_x (* cap_x 10)))
   (setq arrière_y (- vaisseau_y (* cap_y 10)))
   (check (> flamme 0)
      (setq longueur_flamme (p+ 8 (aléatoire 0 6)))
      (couleur "orange")
      (
         triangle_plein
         (p+ arrière_x (* px 5))
         (p+ arrière_y (* py 5))
         (- arrière_x (* px 5))
         (- arrière_y (* py 5))
         (- arrière_x (* cap_x longueur_flamme))
         (- arrière_y (* cap_y longueur_flamme))
      )
   )
   (couleur "#263238")
   (
      triangle_plein
      (p+ vaisseau_x (* cap_x 16))
      (p+ vaisseau_y (* cap_y 16))
      (p+ arrière_x (* px 10))
      (p+ arrière_y (* py 10))
      (- arrière_x (* px 10))
      (- arrière_y (* py 10))
   )
   (couleur "blanc")
   (épaisseur 2)
   (
      triangle
      (p+ vaisseau_x (* cap_x 16))
      (p+ vaisseau_y (* cap_y 16))
      (p+ arrière_x (* px 10))
      (p+ arrière_y (* py 10))
      (- arrière_x (* px 10))
      (- arrière_y (* py 10))
   )
)
(defun texte_centré (y t)
   (texte (/ (- (largeur) (largeur_texte t)) 2) y t)
)
(defun dessine ()
   (setg temps_cumulé (p+ temps_cumulé (elapse (montre_ciel))))
   (+= images_comptées 1)
   (check (= images_comptées 30)
      (setg temps_moyen (/ temps_cumulé 30))
      (setg temps_cumulé 0)
      (setg images_comptées 0)
   )
   (épaisseur 2)
   (loop a astéroïdes
      (dessine_astéroïde a)
   )
   (couleur "rgba(255, 255, 255, 0.3)")
   (loop t tirs
      (disque (at t 0) (at t 1) 5)
   )
   (couleur "blanc")
   (loop t tirs
      (disque (at t 0) (at t 1) 2)
   )
   (loop p particules
      (couleur (+ "rgba(255, 152, 0, " (_texte (arrondi (/ (at p 4) 40) 2)) ")"))
      (rectangle_plein (- (at p 0) 1.5) (- (at p 1) 1.5) 3 3)
   )
   (if (= état "jeu")
      (dessine_vaisseau)
   )
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 10 (+ "Score : " (_texte score)))
   (texte_centré 10 (+ "Vague " (_texte vague)))
   (texte (- (largeur) 100) 10 (+ "Vies : " (_texte vies)))
   (taille_texte 14)
   (couleur "rgba(255, 255, 255, 0.8)")
   (if préparé
      (
         texte
         10
         (- (hauteur) 20)
         (+
            "Ciel préparé : "
            (_texte FORMES_CIEL)
            " formes en 1 appel par image, "
            (_texte (arrondi temps_moyen 1))
            " ms (C : comparer)"
         )
      )
      (
         texte
         10
         (- (hauteur) 20)
         (+
            "Ciel refait à chaque image : "
            (_texte FORMES_CIEL)
            " formes une par une, "
            (_texte (arrondi temps_moyen 1))
            " ms (C : revenir)"
         )
      )
   )
   (couleur "blanc")
   (if (= état "attente")
      (block
         (taille_texte 48)
         (texte_centré (- (/ (hauteur) 2) 80) "ASTÉROÏDES")
         (taille_texte 22)
         (texte_centré (/ (hauteur) 2) (+ (_texte TIRER) " : commencer"))
         (if (> record 0)
            (texte_centré (+ (/ (hauteur) 2) 50) (+ "Meilleur score : " (_texte record)))
         )
      )
      (check (= état "perdu")
         (taille_texte 30)
         (couleur "rouge clair")
         (texte_centré (- (/ (hauteur) 2) 60) "Vaisseau détruit !")
         (couleur "blanc")
         (taille_texte 22)
         (texte_centré (/ (hauteur) 2) (+ "Score : " (_texte score) ", vague " (_texte vague)))
         (texte_centré (+ (/ (hauteur) 2) 40) (+ (_texte TIRER) " : rejouer"))
         (if nouveau_record
            (block (couleur "jaune") (texte_centré (+ (/ (hauteur) 2) 90) "Nouveau record !"))
            (texte_centré (+ (/ (hauteur) 2) 90) (+ "Meilleur score : " (_texte record)))
         )
      )
   )
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (check (= état "jeu")
      (if mode_souris
         (pilote_souris)
         (pilote_clavier)
      )
      (avance_vaisseau)
      (avance_tirs)
      (chocs)
      (choc_vaisseau)
      (battement_de_cœur)
      (check (= (longueur astéroïdes) 0)
         (+= vague 1)
         (nouvelle_vague)
      )
      (if (> invincible 0)
         (-= invincible 1)
      )
      (if (> flamme 0)
         (-= flamme 1)
      )
   )
