(setq scène (nouvelle_scène))
(boîte scène 0 -0.05 0 14 0.1 14 "vert clair")
(lumière scène 0 10 5)
(setq fontaine (modèle_glb scène 0 0 0 "médias/glb/fountain.glb"))
(setq dragon (modèle_glb scène 4 0 0 "médias/glb/dragon.glb"))
(caméra scène 0 6 11 0 0.5 0)
(montre_3d scène)
(fond "bleu clair")
(caméra_libre)
(joue_animation dragon "Walk")
(setq angle 0)
(setq pause 0)
(defun image ()
   (efface)
   (texte 10 10 "Clique sur le dragon")
   (check (> pause 0)
      (setg pause (- pause 1))
      (if (= pause 0)
         (joue_animation dragon "Walk")
      )
      (return)
   )
   (setg angle (p+ angle 0.6))
   (setq a (/ (* angle pi) 180))
   (déplace dragon (* 4 (cos a)) 0 (* 4 (sin a)))
   (oriente_3d dragon 0 (sign angle) 0)
)
(defun clic (numéro)
   (check (= numéro dragon)
      (joue_animation dragon "Wave")
      (setg pause 60)
   )
)
(quand_clic_objet clic)
(animer image 30)
