(defun milieu_de (a b)
   (return (list (/ (p+ (at a 0) (at b 0)) 2) (/ (p+ (at a 1) (at b 1)) 2)))
)
(setq p (list 1 2))
(println (_texte (at p 0)) (_texte (at p 1)))
(setq m (milieu_de (list 0 0) (list 4 6)))
(println (_texte (at m 0)) (_texte (at m 1)))
(setq points (list))
(loop i 
   (intervalle 3)
   (push points (list i (* i i)))
)
(println (_texte (longueur points)) (_texte (at points 2 1)))
(setq (x y) (list 3 4))
(println (_texte (p+ x y)))
(println (_texte (* (+ 2 3) 4)))
