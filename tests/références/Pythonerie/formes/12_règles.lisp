(setq libres (dictionary "Pré" true "Lac" false))
(defpred agit (j "prends" { "objet" : o $ : nil })
   (in_it libres o)
   (at libres o)
   (return (+ "✓ " (_texte j) " prend " (_texte o)))
)
(defpred agit (j "prends" arguments)
   (return "✗ prends : objet inconnu ou déjà pris")
)
(defpred agit (j outil arguments)
   (return (+ "✗ " (_texte outil) " : outil inconnu"))
)
(println (_texte (agit "A" "prends" (dictionary "objet" "Pré" "raison" "x"))))
(println (_texte (agit "A" "prends" (dictionary "objet" "Lac"))))
(println (_texte (agit "A" "prends" (dictionary "raison" "x"))))
(println (_texte (agit "A" "vole" (dictionary))))
(defpred tête ([premier $ reste])
   (println "premier" (_texte premier) "reste" (_texte reste))
)
(defpred tête (x)
   (println "vide")
)
(tête (list 1 2 3))
(tête (list))
