(canevas 1000 700)
(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            700
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 1000))
   (portrait 700 long)
   (paysage long 700)
)
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(setq TACTILE (!= (at écran 0) "ordinateur"))
(setq son_tir (charge_son "médias/sounds/laser.wav"))
(setq son_ennemi (charge_son "médias/sounds/shoot.wav"))
(setq son_explosion (charge_son "médias/sounds/explosion_small.wav"))
(setq son_bombe (charge_son "médias/sounds/explosion_big.wav"))
(setq son_impact (charge_son "médias/sounds/hurt.wav"))
(setq son_bonus (charge_son "médias/sounds/powerup.wav"))
(setq son_missile (charge_son "médias/sounds/engine.wav"))
(setq son_poussée (charge_son "médias/sounds/whoosh.wav"))
(setq son_départ (charge_son "médias/sounds/start.wav"))
(setq son_fin (charge_son "médias/sounds/game_over.wav"))
(setq son_pause (charge_son "médias/sounds/pause.wav"))
(setq son_secours (charge_son "médias/sounds/notification.wav"))
(setq son_soin (charge_son "médias/sounds/sparkle.wav"))
(import "vol/Sons" ())
(import "vol/Scène" ())
(import "vol/Terrain" ())
(import "vol/Ciel" ())
(import "vol/Records" ())
(import "vol/Combat" ())
(import "vol/Interface" ())
(import "vol/Secours" ())
(initialise_audio)
(setq état "accueil")
(setq px 0)
(setq pz 10)
(setq vies 5)
(setq score 0)
(setq bombes 1)
(setq charge 0)
(setq détruits 0)
(setq vitesse 18)
(setq distance_vol 0)
(setq région 0)
(setq invulnérable 0)
(setq secousse 0)
(setq éclair 0)
(setq attente_tir 0)
(setq attente_ennemi 1)
(setq précédent (millisecondes))
(defun commence ()
   (bruit "départ")
   (setg état "vol")
   (setg px 0)
   (setg pz 10)
   (setg vies 5)
   (setg score 0)
   (setg charge 0)
   (setg détruits 0)
   (setg bombes 1)
   (setg vitesse 18)
   (setg distance_vol 0)
   (setg numéro_secteur 0)
   (setg invulnérable 2)
   (setg attente_ennemi 1)
   (réinitialise_secours)
   (loop réserve 
      (list ennemis lasers menaces)
      (loop e réserve
         (cache_entité e)
      )
   )
   (loop i 
      (intervalle (longueur terrains))
      (setq t (at terrains i))
      (cache_objet . at t "variantes" (at t "genre"))
      (set@ t "genre" 0)
      (set@ t "z" (- 24 (* i 24)))
      (montre_objet . at t "variantes" 0)
   )
   (loop i 
      (intervalle (longueur silos))
      (set@ silos i "z" (- -20 (* i 27)))
      (set@ silos i "tir" (p+ 2 (* (hasard) 2)))
   )
   (montre_objet joueur)
)
(defun touche (t)
   (if (= t "t")
      (teste_audio)
   )
   (check (= t "m")
      (setg sons_actifs (¬ sons_actifs))
      (if sons_actifs
         (teste_audio)
      )
   )
   (if (orvalue (= t "r") (= t "R"))
      (if (orvalue (= état "accueil") (= état "fin"))
         (commence)
      )
   )
   (if (= t "entrée")
      (if (= état "pause")
         (setg état "vol")
         (if (= état "vol")
            (bombe)
         )
      )
   )
   (check (= t "p")
      (bruit "pause")
      (if (= état "vol")
         (setg état "pause")
         (if (= état "pause")
            (setg état "vol")
         )
      )
   )
)
(defun clic (x y)
   (setq milieu (/ (largeur) 2))
   (if (andvalue (< (- milieu 180) x (+ milieu 170)) (< (+ (haut_milieu) 18) y (+ (haut_milieu) 56)))
      (teste_audio)
      (if (orvalue (= état "accueil") (= état "fin"))
         (commence)
         (if (= état "pause")
            (setg état "vol")
            (if (andvalue (< (- (largeur) 310) x (- (largeur) 20)) (< 80 y 122))
               (bombe)
            )
         )
      )
   )
)
(defun glisse (x y)
   (check (= état "vol")
      (setg px (maximum -21 (minimum 21 (/ (- (/ (* x 1000) (largeur)) 500) 20))))
      (setg pz (maximum -3 (minimum 19 (/ (- (/ (* y 700) (hauteur)) 380) 16))))
   )
)
(defun bouton_feu (clef texte)
   (if (= état "vol")
      (tire)
   )
)
(defun bouton_bombe (clef texte)
   (bombe)
)
(defun place_boutons ()
   (check TACTILE
      (taille_texte 26)
      (bouton "feu" (- (largeur) 160) (- (hauteur) 160) "🔥 Feu" bouton_feu)
      (bouton "bombe" (- (largeur) 360) (- (hauteur) 160) "💣 Bombe" bouton_bombe)
   )
)
(defun recale ()
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
   (cadre_caméra)
   (place_boutons)
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (setq maintenant (millisecondes))
   (setq écart (- maintenant précédent))
   (if (< écart 0)
      (+= écart 86400000)
   )
   (setq dt (minimum 0.05 (/ écart 1000)))
   (setg précédent maintenant)
   (if (!= état "pause")
      (anime_ciel dt)
   )
   (check (= état "vol")
      (setq mouvement 0)
      (check (orvalue (touche_enfoncée "gauche") (touche_enfoncée "q"))
         (-= px (* dt 19))
         (setq mouvement 1)
      )
      (check (orvalue (touche_enfoncée "droite") (touche_enfoncée "d"))
         (setg px (p+ px (* dt 19)))
         (setq mouvement -1)
      )
      (if (orvalue (touche_enfoncée "haut") (touche_enfoncée "z"))
         (-= pz (* dt 17))
      )
      (if (orvalue (touche_enfoncée "bas") (touche_enfoncée "s"))
         (setg pz (p+ pz (* dt 17)))
      )
      (setg px (maximum -21 (minimum 21 px)))
      (setg pz (maximum -3 (minimum 19 pz)))
      (déplace joueur px altitude_vol pz)
      (oriente_3d joueur 0 0 (* mouvement 18))
      (-= invulnérable dt)
      (-= éclair dt)
      (-= secousse dt)
      (if (andvalue (> invulnérable 0) (= (_% (entier (* invulnérable 12)) 2) 0))
         (cache_objet joueur)
         (montre_objet joueur)
      )
      (setg distance_vol (p+ distance_vol (* vitesse dt)))
      (setg vitesse (minimum 29 (p+ 18 (/ distance_vol 1200))))
      (avance_terrain dt)
      (-= attente_tir dt)
      (check (andvalue (<= attente_tir 0) (touche_enfoncée "espace"))
         (tire)
         (setg attente_tir 0.13)
      )
      (-= attente_ennemi dt)
      (check (<= attente_ennemi 0)
         (nouvel_ennemi)
         (setg attente_ennemi (maximum 0.6 (- 1.8 (/ distance_vol 6000))))
      )
      (avance_combat dt)
      (if (= état "vol")
         (avance_secours dt)
      )
   )
   (interface)
   (affiche_secours)
)
(montre_3d scène)
(cadre_caméra)
(place_boutons)
(fond "#91b8c7")
(quand_touche touche)
(quand_clic clic)
(quand_glisse glisse)
(animer image 16)
