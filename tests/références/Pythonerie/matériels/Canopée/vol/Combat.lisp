(import "vol/Missiles" ())
(import "vol/Escadrille" ())
(setq seuil_bombe 50)
(defun récompense ()
   (+= score 100)
   (enregistre_record)
   (+= détruits 1)
   (+= charge 1)
   (check (>= charge seuil_bombe)
      (-= charge seuil_bombe)
      (+= bombes 1)
      (bruit "bonus")
   )
)
(defun touche_joueur ()
   (if (orvalue (> invulnérable 0) (!= état "vol"))
      (return ())
   )
   (-= vies 1)
   (bruit "impact")
   (setg invulnérable 1.8)
   (setg secousse 0.3)
   (explose px altitude_vol pz)
   (check (<= vies 0)
      (setg état "fin")
      (bruit "fin")
      (cache_objet joueur)
   )
)
(defun lance (réserve x y z missile)
   (loop t réserve
      (check (¬ (at t "actif"))
         (set@ t "actif" true)
         (set@ t "x" x)
         (set@ t "y" y)
         (set@ t "z" z)
         (set@ t "missile" true)
         (set@ t "aérien" (¬ missile))
         (prépare_menace t)
         (if missile
            (bruit "missile")
            (bruit "ennemi")
         )
         (setq dx (- px x))
         (setq dz (- (+ pz 2) z))
         (setq distance (maximum 1 (racine (p+ (* dx dx) (* dz dz)))))
         (setq allure (if missile 24 32))
         (set@ t "vx" (* (/ dx distance) allure))
         (set@ t "vz" (* (/ dz distance) allure))
         (set@ t "vy" (* (/ (- altitude_vol y) distance) allure))
         (déplace (at t "objet") x y z)
         (montre_objet . at t "objet")
         (return ())
      )
   )
)
(defun tire ()
   (loop t lasers
      (check (¬ (at t "actif"))
         (set@ t "actif" true)
         (set@ t "x" px)
         (set@ t "y" altitude_vol)
         (set@ t "z" (- pz 2))
         (bruit "tir")
         (montre_objet . at t "objet")
         (return ())
      )
   )
)
(defun bombe ()
   (if (orvalue (<= bombes 0) (!= état "vol"))
      (return ())
   )
   (-= bombes 1)
   (bruit "bombe")
   (setg éclair 0.65)
   (loop e ennemis
      (check (andvalue (at e "actif") (< (at e "z") pz))
         (explose (at e "x") (at e "y") (at e "z"))
         (cache_entité e)
         (récompense)
      )
   )
   (loop t menaces
      (check (andvalue (at t "actif") (< (at t "z") pz))
         (if (at t "missile")
            (récompense)
         )
         (cache_entité t)
      )
   )
)
(defun avance_combat (dt)
   (loop e ennemis
      (check (at e "actif")
         (avance_ennemi e dt)
         (if (¬ (at e "actif"))
            (continue)
         )
         (check (andvalue
               (andvalue (< (absolu (- (at e "x") px)) 2) (< (absolu (- (at e "z") pz)) 2))
               (< (absolu (- (at e "y") altitude_vol)) 1.5)
            )
            (touche_joueur)
            (cache_entité e)
         )
         (if (> (at e "z") 32)
            (cache_entité e)
         )
      )
   )
   (loop t menaces
      (check (at t "actif")
         (avance_menace t dt)
         (check (andvalue
               (andvalue (< (absolu (- (at t "x") px)) 1.1) (< (absolu (- (at t "z") pz)) 1.4))
               (< (absolu (- (at t "y") altitude_vol)) 1)
            )
            (touche_joueur)
            (cache_entité t)
         )
         (if (orvalue (> (at t "z") 35) (> (absolu (at t "x")) 45))
            (cache_entité t)
         )
      )
   )
   (loop l lasers
      (check (at l "actif")
         (-= (at l "z") (* dt 95))
         (déplace (at l "objet") (at l "x") altitude_vol (at l "z"))
         (loop e ennemis
            (check (andvalue
                  (andvalue
                     (andvalue (andvalue (at l "actif") (at e "actif")) (< (absolu (- (at l "x") (at e "x"))) 1.8))
                     (< (absolu (- (at l "z") (at e "z"))) 2.5)
                  )
                  (< (absolu (- (at e "y") altitude_vol)) 1.4)
               )
               (explose (at e "x") (at e "y") (at e "z"))
               (cache_entité e)
               (cache_entité l)
               (récompense)
            )
         )
         (loop t menaces
            (check (andvalue
                  (andvalue
                     (andvalue
                        (andvalue (andvalue (at l "actif") (at t "actif")) (at t "missile"))
                        (< (absolu (- (at l "x") (at t "x"))) 1.1)
                     )
                     (< (absolu (- (at l "z") (at t "z"))) 2)
                  )
                  (< (absolu (- (at t "y") altitude_vol)) 1.4)
               )
               (explose (at t "x") (at t "y") (at t "z"))
               (cache_entité t)
               (cache_entité l)
               (récompense)
            )
         )
         (if (< (at l "z") -150)
            (cache_entité l)
         )
      )
   )
   (loop e éclats
      (check (> (at e "vie") 0)
         (-= (at e "vie") dt)
         (déplace (at e "objet") (at e "x") (at e "y") (at e "z"))
         (if (<= (at e "vie") 0)
            (cache_objet . at e "objet")
         )
      )
   )
)
