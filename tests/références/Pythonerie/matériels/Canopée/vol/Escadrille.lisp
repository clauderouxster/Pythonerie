(import "vol/Obstacles" ())
(defun nouvel_ennemi ()
   (loop e ennemis
      (check (¬ (at e "actif"))
         (set@ e "actif" true)
         (set@ e "côté" (choisis (list -1 1)))
         (set@ e "cible_x" (aléatoire -11 11))
         (loop t terrains
            (check (andvalue (>= (at t "genre") 3) (< -170 (at t "z") 20))
               (set@ e "cible_x" (aléatoire -3 3))
               (break)
            )
         )
         (set@ e "x" (* (at e "côté") 75))
         (set@ e "y" (+ altitude_vol 32))
         (set@ e "z" -110)
         (set@ e "âge" 0)
         (set@ e "durée" (+ 2.8 (* (hasard) 0.5)))
         (set@ e "phase" (* (hasard) 360))
         (set@ e "tir" 0.7)
         (set@ e "rail" (choisis (list -1 1)))
         (set@ e "tangage" 0)
         (déplace (at e "objet") (at e "x") (at e "y") (at e "z"))
         (montre_objet . at e "objet")
         (return ())
      )
   )
)
(defun route_ennemi (e âge)
   (check (< âge (at e "durée"))
      (setq u (minimum 1 (/ âge (at e "durée"))))
      (setq v (- 1 u))
      (setq côté (at e "côté"))
      (setq cible (at e "cible_x"))
      (setq x
         (p+
            (* (* (* v v) v) côté 75)
            (* (* (* (* 3 v) v) u) côté 48)
            (* (p+ (* (* (* 3 v) u) u) (* (* u u) u)) cible)
         )
      )
      (setq y (p+ altitude_vol (* (* v v) v 32) (* (* (* 3 v) v) u 15)))
      (setq z (p+ (* (* v v) v -110) (* (* (* 3 v) v) u -106) (* (* (* 3 v) u) u -90) (* (* u u) u -60)))
      (return (list x y z))
   )
   (setq après (- âge (at e "durée")))
   (setq oscillation (* (* 0.8 (sinus (p+ (at e "phase") (* après 100)))) (minimum 1 (* après 2))))
   (return
      (list (p+ (at e "cible_x") oscillation) altitude_vol (p+ -60 (* (p+ 25 (* vitesse 0.3)) après)))
   )
)
(defun avance_ennemi (e dt)
   (setq début (list (at e "x") (at e "y") (at e "z")))
   (+= (at e "âge") dt)
   (setq route (route_ennemi e (at e "âge")))
   (setq horizon 2.2)
   (setq future (route_ennemi e (p+ (at e "âge") horizon)))
   (setq objectif (maximum (at route 1) (altitude_prévue route future horizon)))
   (set@ e "y" (maximum (- (at début 1) (* 8 dt)) (minimum objectif (p+ (at début 1) (* 22 dt)))))
   (set@ e "x" (at route 0))
   (set@ e "z" (at route 2))
   (setq dx (- (at e "x") (at début 0)))
   (setq dy (- (at e "y") (at début 1)))
   (setq dz (- (at e "z") (at début 2)))
   (setq lacet (p+ 180 (angle_vecteur dx dz)))
   (setq pente (angle_vecteur (sign dy) (maximum 0.001 (racine (p+ (* dx dx) (* dz dz))))))
   (+= (at e "tangage") (* (- pente (at e "tangage")) (minimum 1 (* dt 5))))
   (setq roulis 0)
   (ife (< (at e "âge") (at e "durée"))
      (setq roulis (* (* (at e "côté") 65) (sinus (* (/ (at e "âge") (at e "durée")) 180))))
      (setq roulis (* (sign (sinus (p+ (at e "phase") (* (- (at e "âge") (at e "durée")) 100)))) 8))
      (-= (at e "tir") dt)
      (check (andvalue (<= (at e "tir") 0) (< (at e "z") (- pz 8)))
         (largue_missile e)
         (set@ e "tir" (+ 1.6 (hasard)))
      )
   )
   (oriente_3d (at e "objet") (at e "tangage") lacet roulis)
   (déplace (at e "objet") (at e "x") (at e "y") (at e "z"))
)
