(defun pan_rocheux (parent volumes x z l h p angle teinte côté)
   (setq g (groupe parent x (- (/ h 2) 0.3) z))
   (oriente_3d g 0 angle 0)
   (setq roche (boîte g 0 0 0 l h p teinte))
   (texture roche texture_minérale)
   (colore roche teinte)
   (push volumes (dictionary "x" x "z" z "l" l "h" h "p" p "angle" angle))
   (loop étage 
      (list -0.23 0.18)
      (boîte g (* (sign côté) (p+ (/ l 2) 0.025)) (* h étage) 0 0.055 0.1 p "#6a6057")
   )
   (setq fissure
      (boîte g (* (sign côté) (p+ (/ l 2) 0.04)) 0.4 (* p 0.12) 0.06 (* h 0.6) 0.13 "#554e49")
   )
   (oriente_3d fissure 8 0 0)
   (return g)
)
(defun dessine_falaises (parent graine)
   (setq canyon (groupe parent 0 0 0))
   (setq volumes (list))
   (loop côté 
      (list -1 1)
      (loop j 
         (intervalle 6)
         (setq z (p+ -10 (* j 4)))
         (setq contour (+ 7.8 (* 1.1 (bruit_relief z (p+ graine (* côté 20))))))
         (setq largeur (p+ 21 (* 2 (bruit_relief (+ z 5) graine))))
         (setq h (p+ 16 (* 3.5 (bruit_relief (+ z 11) (p+ graine (* côté 40))))))
         (setq angle (* (* côté 10) (bruit_relief (+ z 4) graine)))
         (setq x (* côté (p+ contour (/ largeur 2))))
         (setq teinte (choisis (list "#a09483" "#948575" "#ae9c86")))
         (pan_rocheux canyon volumes x z largeur h 5.8 angle teinte côté)
         (setq xx (* côté (p+ contour 1.9)))
         (
            pan_rocheux
            canyon
            volumes
            xx
            (p+ z 0.4)
            3.4
            (* h 0.88)
            4.6
            (* côté (p+ 18 (* (_% j 3) 8)))
            "#8e8072"
            côté
         )
         (setq sommet (groupe canyon (* côté (+ contour 4)) (- h 0.3) z))
         (oriente_3d sommet (* côté 8) (+ angle 12) (* côté (p+ 12 (* (_% j 3) 6))))
         (setq plaque (boîte sommet 0 0 0 6 (+ 2.3 (_% j 3)) 4.8 "#b1a08b"))
         (texture plaque texture_minérale)
         (colore plaque "#b1a08b")
         (setq éclat (boîte canyon (* côté (- contour 0.2)) 0.65 (- z 0.7) 2 1.8 2.6 "#87796a"))
         (oriente_3d éclat 18 (* j 27) (* côté 24))
      )
   )
   (return (list canyon volumes))
)
(defun collision_falaises (volumes origine_z)
   (loop v volumes
      (if (> altitude_vol (p+ (at v "h") 0.3))
         (continue)
      )
      (setq c (cosinus (at v "angle")))
      (setq s (sinus (at v "angle")))
      (setq dx (- px (at v "x")))
      (setq dz (- (- pz origine_z) (at v "z")))
      (setq local_x (- (* c dx) (* s dz)))
      (setq local_z (p+ (* s dx) (* c dz)))
      (setq marge_x (p+ (* 1.65 (absolu c)) (* 1.45 (absolu s))))
      (setq marge_z (p+ (* 1.65 (absolu s)) (* 1.45 (absolu c))))
      (setq limite_x (p+ (/ (at v "l") 2) marge_x))
      (setq limite_z (p+ (/ (at v "p") 2) marge_z))
      (check (andvalue (< (absolu local_x) limite_x) (< (absolu local_z) limite_z))
         (touche_joueur)
         (ife (< (- limite_x (absolu local_x)) (- limite_z (absolu local_z)))
            (block (setq signe (if (>= local_x 0) 1 -1)) (setq local_x (* signe (p+ limite_x 0.03))))
            (setq signe (if (>= local_z 0) 1 -1))
            (setq local_z (* signe (p+ limite_z 0.03)))
         )
         (setg px (p+ (at v "x") (* c local_x) (* s local_z)))
         (setg pz (p+ (- (p+ origine_z (at v "z")) (* s local_x)) (* c local_z)))
      )
   )
   (déplace joueur px altitude_vol pz)
)
