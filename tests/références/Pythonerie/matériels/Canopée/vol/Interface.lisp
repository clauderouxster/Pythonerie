(defun panneau (x y l h)
   (couleur "#102b3c")
   (rectangle_plein x y l h)
   (couleur "#54d9dc")
   (rectangle_plein x y 3 h)
)
(defun haut_milieu ()
   (return (if (>= (largeur) 1000) 0 120))
)
(defun interface ()
   (efface)
   (setq milieu (/ (largeur) 2))
   (setq haut (haut_milieu))
   (check (> éclair 0)
      (couleur "#b0fbff")
      (rectangle_plein 0 0 (largeur) 7)
      (rectangle_plein 0 (- (hauteur) 7) (largeur) 7)
      (taille_texte 32)
      (texte (- milieu (/ (largeur_texte "ONDE DE CHOC") 2)) (+ haut 110) "ONDE DE CHOC")
   )
   (panneau (- milieu 180) (+ haut 18) 350 38)
   (taille_texte 14)
   (couleur (if sons_actifs "#87e6c0" "#ffb17c"))
   (setq état_audio (if sons_actifs "SON ACTIVÉ" "SON COUPÉ"))
   (texte (- milieu 166) (+ haut 28) (+ (_texte état_audio) " [M]   •   TEST AUDIO [T]"))
   (panneau 20 18 270 94)
   (couleur "#69e3e6")
   (taille_texte 13)
   (texte 35 26 "CANOPÉE / ESCADRILLE 07")
   (couleur "blanc")
   (taille_texte 26)
   (texte 35 47 (+ (_texte score) "  /  " (_texte (entier distance_vol)) " m"))
   (taille_texte 15)
   (couleur "#ffc36c")
   (texte 35 83 (+ "MEILLEUR SCORE : " (_texte meilleur_score)))
   (setq bord_droit (- (largeur) 294))
   (panneau (- bord_droit 16) 18 290 104)
   (taille_texte 17)
   (couleur "blanc")
   (setq santé (maximum 0 (minimum 5 vies)))
   (texte bord_droit 28 (+ "VIE  " (_texte (* santé 20)) " %       " (_texte santé) " / 5"))
   (couleur "#243b49")
   (rectangle_plein bord_droit 55 258 17)
   (setq teinte_vie (if (>= santé 4) "#63dfa5" (if (>= santé 2) "#ffc35b" "#ff626d")))
   (couleur teinte_vie)
   (rectangle_plein bord_droit 55 (/ (* 258 santé) 5) 17)
   (couleur "#102b3c")
   (loop repère 
      (irange 1 5 1)
      (rectangle_plein (p+ bord_droit (/ (* repère 258) 5)) 55 2 17)
   )
   (couleur "#a0b8c2")
   (rectangle bord_droit 55 258 17)
   (couleur "#ffc36c")
   (texte bord_droit 86 (+ "BOMBES : " (_texte bombes) "   [ENTRÉE]"))
   (setq bord_bas (- (hauteur) 80))
   (panneau 20 bord_bas 310 60)
   (taille_texte 12)
   (couleur "#9ebac5")
   (
      texte
      34
      (+ bord_bas 8)
      (+ "RECHARGE BOMBE   " (_texte charge) " / " (_texte seuil_bombe) " cibles")
   )
   (couleur "#234858")
   (rectangle_plein 34 (+ bord_bas 31) 277 8)
   (couleur "#58dedb")
   (rectangle_plein 34 (+ bord_bas 31) (/ (* 277 charge) seuil_bombe) 8)
   (taille_texte 13)
   (couleur "blanc")
   (texte (- bord_droit 16) (+ bord_bas 26) (at noms_régions région))
   (check (orvalue (orvalue (= état "accueil") (= état "fin")) (= état "pause"))
      (setq x (- milieu 285))
      (setq y (- (/ (hauteur) 2) 156))
      (panneau (- x 35) (- y 24) 640 350)
      (couleur "#65e5e5")
      (taille_texte 17)
      (texte x y "UN SHOOT'EM UP 3D / THREE.JS")
      (couleur "blanc")
      (taille_texte 48)
      (setq titre (if (= état "accueil") "CANOPÉE" (if (= état "fin") "VOL TERMINÉ" "PAUSE")))
      (texte x (+ y 36) titre)
      (taille_texte 19)
      (couleur "#c1d4dd")
      (ife TACTILE
         (block
            (texte x (+ y 108) "Le doigt : piloter • 🔥 Feu : tirer")
            (texte x (+ y 140) "💣 Bombe : bombe • P : pause")
         )
         (texte x (+ y 108) "Flèches ou ZQSD : piloter • Espace : tirer")
         (texte x (+ y 140) "Entrée : bombe • P : pause • M : son")
      )
      (texte x (+ y 172) (+ (_texte seuil_bombe) " vaisseaux ou missiles détruits = une bombe."))
      (texte x (+ y 204) "Évite les falaises. Les silos sont indestructibles.")
      (couleur "#ffc36c")
      (taille_texte 17)
      (setq bilan
         (if (= état "fin")
            (+ "SCORE : " (_texte score) "  •  RECORD : " (_texte meilleur_score))
            (+ "MEILLEUR SCORE : " (_texte meilleur_score))
         )
      )
      (texte x (+ y 236) bilan)
      (taille_texte 21)
      (setq invitation (if (= état "pause") "CLIQUE ICI OU APPUIE SUR P" "CLIQUE ICI OU APPUIE SUR R"))
      (if TACTILE
         (setq invitation (if (= état "pause") "TOUCHE ICI POUR CONTINUER" "TOUCHE ICI POUR JOUER"))
      )
      (texte x (+ y 266) invitation)
   )
)
