(defun angle_vecteur (a b)
   (setq bas 0)
   (setq haut 90)
   (loop i 
      (intervalle 12)
      (setq milieu (/ (p+ bas haut) 2))
      (if (< (* (sinus milieu) (absolu b)) (* (cosinus milieu) (absolu a)))
         (setq bas milieu)
         (setq haut milieu)
      )
   )
   (setq angle (/ (p+ bas haut) 2))
   (if (< b 0)
      (setq angle (- 180 angle))
   )
   (if (< a 0)
      (setq angle (sign angle))
   )
   (return angle)
)
(defun prépare_menace (t)
   (set@ t "âge" 0)
   (set@ t "cap" 0)
   (oriente_3d (at t "objet") 0 0 0)
   (cache_objet . at t "bille")
   (cache_objet . at t "fusée")
   (cache_objet . at t "petite_fusée")
   (ife (at t "aérien")
      (prépare_embarqué t)
      (montre_objet . at t "fusée")
      (montre_objet . at t "flamme")
      (oriente_3d (at t "fusée") 0 0 0)
   )
)
(defun avance_menace (t dt)
   (+= (at t "âge") dt)
   (if (at t "aérien")
      (avance_embarqué t dt)
      (ife (< (at t "âge") 1.2)
         (block
            (+= (at t "y") (* (+ 0.8 (* (at t "âge") 2.6)) dt))
            (+= (at t "z") (* vitesse dt))
            (oriente_3d (at t "fusée") 0 0 0)
         )
         (check (= (at t "cap") 0)
            (bruit "poussée")
            (setq dx (- px (at t "x")))
            (setq dy (- altitude_vol (at t "y")))
            (setq dz (maximum 4 (- pz (at t "z"))))
            (setq distance (maximum 1 (racine (p+ (* dx dx) (* dy dy) (* dz dz)))))
            (set@ t "vx" (/ dx distance))
            (set@ t "vy" (/ dy distance))
            (set@ t "vz" (/ dz distance))
            (set@ t "lacet" (angle_vecteur dx dz))
            (set@ t "inclinaison" (angle_vecteur (racine (p+ (* dx dx) (* dz dz))) dy))
            (set@ t "cap" 1)
         )
         (setq durée (- (at t "âge") 1.2))
         (setq allure (minimum 52 (p+ 4 (* durée 13) (* durée durée 6))))
         (+= (at t "x") (* (* (at t "vx") allure) dt))
         (+= (at t "y") (* (* (at t "vy") allure) dt))
         (+= (at t "z") (* (* (at t "vz") allure) dt))
         (setq bascule (minimum 1 (/ durée 0.65)))
         (oriente_3d (at t "fusée") (* (at t "inclinaison") bascule) (at t "lacet") 0)
         (if (= (_% (entier (* (at t "âge") 24)) 3) 0)
            (cache_objet . at t "flamme")
            (montre_objet . at t "flamme")
         )
      )
   )
   (déplace (at t "objet") (at t "x") (at t "y") (at t "z"))
   (if (> (at t "âge") 12)
      (cache_entité t)
   )
)
