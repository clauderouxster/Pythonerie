(defun modèle_missile_embarqué (parent)
   (setq g (groupe parent 0 0 0))
   (cylindre g 0 0 0 0.12 0.85 "#70c6ff")
   (cône g 0 0.57 0 0.125 0.3 "#fff1b8")
   (cylindre g 0 -0.4 0 0.14 0.14 "#d92e35")
   (setq tuyère (cône g 0 -0.63 0 0.12 0.34 "#ff343c"))
   (oriente_3d tuyère 180 0 0)
   (lumineux tuyère)
   (loop angle 
      (list 0 90 180 270)
      (setq aileron (groupe g 0 -0.24 0))
      (oriente_3d aileron 0 angle -12)
      (boîte aileron 0.15 0 0 0.22 0.3 0.04 "#d2edff")
   )
   (setq jet (groupe g 0 -0.82 0))
   (loop j 
      (irange 0 3 1)
      (setq feu (sphère jet 0 (* (sign j) 0.12) 0 (- 0.08 (* j 0.02)) "#ff593c"))
      (lumineux feu)
   )
   (cache_objet g)
   (return (list g jet))
)
(defun prépare_embarqué (t)
   (set@ t "cible_x" px)
   (set@ t "cible_y" altitude_vol)
   (set@ t "cible_z" (+ pz 2))
   (montre_objet . at t "petite_fusée")
   (cache_objet . at t "petit_jet")
   (oriente_3d (at t "petite_fusée") 90 0 0)
)
(defun avance_embarqué (t dt)
   (check (< (at t "âge") 0.4)
      (-= (at t "y") (* (p+ 2 (* 8 (at t "âge"))) dt))
      (+= (at t "z") (* (p+ 25 (* vitesse 0.3)) dt))
      (return ())
   )
   (check (= (at t "cap") 0)
      (setq dx (- (at t "cible_x") (at t "x")))
      (setq dy (- (at t "cible_y") (at t "y")))
      (setq dz (maximum 3 (- (at t "cible_z") (at t "z"))))
      (setq distance (maximum 0.01 (racine (p+ (* dx dx) (* dy dy) (* dz dz)))))
      (set@ t "vx" (/ dx distance))
      (set@ t "vy" (/ dy distance))
      (set@ t "vz" (/ dz distance))
      (set@ t "lacet" (angle_vecteur dx dz))
      (set@ t "inclinaison" (angle_vecteur (racine (p+ (* dx dx) (* dz dz))) dy))
      (set@ t "cap" 1)
   )
   (setq poussée (- (at t "âge") 0.4))
   (setq allure (minimum 43 (p+ 26 (* poussée 16))))
   (+= (at t "x") (* (* (at t "vx") allure) dt))
   (+= (at t "y") (* (* (at t "vy") allure) dt))
   (+= (at t "z") (* (* (at t "vz") allure) dt))
   (oriente_3d (at t "petite_fusée") (at t "inclinaison") (at t "lacet") 0)
   (if (= (_% (entier (* (at t "âge") 30)) 4) 0)
      (cache_objet . at t "petit_jet")
      (montre_objet . at t "petit_jet")
   )
)
(defun largue_missile (e)
   (setq côté (at e "rail"))
   (set@ e "rail" (sign côté))
   (lance menaces (p+ (at e "x") (* côté 0.85)) (- (at e "y") 0.65) (p+ (at e "z") 0.2) false)
)
