(defun rencontre_volume (début fin v origine défilement)
   (setq c (cosinus (at v "angle")))
   (setq s (sinus (at v "angle")))
   (setq dx (- (at début 0) (at v "x")))
   (setq dz (- (p+ (- (at début 2) origine) défilement) (at v "z")))
   (setq fx (- (at fin 0) (at v "x")))
   (setq fz (- (- (at fin 2) origine) (at v "z")))
   (setq départ (list (- (* c dx) (* s dz)) (at début 1) (p+ (* s dx) (* c dz))))
   (setq arrivée (list (- (* c fx) (* s fz)) (at fin 1) (p+ (* s fx) (* c fz))))
   (setq rayon 2.2)
   (setq bas
      (list (- (/ (sign (at v "l")) 2) rayon) (- -0.3 rayon) (- (/ (sign (at v "p")) 2) rayon))
   )
   (setq haut (list (p+ (/ (at v "l") 2) rayon) (p+ (at v "h") rayon) (p+ (/ (at v "p") 2) rayon)))
   (setq entrée 0)
   (setq sortie 1)
   (loop axe 
      (intervalle 3)
      (setq déplacement (- (at arrivée axe) (at départ axe)))
      (ife (< (absolu déplacement) 1e-06)
         (if (orvalue (< (at départ axe) (at bas axe)) (> (at départ axe) (at haut axe)))
            (return -1)
         )
         (setq a (/ (- (at bas axe) (at départ axe)) déplacement))
         (setq b (/ (- (at haut axe) (at départ axe)) déplacement))
         (setq entrée (maximum entrée (minimum a b)))
         (setq sortie (minimum sortie (maximum a b)))
         (if (> entrée sortie)
            (return -1)
         )
      )
   )
   (return entrée)
)
(defun altitude_prévue (début fin horizon)
   (setq hauteur altitude_vol)
   (setq gauche (- (minimum (at début 0) (at fin 0)) 3.2))
   (setq droite (p+ (maximum (at début 0) (at fin 0)) 3.2))
   (setq proche (- (at début 2) 3.2))
   (setq loin (p+ (at fin 2) (* vitesse horizon) 3.2))
   (loop t terrains
      (if (andvalue (!= (at t "genre") 3) (!= (at t "genre") 4))
         (continue)
      )
      (if (orvalue (< (at t "z") (- proche 18)) (> (at t "z") (+ loin 18)))
         (continue)
      )
      (setq volumes (if (= (at t "genre") 4) (at t "parois") (at t "bâtiments")))
      (loop v volumes
         (setq c (absolu (cosinus (at v "angle"))))
         (setq s (absolu (sinus (at v "angle"))))
         (setq largeur (/ (p+ (* (at v "l") c) (* (at v "p") s)) 2))
         (setq profondeur (/ (p+ (* (at v "l") s) (* (at v "p") c)) 2))
         (setq z (p+ (at t "z") (at v "z")))
         (if (orvalue (< (p+ (at v "x") largeur) gauche) (> (- (at v "x") largeur) droite))
            (continue)
         )
         (if (orvalue (< (p+ z profondeur) proche) (> (- z profondeur) loin))
            (continue)
         )
         (setq marge (if (= (at t "genre") 4) 5 3.2))
         (setq hauteur (maximum hauteur (p+ (at v "h") marge)))
      )
   )
   (return hauteur)
)
