(defun panneau_vitré (g x y z l h p)
   (boîte g x y z (p+ l 0.1) (p+ h 0.1) (p+ p 0.05) "#53616a")
   (setq teinte (choisis (list "#506976" "#78939b" "#a9bec3" "#3f596a")))
   (boîte g x y (p+ z 0.04) l h p teinte)
)
(defun immeuble_urbain (parent volumes x z étages teinte)
   (setq l 5.4)
   (setq p 6.5)
   (setq h (* étages 2.4))
   (setq g (groupe parent x -0.25 z))
   (setq base (boîte g 0 (/ h 2) 0 l h p teinte))
   (texture base texture_minérale)
   (colore base teinte)
   (boîte g 0 0.22 0 (p+ l 0.3) 0.44 (p+ p 0.3) "#747b7b")
   (loop étage 
      (intervalle étages)
      (setq y (+ 1.25 (* étage 2.4)))
      (boîte g 0 (- (* (+ étage 1) 2.4) 0.08) 0 (p+ l 0.12) 0.14 (p+ p 0.12) "#b4b5ae")
      (loop xx 
         (list -1.6 0 1.6)
         (loop face 
            (list -1 1)
            (panneau_vitré g xx y (* face (p+ (/ p 2) 0.045)) 0.95 1.2 0.06)
         )
      )
      (loop côté 
         (list -1 1)
         (loop zz 
            (list -1.8 1.8)
            (boîte g (* côté (p+ (/ l 2) 0.035)) y zz 0.07 1.15 1.05 "#547382")
         )
      )
   )
   (boîte g 0 (p+ h 0.08) 0 (p+ l 0.35) 0.22 (p+ p 0.35) "#656d70")
   (loop côté 
      (list -1 1)
      (boîte g (/ (* côté l) 2) (p+ h 0.35) 0 0.14 0.5 p "#aaa99f")
      (boîte g 0 (p+ h 0.35) (/ (* côté p) 2) l 0.5 0.14 "#aaa99f")
   )
   (boîte g -0.8 (p+ h 0.55) 0.8 1.2 0.7 1.5 "#8c9697")
   (cylindre g -0.8 (p+ h 0.94) 0.8 0.36 0.1 "#46555a")
   (cylindre g 1.5 (+ h 1.0) -1.6 0.035 1.8 "#71808a")
   (boîte g 0 0.85 (p+ (/ p 2) 0.1) 0.9 1.7 0.13 "#30464e")
   (boîte g 0 1.85 (p+ (/ p 2) 0.45) 1.5 0.13 0.8 "#677c88")
   (push volumes (dictionary "x" x "z" z "l" (p+ l 0.3) "h" (p+ h 0.9) "p" (p+ p 0.4) "angle" 0))
)
(defun dessine_quartier (parent graine)
   (setq ville (groupe parent 0 0 0))
   (setq volumes (list))
   (setq dallage (boîte ville 0 -0.2 0 57 0.15 24 "#9b9d91"))
   (texture dallage texture_minérale)
   (colore dallage "#9b9d91")
   (boîte ville 0 -0.08 0 7.5 0.08 24 "#454d50")
   (boîte ville 0 -0.06 0 57 0.08 3.8 "#454d50")
   (loop côté 
      (list -1 1)
      (boîte ville (* côté 4.25) 0.02 0 0.9 0.22 24 "#a9aca5")
      (loop z 
         (list -7 7)
         (setq étages (aléatoire 2 4))
         (setq teinte (choisis (list "#d5cdb9" "#b7b8af" "#c2b9aa" "#c8c9be")))
         (immeuble_urbain ville volumes (* côté 10.5) z étages teinte)
         (setq atelier (boîte ville (* côté 22) 1.2 z 7 2.8 7 "#929995"))
         (texture atelier texture_minérale)
         (colore atelier "#929995")
         (boîte ville (* côté 22) 2.7 z 7.5 0.25 7.5 "#54666c")
         (boîte ville (* côté 22) 0.9 (p+ z 3.55) 2.7 2 0.08 "#5a6468")
      )
      (loop z 
         (list -10 10)
         (cylindre ville (* côté 4.7) 1.6 z 0.045 3.6 "#626e74")
         (boîte ville (* côté 4.3) 3.4 z 0.9 0.1 0.18 "#cad0c8")
      )
   )
   (loop z 
      (intervalle -11 12 4)
      (boîte ville 0 -0.015 z 0.12 0.02 1.8 "#dfdfcb")
   )
   (loop côté 
      (list -1 1)
      (loop j 
         (intervalle 4)
         (boîte ville (* côté 3) -0.01 (+ -1.2 (* j 0.8)) 1.8 0.02 0.35 "#e1e0d0")
      )
   )
   (return (list ville volumes))
)
