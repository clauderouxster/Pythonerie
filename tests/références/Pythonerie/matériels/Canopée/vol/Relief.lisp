(import "vol/Falaises" ())
(defun rocher_texturé (parent x y z rayon teinte)
   (setq roche (sphère parent x y z rayon teinte))
   (texture roche texture_minérale)
   (colore roche teinte)
   (oriente_3d roche (* x 17) (* z 23) (* y 31))
   (return roche)
)
(defun bruit_relief (t graine)
   (return
      (p+
         (* (sinus (p+ (* t 13) graine)) 0.57)
         (* (sinus (p+ (* t 31) (* graine 2.7))) 0.28)
         (* (sinus (- (* t 73) graine)) 0.15)
      )
   )
)
(defun centre_défilé (z)
   (return (p+ (* 1.1 (sinus (* z 15))) (* 0.4 (sinus (* z 45)))))
)
(defun largeur_défilé (z)
   (return (+ 6.5 (* 0.5 (cosinus (* z 30)))))
)
(defun dessine_lac (parent graine)
   (setq lac (groupe parent 0 0 0))
   (loop j 
      (irange 0 7 1)
      (setq z (p+ -9 (* j 3)))
      (setq centre (* 6 (bruit_relief z graine)))
      (setq rayon (p+ 7 (* 2 (bruit_relief (+ z 11) graine))))
      (cylindre lac centre -0.22 z (p+ rayon 0.8) 0.2 "#8eaa79")
      (cylindre lac centre -0.1 z rayon 0.12 "#469eaa")
      (cylindre lac centre -0.02 z (* rayon 0.81) 0.05 "#2b829a")
      (loop côté 
         (list -1 1)
         (setq x (p+ centre (* côté (p+ rayon 0.4))))
         (setq r (+ 0.4 (* (hasard) 0.5)))
         (rocher_texturé lac x -0.18 z r "#71876b")
      )
   )
   (loop j 
      (irange 0 4 1)
      (setq x (aléatoire -4 4))
      (setq z (aléatoire -8 8))
      (setq rayon (+ 0.8 (* (hasard) 1.1)))
      (cylindre lac x 0.03 z rayon 0.2 "#709d65")
      (arbre lac x 0.13 z "saule_pleureur" 2.3)
   )
   (return lac)
)
(defun dessine_champs (parent graine)
   (setq champs (groupe parent 0 0 0))
   (setq palette (list "#beaa58" "#98a751" "#cfba72" "#849b49" "#a89555"))
   (loop j 
      (irange 0 7 1)
      (setq x (p+ -25 (* j 8)))
      (setq z (* 3 (bruit_relief (* j 5) graine)))
      (setq teinte (at palette (_% j 5)))
      (loop k 
         (irange 0 6 1)
         (setq zz (p+ -9 (* k 3.5)))
         (setq courbe (* 1.8 (bruit_relief zz (p+ graine (* j 20)))))
         (setq rayon (+ 3.3 (* 0.7 (bruit_relief (p+ zz j) graine))))
         (setq h (+ 0.07 (* 0.06 (_% j 3))))
         (setq parcelle (cylindre champs (p+ x courbe) h (p+ zz (* z 0.2)) rayon 0.28 teinte))
         (texture parcelle texture_minérale)
         (colore parcelle teinte)
         (loop rang 
            (list -1 0 1)
            (setq sillon (boîte champs (p+ x courbe (* rang 1.3)) (p+ h 0.16) zz 0.12 0.06 2.8 "#708244"))
            (oriente_3d sillon 0 (* (bruit_relief zz (p+ graine (* j 20))) 14) 0)
         )
      )
      (if (= (_% j 2) 0)
         (arbre champs (+ x 4) 0 -7 "peuplier" 3)
      )
   )
   (return champs)
)
(defun dessine_collines (parent graine)
   (loop côté 
      (list -1 1)
      (loop j 
         (irange 0 3 1)
         (setq x (* côté (p+ 35 (* j 15))))
         (setq z (* 5 (bruit_relief (* j 8) graine)))
         (setq rayon (p+ 7 (* (hasard) 4)))
         (setq bosse (p+ 1 (* (hasard) 1.6)))
         (setq colline (sphère parent x (p+ (sign rayon) bosse) z rayon "#527650"))
         (texture colline texture_minérale)
         (colore colline "#527650")
         (arbre parent x bosse z "chêne" 3)
      )
   )
)
