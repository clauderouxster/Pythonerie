(setq scène (nouvelle_scène))
(setq altitude_vol 8)
(setq caméra_jeu (caméra scène 0 20 38 0 6 -40))
(lumière scène -25 50 15 2.2 "#fff0d1")
(lumière scène 20 15 -60 1.2 "#8acbff")
(setq texture_minérale (charge_image "médias/images/walls/concrete.svg"))
(import "vol/Modèles" ())
(defun cadre_caméra ()
   (setq recul (maximum 1 (/ (/ 1000 700) (/ (largeur) (hauteur)))))
   (déplace caméra_jeu 0 (p+ 8 (* 12 recul)) (p+ 10 (* 28 recul)))
)
(setq joueur (modèle_vaisseau false))
(déplace joueur 0 altitude_vol 10)
(setq ennemis (list))
(loop i 
   (intervalle 12)
   (setq objet (modèle_vaisseau true))
   (cache_objet objet)
   (push ennemis (dictionary "objet" objet "actif" false "x" 0 "z" 0 "tir" 0 "phase" 0))
)
(defun réserve_tirs (n teinte rayon)
   (setq réserve (list))
   (loop i 
      (intervalle n)
      (setq objet (sphère scène 0 0 0 rayon teinte))
      (lumineux objet)
      (cache_objet objet)
      (push
         réserve
         (dictionary "objet" objet "actif" false "x" 0 "y" 0 "z" 0 "vx" 0 "vy" 0 "vz" 0 "missile" false)
      )
   )
   (return réserve)
)
(setq lasers (réserve_tirs 42 "#7effff" 0.22))
(setq menaces (réserve_menaces 55))
(setq éclats (list))
(loop i 
   (intervalle 14)
   (setq objet (sphère scène 0 0 0 1.0 "#ffbf50"))
   (lumineux objet)
   (cache_objet objet)
   (push éclats (dictionary "objet" objet "vie" 0 "x" 0 "y" 0 "z" 0))
)
(defun cache_entité (e)
   (set@ e "actif" false)
   (cache_objet . at e "objet")
)
(defun explose (x y z)
   (bruit "explosion")
   (loop e éclats
      (check (<= (at e "vie") 0)
         (set@ e "vie" 0.45)
         (set@ e "x" x)
         (set@ e "y" y)
         (set@ e "z" z)
         (déplace (at e "objet") x y z)
         (montre_objet . at e "objet")
         (return ())
      )
   )
)
