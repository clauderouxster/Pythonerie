(setq ambulance (groupe scène 0 0 0))
(setq coque_secours (cylindre ambulance 0 0 0 0.56 1.9 "#ffffff"))
(oriente_3d coque_secours 90 0 0)
(sphère ambulance 0 0 -0.95 0.56 "#ffffff")
(sphère ambulance 0 0 0.95 0.56 "#ffffff")
(boîte ambulance 0 -0.08 0.2 2.8 0.22 1.0 "#f6fbff")
(sphère ambulance 0 0.35 -0.85 0.34 "#6ea9bb")
(loop côté 
   (list -1 1)
   (setq moteur (cylindre ambulance (* côté 1.05) -0.08 0.48 0.23 1.1 "#ffffff"))
   (oriente_3d moteur 90 0 0)
   (sphère ambulance (* côté 1.05) -0.08 1.1 0.19 "#7df1db")
)
(boîte ambulance 0 0.62 0.15 1.45 0.15 1.5 "#ffffff")
(loop dimensions 
   (list (list 0.34 0.07 1.22) (list 1.18 0.07 0.34))
   (setq croix
      (boîte ambulance 0 0.74 0.15 (at dimensions 0) (at dimensions 1) (at dimensions 2) "#ee263d")
   )
   (lumineux croix)
)
(boîte ambulance 0 0 1.51 1.0 0.94 0.12 "#ffffff")
(boîte ambulance 0 0 1.59 0.22 0.72 0.05 "#ee263d")
(boîte ambulance 0 0 1.59 0.74 0.22 0.05 "#ee263d")
(cache_objet ambulance)
(setq secours
   (dictionary "actif" false "x" 0 "z" -90 "attente" 18 "message" "" "durée_message" 0)
)
(defun réinitialise_secours ()
   (set@ secours "actif" false)
   (set@ secours "attente" (aléatoire 10 15))
   (set@ secours "durée_message" 0)
   (cache_objet ambulance)
)
(defun arrive_secours ()
   (set@ secours "actif" true)
   (set@ secours "x" (/ (aléatoire -15 15) 10))
   (set@ secours "z" -90)
   (oriente_3d ambulance 0 180 0)
   (déplace ambulance (at secours "x") altitude_vol (at secours "z"))
   (montre_objet ambulance)
   (bruit "secours")
)
(defun récupère_secours ()
   (setq gain (minimum 2 (- 5 vies)))
   (setg vies (minimum 5 (+ vies 2)))
   (set@ secours "actif" false)
   (set@ secours "attente" (aléatoire 16 24))
   (set@
      secours
      "message"
      (if (> gain 0)
         (+ "SOINS : +" (_texte gain) " POINTS DE VIE")
         "VIE DÉJÀ AU MAXIMUM")
   )
   (set@ secours "durée_message" 3)
   (cache_objet ambulance)
   (bruit "soin")
)
(defun avance_secours (dt)
   (set@ secours "durée_message" (maximum 0 (- (at secours "durée_message") dt)))
   (check (¬ (at secours "actif"))
      (-= (at secours "attente") dt)
      (if (<= (at secours "attente") 0)
         (arrive_secours)
      )
      (return ())
   )
   (setq ancien_z (at secours "z"))
   (+= (at secours "z") (* (+ vitesse 3) dt))
   (déplace ambulance (at secours "x") altitude_vol (at secours "z"))
   (if (andvalue
         (< (absolu (- px (at secours "x"))) 2.7)
         (<= (- ancien_z 2.5) pz (p+ (at secours "z") 2.5))
      )
      (récupère_secours)
      (check (> (at secours "z") 32)
         (set@ secours "actif" false)
         (set@ secours "attente" (aléatoire 16 24))
         (cache_objet ambulance)
      )
   )
)
(defun affiche_secours ()
   (if (andvalue (!= état "vol") (!= état "pause"))
      (return ())
   )
   (check (orvalue (at secours "actif") (> (at secours "durée_message") 0))
      (panneau (- (/ (largeur) 2) 170) (+ (haut_milieu) 80) 340 58)
      (couleur "#ffffff")
      (taille_texte 15)
      (setq titre_secours (if (at secours "actif") "SECOURS EN APPROCHE" (at secours "message")))
      (texte (- (/ (largeur) 2) 156) (+ (haut_milieu) 89) titre_secours)
      (couleur "#ff8593")
      (taille_texte 13)
      (
         texte
         (- (/ (largeur) 2) 156)
         (+ (haut_milieu) 113)
         "Vaisseau blanc à croix rouge : contact = soin"
      )
   )
)
