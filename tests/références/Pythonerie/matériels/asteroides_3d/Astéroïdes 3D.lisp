(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(setq ancienne_largeur (largeur))
(setq ancienne_hauteur (hauteur))
(setq son_tir (charge_son "médias/sounds/tir.wav"))
(setq son_explosion (charge_son "médias/sounds/explosion.wav"))
(setq son_boum (charge_son "médias/sounds/boum.wav"))
(setq sons_battement
   (list (charge_son "médias/sounds/pas_1.wav") (charge_son "médias/sounds/pas_3.wav"))
)
(setq ÉCHELLE 20)
(setq rayons (list 0 12 22 40))
(setq points (list 0 100 50 20))
(setq scène (nouvelle_scène))
(defun en_3d_x (x)
   (return (/ (- x (/ (largeur) 2)) ÉCHELLE))
)
(defun en_3d_z (y)
   (return (/ (- y (/ (hauteur) 2)) ÉCHELLE))
)
(defun pose (objet x y)
   (déplace objet (en_3d_x x) 0 (en_3d_z y))
)
(setq ciel_x 30)
(setq ciel_z 22)
(setq nombre_étoiles 70)
(check (!= (at écran 0) "ordinateur")
   (setq ciel_x (/ (* 30 long) 800))
   (setq ciel_z (/ (* 22 long) 600))
   (setq nombre_étoiles 160)
)
(loop i 
   (intervalle nombre_étoiles)
   (setq étoile
      (
         sphère
         scène
         (aléatoire (sign ciel_x) ciel_x)
         -25
         (aléatoire (sign ciel_z) ciel_z)
         0.08
         "blanc"
      )
   )
   (lumineux étoile)
)
(setq image_bennu (charge_image "bennu.jpg"))
(setq image_lune (charge_image "lune.jpg"))
(defun morceau (g x y z r image teinte)
   (setq m (sphère g x y z r))
   (texture m image)
   (if (!= teinte "")
      (colore m teinte)
   )
)
(defun rocher (taille)
   (setq r (/ (at rayons taille) ÉCHELLE))
   (setq image image_bennu)
   (setq teinte "")
   (setq tirage (hasard))
   (if (< tirage 0.3)
      (setq teinte "orange clair")
      (if (< tirage 0.55)
         (setq image image_lune)
      )
   )
   (setq g (groupe scène 0 -200 0))
   (morceau g 0 0 0 (* r 0.9) image teinte)
   (morceau g (* r 0.6) (* r 0.25) (* (sign r) 0.1) (* r 0.55) image teinte)
   (morceau g (* (sign r) 0.45) (* (sign r) 0.2) (* r 0.45) (* r 0.5) image teinte)
   (morceau g (* (sign r) 0.1) (* r 0.45) (* (sign r) 0.5) (* r 0.4) image teinte)
   (oriente_3d g (aléatoire 0 359) (aléatoire 0 359) 0)
   (cache_objet g)
   (return g)
)
(setq réserves
   (list
      (list)
      (mapcar (λ (i) (rocher 1)) (intervalle 40))
      (mapcar (λ (i) (rocher 2)) (intervalle 20))
      (mapcar (λ (i) (rocher 3)) (intervalle 10))
   )
)
(defun prend_rocher (taille)
   (if (= (longueur (at réserves taille)) 0)
      (return ())
   )
   (setq g (popvalue (at réserves taille)))
   (montre_objet g)
   (return g)
)
(defun rend_rocher (a)
   (cache_objet . at a 7)
   (push (at réserves (at a 4)) (at a 7))
)
(setq réserve_tirs (list))
(loop i 
   (intervalle 4)
   (setq t (sphère scène 0 -200 0 0.22 "jaune"))
   (lumineux t)
   (cache_objet t)
   (push réserve_tirs t)
)
(setq réserve_éclats (list))
(loop i 
   (intervalle 24)
   (setq é (cube scène 0 -200 0 0.3 "orange"))
   (lumineux é)
   (cache_objet é)
   (push réserve_éclats é)
)
(setq vaisseau (groupe scène 0 0 0))
(setq corps (groupe vaisseau 0 0 0))
(setq nez (cône corps 0.3 0 0 0.62 1.9 "blanc"))
(oriente_3d nez 0 0 -90)
(boîte corps -0.3 0 0 0.75 0.16 2.1 "bleu clair")
(setq flamme_3d (cône corps -1.1 0 0 0.32 0.9 "orange"))
(oriente_3d flamme_3d 0 0 90)
(lumineux flamme_3d)
(cache_objet flamme_3d)
(lumière scène 0 25 12 2.5)
(defun hauteur_caméra ()
   (return (/ (* 32.2 (hauteur)) 600))
)
(setq caméra_3d (caméra scène 0 (hauteur_caméra) 0.01 0 0 0))
(montre_3d scène)
(fond "noir")
(setq vaisseau_x (/ (largeur) 2))
(setq vaisseau_y (/ (hauteur) 2))
(setq vit_x 0.0)
(setq vit_y 0.0)
(setq cap_x 0.0)
(setq cap_y -1.0)
(setq flamme 0)
(setq flamme_montrée false)
(setq invincible 0)
(setq roulis 0.0)
(setq souris_x (/ (largeur) 2))
(setq souris_y (/ (hauteur) 2))
(setq mode_souris false)
(setq astéroïdes (list))
(setq tirs (list))
(setq particules (list))
(setq vies 3)
(setq score 0)
(setq vague 1)
(setq tempo 50)
(setq attente_battement 0)
(setq note 0)
(setq état "attente")
(setq JEU "Astéroïdes 3D")
(setq records_rangés true)
(defun lit_records ()
   (setq t (prend_base "don0"))
   (if (= t "")
      (return (dictionary))
   )
   (maybe (setq d (json_parse t)) (block (setg records_rangés false) (return (dictionary))))
   (if (= (typede d) "dictionnaire")
      (return d)
   )
   (setg records_rangés false)
   (return (dictionary))
)
(defun record_du_jeu ()
   (setq d (lit_records))
   (if (in_it d JEU)
      (return (at d JEU))
   )
   (return 0)
)
(defun range_record (valeur)
   (setq d (lit_records))
   (check records_rangés
      (set@ d JEU valeur)
      (range_base "don0" (json d))
   )
)
(setq record (record_du_jeu))
(setq nouveau_record false)
(defun fin_de_partie ()
   (check (> score record)
      (setg record score)
      (setg nouveau_record true)
      (range_record score)
   )
)
(defun enveloppe (v maxi)
   (if (< v 0)
      (return (p+ v maxi))
   )
   (if (>= v maxi)
      (return (- v maxi))
   )
   (return v)
)
(defun angle_de (dx dy)
   (return (degree (atan2 dy dx)))
)
(defun nouvel_astéroïde (x y taille)
   (setq g (prend_rocher taille))
   (if (= g nil)
      (return ())
   )
   (setq direction (aléatoire 0 359))
   (setq v (p+ (* (- 4 taille) 0.6) (* (hasard) 1.2) (* vague 0.1)))
   (pose g x y)
   (return
      (list
         x
         y
         (* (cosinus direction) v)
         (* (sinus direction) v)
         taille
         (- (* (hasard) 4) 2)
         (- (* (hasard) 4) 2)
         g
      )
   )
)
(defun ajoute_astéroïde (liste x y taille)
   (setq a (nouvel_astéroïde x y taille))
   (if (!= a nil)
      (push liste a)
   )
)
(defun nouvelle_vague ()
   (loop a astéroïdes
      (rend_rocher a)
   )
   (setg astéroïdes (list))
   (loop i 
      (intervalle (minimum (p+ 3 vague) 10))
      (if (< (hasard) 0.5)
         (ajoute_astéroïde astéroïdes (aléatoire 0 (largeur)) 0 3)
         (ajoute_astéroïde astéroïdes 0 (aléatoire 0 (hauteur)) 3)
      )
   )
   (setg tempo 50)
)
(defun place_au_centre ()
   (setg vaisseau_x (/ (largeur) 2))
   (setg vaisseau_y (/ (hauteur) 2))
   (setg vit_x 0.0)
   (setg vit_y 0.0)
   (setg cap_x 0.0)
   (setg cap_y -1.0)
)
(defun commence ()
   (setg vies 3)
   (setg score 0)
   (setg vague 1)
   (loop t tirs
      (cache_objet . at t 5)
      (push réserve_tirs (at t 5))
   )
   (setg tirs (list))
   (place_au_centre)
   (setg invincible 120)
   (nouvelle_vague)
   (setg nouveau_record false)
   (setg état "jeu")
)
(defun pivote (angle)
   (setq c (cosinus angle))
   (setq s (sinus angle))
   (setq nx (- (* cap_x c) (* cap_y s)))
   (setq ny (p+ (* cap_x s) (* cap_y c)))
   (setg cap_x nx)
   (setg cap_y ny)
   (setg roulis (p+ roulis (* angle 3)))
)
(defun pousse (force)
   (setg vit_x (p+ vit_x (* cap_x force)))
   (setg vit_y (p+ vit_y (* cap_y force)))
   (setg flamme 4)
)
(defun feu ()
   (check (!= état "jeu")
      (commence)
      (return ())
   )
   (if (= (longueur réserve_tirs) 0)
      (return ())
   )
   (setq objet (popvalue réserve_tirs))
   (montre_objet objet)
   (push
      tirs
      (list
         (p+ vaisseau_x (* cap_x 16))
         (p+ vaisseau_y (* cap_y 16))
         (p+ (* cap_x 9) vit_x)
         (p+ (* cap_y 9) vit_y)
         45
         objet
      )
   )
   (joue_son son_tir)
)
(defun éclats (x y n)
   (loop i 
      (intervalle n)
      (if (= (longueur réserve_éclats) 0)
         (return ())
      )
      (setq objet (popvalue réserve_éclats))
      (montre_objet objet)
      (setq d (aléatoire 0 359))
      (setq v (p+ 1 (* (hasard) 3)))
      (push particules (list x y (* (cosinus d) v) (* (sinus d) v) (aléatoire 20 40) objet))
   )
)
(defun souris (x y)
   (setg souris_x x)
   (setg souris_y y)
   (setg mode_souris true)
)
(setq TACTILE (!= (at (appareil) 0) "ordinateur"))
(setq TIRER "Clic ou Espace")
(if TACTILE
   (setq TIRER "Touche 🔥 Feu")
)
(defun bouton_feu (clef texte)
   (feu)
)
(defun place_bouton_feu ()
   (check TACTILE
      (taille_texte 26)
      (bouton "feu" (- (largeur) 140) (- (hauteur) 65) "🔥 Feu" bouton_feu)
   )
)
(defun clic (x y)
   (if (andvalue TACTILE (= état "jeu"))
      (return ())
   )
   (feu)
)
(defun clavier (t)
   (setq t (minuscules t))
   (if (= t "espace")
      (feu)
      (if (in_it (list "gauche" "droite" "haut" "q" "d" "z") t)
         (setg mode_souris false)
      )
   )
)
(defun pilote_clavier ()
   (if (orvalue (touche_enfoncée "gauche") (touche_enfoncée "q"))
      (pivote -4)
   )
   (if (orvalue (touche_enfoncée "droite") (touche_enfoncée "d"))
      (pivote 4)
   )
   (if (orvalue (touche_enfoncée "haut") (touche_enfoncée "z"))
      (pousse 0.15)
   )
)
(defun pilote_souris ()
   (setq dx (- souris_x vaisseau_x))
   (setq dy (- souris_y vaisseau_y))
   (setq d (racine (p+ (* dx dx) (* dy dy))))
   (if (< d 1)
      (return ())
   )
   (setq écart (- (/ (* cap_x dy) d) (/ (* cap_y dx) d)))
   (setg roulis (p+ roulis (* écart 25)))
   (setg cap_x (/ dx d))
   (setg cap_y (/ dy d))
   (if (> d 160)
      (pousse 0.12)
   )
)
(defun recale ()
   (setq fx (/ (largeur) ancienne_largeur))
   (setq fy (/ (hauteur) ancienne_hauteur))
   (setg vaisseau_x (* vaisseau_x fx))
   (setg vaisseau_y (* vaisseau_y fy))
   (setg souris_x (* souris_x fx))
   (setg souris_y (* souris_y fy))
   (setg astéroïdes
      (mapcar
         (λ (a) 
            (list (* (at a 0) fx) (* (at a 1) fy) (at a 2) (at a 3) (at a 4) (at a 5) (at a 6) (at a 7))
         )
         astéroïdes
      )
   )
   (setg tirs
      (mapcar (λ (t) (list (* (at t 0) fx) (* (at t 1) fy) (at t 2) (at t 3) (at t 4) (at t 5))) tirs)
   )
   (setg particules
      (mapcar
         (λ (p) 
            (list (* (at p 0) fx) (* (at p 1) fy) (at p 2) (at p 3) (at p 4) (at p 5))
         )
         particules
      )
   )
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
   (déplace caméra_3d 0 (hauteur_caméra) 0.01)
   (place_bouton_feu)
)
(defun avance_vaisseau ()
   (setg vit_x (* vit_x 0.99))
   (setg vit_y (* vit_y 0.99))
   (setq v (racine (p+ (* vit_x vit_x) (* vit_y vit_y))))
   (check (> v 7)
      (setg vit_x (/ (* vit_x 7) v))
      (setg vit_y (/ (* vit_y 7) v))
   )
   (setg vaisseau_x (enveloppe (p+ vaisseau_x vit_x) (largeur)))
   (setg vaisseau_y (enveloppe (p+ vaisseau_y vit_y) (hauteur)))
)
(defun bouge (a)
   (setq x (enveloppe (p+ (at a 0) (at a 2)) (largeur)))
   (setq y (enveloppe (p+ (at a 1) (at a 3)) (hauteur)))
   (pose (at a 7) x y)
   (tourne (at a 7) (at a 5) (at a 6) 0)
   (return (list x y (at a 2) (at a 3) (at a 4) (at a 5) (at a 6) (at a 7)))
)
(defun avance_tirs ()
   (setq restants (list))
   (loop t tirs
      (ife (> (at t 4) 1)
         (block
            (setq x (enveloppe (p+ (at t 0) (at t 2)) (largeur)))
            (setq y (enveloppe (p+ (at t 1) (at t 3)) (hauteur)))
            (pose (at t 5) x y)
            (push restants (list x y (at t 2) (at t 3) (- (at t 4) 1) (at t 5)))
         )
         (cache_objet . at t 5)
         (push réserve_tirs (at t 5))
      )
   )
   (setg tirs restants)
)
(defun avance_particules ()
   (setq restants (list))
   (loop p particules
      (ife (> (at p 4) 1)
         (block
            (setq x (p+ (at p 0) (at p 2)))
            (setq y (p+ (at p 1) (at p 3)))
            (pose (at p 5) x y)
            (tourne (at p 5) 9 7 0)
            (push restants (list x y (* (at p 2) 0.97) (* (at p 3) 0.97) (- (at p 4) 1) (at p 5)))
         )
         (cache_objet . at p 5)
         (push réserve_éclats (at p 5))
      )
   )
   (setg particules restants)
)
(defun chocs ()
   (setq restants (list))
   (setq utilisés (list))
   (loop a astéroïdes
      (setq r (at rayons (at a 4)))
      (setq touché -1)
      (loop j 
         (intervalle (longueur tirs))
         (check (andvalue (< touché 0) (¬ (in_it utilisés j)))
            (setq dx (- (at tirs j 0) (at a 0)))
            (setq dy (- (at tirs j 1) (at a 1)))
            (if (< (p+ (* dx dx) (* dy dy)) (* r r))
               (setq touché j)
            )
         )
      )
      (if (>= touché 0)
         (block
            (push utilisés touché)
            (setg score (p+ score (at points (at a 4))))
            (éclats (at a 0) (at a 1) 8)
            (joue_son son_explosion)
            (rend_rocher a)
            (check (> (at a 4) 1)
               (ajoute_astéroïde restants (at a 0) (at a 1) (- (at a 4) 1))
               (ajoute_astéroïde restants (at a 0) (at a 1) (- (at a 4) 1))
            )
         )
         (push restants a)
      )
   )
   (setg astéroïdes restants)
   (setq gardés (list))
   (loop j 
      (intervalle (longueur tirs))
      (if (in_it utilisés j)
         (block (cache_objet . at tirs j 5) (push réserve_tirs (at tirs j 5)))
         (push gardés (at tirs j))
      )
   )
   (setg tirs gardés)
)
(defun perd_une_vie ()
   (-= vies 1)
   (éclats vaisseau_x vaisseau_y 16)
   (joue_son son_boum)
   (ife (<= vies 0)
      (block (setg état "perdu") (fin_de_partie))
      (place_au_centre)
      (setg invincible 150)
   )
)
(defun choc_vaisseau ()
   (if (> invincible 0)
      (return ())
   )
   (loop a astéroïdes
      (setq dx (- (at a 0) vaisseau_x))
      (setq dy (- (at a 1) vaisseau_y))
      (setq r (+ (at rayons (at a 4)) 10))
      (check (< (p+ (* dx dx) (* dy dy)) (* r r))
         (perd_une_vie)
         (break)
      )
   )
)
(defun battement_de_cœur ()
   (-= attente_battement 1)
   (if (> attente_battement 0)
      (return ())
   )
   (joue_son (at sons_battement (_% note 2)))
   (+= note 1)
   (setg tempo (maximum 12 (- tempo 1)))
   (setg attente_battement tempo)
)
(defun montre_vaisseau ()
   (check (orvalue (!= état "jeu") (andvalue (> invincible 0) (= (_% (_/ invincible 6) 2) 0)))
      (cache_objet vaisseau)
      (return ())
   )
   (montre_objet vaisseau)
   (pose vaisseau vaisseau_x vaisseau_y)
   (oriente_3d vaisseau 0 (sign (angle_de cap_x cap_y)) 0)
   (setg roulis (maximum -40 (minimum 40 (* roulis 0.85))))
   (oriente_3d corps roulis 0 0)
   (if (andvalue (> flamme 0) (= flamme_montrée false))
      (block (montre_objet flamme_3d) (setg flamme_montrée true))
      (check (andvalue (= flamme 0) flamme_montrée)
         (cache_objet flamme_3d)
         (setg flamme_montrée false)
      )
   )
)
(defun texte_centré (y t)
   (texte (/ (- (largeur) (largeur_texte t)) 2) y t)
)
(defun écrit_textes ()
   (efface)
   (couleur "blanc")
   (taille_texte 18)
   (texte 10 10 (+ "Score : " (_texte score)))
   (texte_centré 10 (+ "Vague " (_texte vague)))
   (texte (- (largeur) 100) 10 (+ "Vies : " (_texte vies)))
   (if (= état "attente")
      (block
         (taille_texte 48)
         (texte_centré (- (/ (hauteur) 2) 80) "ASTÉROÏDES 3D")
         (taille_texte 22)
         (texte_centré (/ (hauteur) 2) (+ (_texte TIRER) " : commencer"))
         (if (> record 0)
            (texte_centré (+ (/ (hauteur) 2) 50) (+ "Meilleur score : " (_texte record)))
         )
      )
      (check (= état "perdu")
         (taille_texte 30)
         (couleur "rouge clair")
         (texte_centré (- (/ (hauteur) 2) 60) "Vaisseau détruit !")
         (couleur "blanc")
         (taille_texte 22)
         (texte_centré (/ (hauteur) 2) (+ "Score : " (_texte score) ", vague " (_texte vague)))
         (texte_centré (+ (/ (hauteur) 2) 40) (+ (_texte TIRER) " : rejouer"))
         (if nouveau_record
            (block (couleur "jaune") (texte_centré (+ (/ (hauteur) 2) 90) "Nouveau record !"))
            (texte_centré (+ (/ (hauteur) 2) 90) (+ "Meilleur score : " (_texte record)))
         )
      )
   )
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (check (= état "jeu")
      (if mode_souris
         (pilote_souris)
         (pilote_clavier)
      )
      (avance_vaisseau)
      (avance_tirs)
      (chocs)
      (choc_vaisseau)
      (battement_de_cœur)
      (check (= (longueur astéroïdes) 0)
         (+= vague 1)
         (nouvelle_vague)
      )
      (if (> invincible 0)
         (-= invincible 1)
      )
      (if (> flamme 0)
         (-= flamme 1)
      )
   )
   (setg astéroïdes (mapcar (λ (a) (bouge a)) astéroïdes))
   (avance_particules)
   (montre_vaisseau)
   (écrit_textes)
)
(cache_tortue)
(println
   "Textures : l'astéroïde Bennu (NASA/Goddard/University of Arizona, domaine public), la Lune (Solar System Scope, CC BY 4.0)"
)
(nouvelle_vague)
(quand_souris souris)
(quand_glisse souris)
(place_bouton_feu)
(quand_clic clic)
(quand_touche clavier)
(animer image 16)
