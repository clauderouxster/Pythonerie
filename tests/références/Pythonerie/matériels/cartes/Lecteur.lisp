(import "outils/cartes" ())
(import "biblios" ())
(setq BANDE 44)
(setq piles (piles_disponibles))
(if (= (longueur piles) 0)
   (throw
      "Il n'y a pas encore de pile dans le répertoire données : lance d'abord l'Éditeur, dessine tes cartes et clique sur « Enregistrer »."
   )
)
(setq pile (lit_pile (at piles 0 1)))
(prépare_sons pile)
(setq n 0)
(setq boutons_posés (list))
(setq attente 0)
(defun dessine ()
   (couleur "gris foncé")
   (rectangle_plein 0 0 (largeur) BANDE)
   (couleur "blanc")
   (taille_texte 15)
   (police POLICE)
   (texte 12 13 "Pile :")
   (setq total (longueur (at pile "cartes")))
   (texte (- (largeur) 120) 13 (+ "Carte " (_texte (+ n 1)) " / " (_texte total)))
   (dessine_carte pile n 0 BANDE false)
)
(defun montre (k)
   (setg n k)
   (arrête)
   (animer redessine 100)
   (loop clef boutons_posés
      (retire_objet clef)
   )
   (setg boutons_posés (list))
   (dessine)
   (joue (son_de_la (at pile "cartes" n)))
   (setq éléments (at pile "cartes" n "éléments"))
   (loop i 
      (intervalle (longueur éléments))
      (setq e (at éléments i))
      (check (= (at e "genre") "bouton")
         (taille_texte (lettres_bouton e))
         (bouton (+ "b" (_texte i)) (at e "x") (p+ (at e "y") BANDE) (at e "texte") bouton_cliqué)
         (push boutons_posés (+ "b" (_texte i)))
      )
   )
   (setg attente 5)
   (lance_script (at pile "cartes" n))
)
(defun lance_script (d)
   (setq k (numéro_script d))
   (check (> k 0)
      (affiche_console)
      (extensions k)
   )
)
(defun va_vers_carte (nom)
   (montre (carte_visée pile n nom))
)
(defun bouton_cliqué (clef texte)
   (setq e (at pile "cartes" n "éléments" (entier (extract clef 1))))
   (joue (son_de_la e))
   (lance_script e)
   (setq autre (pile_visée (at e "action")))
   (if (= (at e "action") "aucune")
      (return 0)
   )
   (if (= autre "")
      (montre (carte_visée pile n (at e "action")))
      (if (in_it (liste_données) autre)
         (block (ouvre_pile autre) (change_objet "piles" (at pile "titre")))
         (println
            (+
               "— Ce bouton mène à la pile « "
               (_texte autre)
               " », qui n'est pas dans le répertoire données."
            )
         )
      )
   )
)
(defun pile_choisie (clef titre)
   (ouvre_pile (fichier_de piles titre))
)
(defun ouvre_pile (nom)
   (setg pile (lit_pile nom))
   (prépare_sons pile)
   (if (orvalue (!= (largeur) (at pile "largeur")) (!= (hauteur) (p+ (at pile "hauteur") BANDE)))
      (canevas (at pile "largeur") (p+ (at pile "hauteur") BANDE))
   )
   (montre 0)
)
(defun touche (t)
   (if (= t "droite")
      (montre (carte_visée pile n "suivante"))
      (if (= t "gauche")
         (montre (carte_visée pile n "précédente"))
      )
   )
)
(defun redessine ()
   (check (> attente 0)
      (setg attente (- attente 1))
      (dessine)
   )
)
(canevas (at pile "largeur") (p+ (at pile "hauteur") BANDE))
(cache_tortue)
(taille_texte 13)
(liste_déroulante "piles" 64 9 (mapcar (λ (p) (at p 0)) piles) pile_choisie)
(quand_touche touche)
(montre 0)
