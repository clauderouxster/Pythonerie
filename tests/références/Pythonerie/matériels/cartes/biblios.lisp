(defun exemple_boucles ()
   (loop i 
      (irange 1 6 1)
      (println (_texte i) "fois 7 =" (_texte (* i 7)))
   )
   (setq n 1)
   (while (< n 100) (setq n (* n 2)))
   (println "n vaut" (_texte n))
)
