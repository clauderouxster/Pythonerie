(defun exemple_listes ()
   (setq fruits (list "pomme" "poire"))
   (push fruits "kiwi")
   (println (_texte (at fruits 0)) (_texte (longueur fruits)))
   (loop f fruits
      (println "J'aime :" (_texte f))
   )
)
