(defun voyage_vers_mars ()
   (setq jours 210)
   (println (+ "Pour aller sur Mars, il faut environ " (_texte jours) " jours,"))
   (println (+ "soit à peu près " (_texte (_/ jours 30)) " mois de voyage."))
)
