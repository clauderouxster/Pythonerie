(setq LARGEUR_CARTE 720)
(setq HAUTEUR_CARTE 540)
(setq ACTIONS (list "suivante" "précédente" "première" "dernière" "aucune"))
(setq POLICE "Inter, sans-serif")
(defun nouvelle_carte (nom)
   (return (dictionary "nom" nom "fond" "blanc" "éléments" (list)))
)
(defun nouvelle_pile ()
   (return
      (dictionary
         "titre"
         "Ma pile"
         "largeur"
         LARGEUR_CARTE
         "hauteur"
         HAUTEUR_CARTE
         "cartes"
         (list (nouvelle_carte "Carte 1"))
      )
   )
)
(defun lit_pile (nom)
   (if (¬ (in_it (liste_données) nom))
      (return (dictionary))
   )
   (return (json_parse (charge_données nom)))
)
(defun piles_disponibles ()
   (setq piles (list))
   (loop nom 
      (liste_données)
      (check (endwith nom ".json")
         (setq d (dictionary))
         (maybe (setq d (json_parse (charge_données nom))) (setq d (dictionary)))
         (check (andvalue (= (typede d) "dictionnaire") (in_it d "cartes"))
            (setq titre nom)
            (if (in_it d "titre")
               (setq titre (at d "titre"))
            )
            (push piles (list titre nom))
         )
      )
   )
   (return piles)
)
(defun fichier_de (piles titre)
   (loop p piles
      (if (= (at p 0) titre)
         (return (at p 1))
      )
   )
   (return (at piles 0 1))
)
(defun carte_visée (pile n action)
   (setq total (longueur (at pile "cartes")))
   (if (= action "suivante")
      (return (_% (+ n 1) total))
   )
   (if (= action "précédente")
      (return (_% (p+ (- n 1) total) total))
   )
   (if (= action "première")
      (return 0)
   )
   (if (= action "dernière")
      (return (- total 1))
   )
   (loop i 
      (intervalle total)
      (if (= (at pile "cartes" i "nom") action)
         (return i)
      )
   )
   (return n)
)
(defun numéro_script (d)
   (if (in_it d "script")
      (return (at d "script"))
   )
   (return 0)
)
(defun pile_visée (action)
   (if (startwith action "pile : ")
      (return (extract action 7))
   )
   (return "")
)
(setq images_chargées (dictionary))
(defun image_de (nom)
   (if (¬ (in_it images_chargées nom))
      (set@ images_chargées nom (charge_image nom))
   )
   (return (at images_chargées nom))
)
(setq sons_chargés (dictionary))
(defun son_de (nom)
   (if (¬ (in_it sons_chargés nom))
      (set@ sons_chargés nom (charge_son nom))
   )
   (return (at sons_chargés nom))
)
(defun joue (nom)
   (if (!= nom "")
      (joue_son (son_de nom))
   )
)
(defun son_de_la (d)
   (if (in_it d "son")
      (return (at d "son"))
   )
   (return "")
)
(defun prépare_sons (pile)
   (loop c 
      (at pile "cartes")
      (if (!= (son_de_la c) "")
         (son_de (son_de_la c))
      )
      (loop e 
         (at c "éléments")
         (if (!= (son_de_la e) "")
            (son_de (son_de_la e))
         )
      )
   )
)
(defun lignes_de (e)
   (setq t (remplace (remplace (at e "texte") "\n\n" "\n \n") "\n\n" "\n \n"))
   (return (découpe t "\n"))
)
(defun lettres_bouton (e)
   (return (arrondi (* (at e "taille") 0.75)))
)
(defun taille_bouton (e)
   (setq t (lettres_bouton e))
   (return (list (p+ (* (* (longueur (at e "texte")) t) 0.6) (* 1.6 t)) (* 1.8 t)))
)
(defun boîte (e)
   (setq x (at e "x"))
   (setq y (at e "y"))
   (setq t (at e "taille"))
   (setq g (at e "genre"))
   (check (= g "texte")
      (setq plus_longue 1)
      (loop ligne 
         (lignes_de e)
         (setq plus_longue (maximum plus_longue (longueur ligne)))
      )
      (return (list x y (* (* plus_longue t) 0.55) (* (* (longueur (lignes_de e)) t) 1.25)))
   )
   (check (= g "rectangle")
      (setq lh (taille_rectangle e))
      (return (list x y (at lh 0) (at lh 1)))
   )
   (if (= g "disque")
      (return (list (- x t) (- y t) (* 2 t) (* 2 t)))
   )
   (if (= g "image")
      (return (list x y (* 4 t) (* 4 t)))
   )
   (setq lh (taille_bouton e))
   (return (list x y (at lh 0) (at lh 1)))
)
(defun taille_rectangle (e)
   (if (in_it e "l")
      (return (list (at e "l") (at e "h")))
   )
   (return (list (* 3 (at e "taille")) (* 2 (at e "taille"))))
)
(defun dans_la_boîte (b x y)
   (return
      (andvalue
         (andvalue (andvalue (>= x (at b 0)) (<= x (p+ (at b 0) (at b 2)))) (>= y (at b 1)))
         (<= y (p+ (at b 1) (at b 3)))
      )
   )
)
(defun dessine_élément (e dx dy)
   (setq x (p+ dx (at e "x")))
   (setq y (p+ dy (at e "y")))
   (setq t (at e "taille"))
   (setq g (at e "genre"))
   (couleur (at e "couleur"))
   (if (= g "texte")
      (block
         (taille_texte t)
         (if (in_it e "police")
            (police (at e "police"))
            (police POLICE)
         )
         (setq k 0)
         (loop ligne 
            (lignes_de e)
            (texte x (p+ y (* (* k t) 1.25)) ligne)
            (+= k 1)
         )
      )
      (if (= g "rectangle")
         (block (setq lh (taille_rectangle e)) (rectangle_plein x y (at lh 0) (at lh 1)))
         (if (= g "disque")
            (disque x y t)
            (ife (= g "image")
               (place_image (image_de (at e "image")) x y (* 4 t))
               (setq lh (taille_bouton e))
               (couleur "gris clair")
               (rectangle_plein x y (at lh 0) (at lh 1))
               (épaisseur 1)
               (couleur "gris")
               (rectangle x y (at lh 0) (at lh 1))
               (couleur "noir")
               (police POLICE)
               (taille_texte (lettres_bouton e))
               (texte (p+ x (* 0.8 (lettres_bouton e))) (p+ y (* 0.3 (lettres_bouton e))) (at e "texte"))
            )
         )
      )
   )
)
(defun dessine_carte (pile n dx dy avec_boutons)
   (setq carte (at pile "cartes" n))
   (couleur (at carte "fond"))
   (rectangle_plein dx dy (at pile "largeur") (at pile "hauteur"))
   (loop e 
      (at carte "éléments")
      (if (orvalue (!= (at e "genre") "bouton") avec_boutons)
         (dessine_élément e dx dy)
      )
   )
   (police POLICE)
)
