(defun scripts_de_biblios ()
   (setq texte "")
   (maybe
      (setq texte (charge_programme "biblios"))
      (return (dictionary "erreur" "il n'y a pas de programme biblios dans le projet" "liste" (list)))
   )
   (setq erreur (vérifie_code texte))
   (if (!= erreur "")
      (return (dictionary "erreur" erreur "liste" (list)))
   )
   (setq liste (list))
   (setq numéro 0)
   (setq dans_extensions false)
   (loop ligne 
      (découpe texte "\n")
      (setq l (nettoie ligne))
      (if (orvalue (startwith ligne "fonction ") (startwith ligne "def "))
         (setq dans_extensions
            (orvalue (startwith l "fonction extensions(") (startwith l "def extensions("))
         )
         (if (andvalue (andvalue dans_extensions (startwith l "cas ")) (endwith l ":"))
            (block
               (setq numéro 0)
               (maybe (setq numéro (entier (nettoie (extract l 4 (- (longueur l) 1))))) (setq numéro 0))
            )
            (check (andvalue (andvalue (andvalue dans_extensions (> numéro 0)) (!= l "")) (¬ (startwith l "#")))
               (push liste (list numéro l))
               (setq numéro 0)
            )
         )
      )
   )
   (return (dictionary "erreur" "" "liste" liste))
)
