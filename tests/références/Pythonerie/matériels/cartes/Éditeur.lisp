      (rectangle (- (p+ DX (at b 0)) 4) (- (p+ DY (at b 1)) 4) (+ (at b 2) 8) (+ (at b 3) 8))
   )
   (couleur "noir")
   (taille_texte 13)
   (police POLICE)
   (setq cible (cible_du_script))
   (setq k (numéro_script cible))
   (setq nom_carte (at (carte) "nom"))
   (setq quoi (+ "de la carte « " (_texte nom_carte) " » (à son ouverture)"))
   (check (andvalue (>= choisi 0) (= (at (élément_choisi) "genre") "bouton"))
      (setq nom_bouton (at cible "texte"))
      (setq quoi (+ "du bouton « " (_texte nom_bouton) " » (au clic)"))
   )
   (texte DX (p+ DY (at pile "hauteur") 8) (+ "Script " (_texte quoi) " :"))
)
(defun redessine ()
   (check (> attente 0)
      (setg attente (- attente 1))
      (dessine)
   )
)
(defun nouvel_élément (genre x y)
   (setq e
      (dictionary
         "genre"
         genre
         "x"
         x
         "y"
         y
         "couleur"
         (at réglages "couleur")
         "taille"
         (at réglages "taille")
      )
   )
   (setq t (at réglages "texte"))
   (if (= genre "texte")
      (block (if (= t "") (setq t "Texte")) (set@ e "texte" t))
      (if (= genre "bouton")
         (block
            (if (= t "")
               (setq t "Bouton")
            )
            (set@ e "texte" t)
            (set@ e "action" (at réglages "action"))
            (set@ e "son" (at réglages "son"))
         )
         (if (= genre "image")
            (set@ e "image" (at réglages "image"))
         )
      )
   )
   (return e)
)
(defun montre_réglages (e)
   (loop clé 
      (list "couleur" "taille" "texte" "image" "action" "son")
      (if (in_it e clé)
         (set@ réglages clé (at e clé))
      )
      (setq valeur (at réglages clé))
      (if (andvalue (= clé "son") (= valeur ""))
         (setq valeur AUCUN)
      )
      (change_objet clé valeur)
   )
)
(defun réglage_choisi (clé valeur)
   (check (= clé "son")
      (if (= valeur AUCUN)
         (setq valeur "")
      )
      (joue valeur)
   )
   (set@ réglages clé valeur)
   (check (>= choisi 0)
      (setq e (élément_choisi))
      (check (andvalue (= clé "taille") (in_it e "l"))
         (set@ e "l" (/ (* (at e "l") valeur) (at e "taille")))
         (set@ e "h" (/ (* (at e "h") valeur) (at e "taille")))
      )
      (if (in_it e clé)
         (set@ e clé valeur)
      )
   )
   (dessine)
)
(defun clic (x y)
   (setq cx (- x DX))
   (setq cy (- y DY))
   (if (orvalue
         (orvalue (orvalue (< cx 0) (< cy 0)) (> cx (at pile "largeur")))
         (> cy (at pile "hauteur"))
      )
      (return 0)
   )
   (ife (= outil "choisir")
      (block
         (setg choisi -1)
         (setq éléments (at (carte) "éléments"))
         (loop i 
            (intervalle (- (longueur éléments) 1) -1 -1)
            (check (dans_la_boîte (boîte (at éléments i)) cx cy)
               (setg choisi i)
               (break)
            )
         )
         (check (>= choisi 0)
            (setq e (élément_choisi))
            (setg prise (list (- cx (at e "x")) (- cy (at e "y"))))
            (montre_réglages e)
         )
      )
      (push (at (carte) "éléments") (nouvel_élément outil cx cy))
      (setg choisi (- (longueur (at (carte) "éléments")) 1))
      (setg prise (list 0 0))
      (setg outil "choisir")
      (change_objet "outil_choisir" true)
   )
   (montre_script)
   (dessine)
)
(defun cible_du_script ()
   (if (andvalue (>= choisi 0) (= (at (élément_choisi) "genre") "bouton"))
      (return (élément_choisi))
   )
   (return (carte))
)
(defun montre_script ()
   (setq k (numéro_script (cible_du_script)))
   (setq valeur AUCUN)
   (loop choix choix_scripts
      (if (startwith choix (+ (_texte k) " : "))
         (setq valeur choix)
      )
   )
   (change_objet "script" valeur)
)
(defun script_choisi (clef valeur)
   (setq k 0)
   (if (!= valeur AUCUN)
      (setq k (entier (at (découpe valeur " : ") 0)))
   )
   (setq cible (cible_du_script))
   (set@ cible "script" k)
   (dessine)
)
(defun glisse (x y)
   (check (andvalue (= outil "choisir") (>= choisi 0))
      (setq e (élément_choisi))
      (set@ e "x" (- (- x DX) (at prise 0)))
      (set@ e "y" (- (- y DY) (at prise 1)))
      (dessine)
   )
)
(defun outil_choisi (groupe clef)
   (setg outil (extract clef 6))
)
(defun actions_possibles ()
   (setq noms
      (p+
         ACTIONS
         (mapcar (λ (c) (at c "nom")) (at pile "cartes"))
         (mapcar (λ (p) (+ "pile : " (_texte (at p 1)))) (filtercar (λ (p) (!= (at p 1) fichier)) piles))
      )
   )
   (taille_texte 12)
   (liste_déroulante "action" 12 594 noms réglage_choisi)
   (change_objet "action" (at réglages "action"))
)
(defun ouvre_carte (k)
   (setg n k)
   (setg choisi -1)
   (change_objet "nom" (at (carte) "nom"))
   (change_objet "fond" (at (carte) "fond"))
   (setq son (son_de_la (carte)))
   (if (= son "")
      (setq son AUCUN)
   )
   (change_objet "son_carte" son)
   (actions_possibles)
   (montre_script)
   (setg attente 5)
   (dessine)
)
(defun titre_changé (clef valeur)
   (set@ pile "titre" valeur)
)
(defun nom_changé (clef valeur)
   (setq c (carte))
   (setq ancien (at c "nom"))
   (set@ c "nom" valeur)
   (loop autre 
      (at pile "cartes")
      (loop e 
         (at autre "éléments")
         (if (andvalue (= (at e "genre") "bouton") (= (at e "action") ancien))
            (set@ e "action" valeur)
         )
      )
   )
   (if (= (at réglages "action") ancien)
      (set@ réglages "action" valeur)
   )
   (actions_possibles)
   (dessine)
)
(defun son_de_carte_choisi (clef valeur)
   (if (= valeur AUCUN)
      (setq valeur "")
   )
   (joue valeur)
   (setq c (carte))
   (set@ c "son" valeur)
)
(defun fond_choisi (clef valeur)
   (setq c (carte))
   (set@ c "fond" valeur)
   (dessine)
)
(defun prend_les_champs ()
   (setq t (valeur_objet "titre"))
   (if (!= t (at pile "titre"))
      (titre_changé "titre" t)
   )
   (setq v (valeur_objet "nom"))
   (if (!= v (at (carte) "nom"))
      (nom_changé "nom" v)
   )
)
(defun commande (clef texte)
   (prend_les_champs)
   (setq total (longueur (at pile "cartes")))
   (if (= clef "avant")
      (ouvre_carte (_% (p+ (- n 1) total) total))
      (if (= clef "après")
         (ouvre_carte (_% (+ n 1) total))
         (if (= clef "ajoute")
            (block
               (push (at pile "cartes") (nouvelle_carte (+ "Carte " (_texte (+ total 1)))))
               (ouvre_carte total)
            )
            (if (= clef "supprime")
               (check (> total 1)
                  (set@
                     pile
                     "cartes"
                     (mapcar (λ (i) (at pile "cartes" i)) (filtercar (λ (i) (!= i n)) (intervalle total)))
                  )
                  (ouvre_carte (minimum n (- total 2)))
               )
               (if (= clef "efface")
                  (check (>= choisi 0)
                     (setq c (carte))
                     (set@
                        c
                        "éléments"
                        (mapcar
                           (λ (i) 
                              (at c "éléments" i)
                           )
                           (filtercar (λ (i) (!= i choisi)) (intervalle (longueur (at c "éléments"))))
                        )
                     )
                     (setg choisi -1)
                     (dessine)
                  )
                  (if (= clef "enregistre")
                     (block
                        (sauve_données fichier (json pile))
                        (menu_des_piles)
                        (println
                           (+
                              "— Pile enregistrée dans données/"
                              (_texte fichier)
                              " ("
                              (_texte total)
                              " cartes) : lance le Lecteur pour la parcourir."
                           )
                        )
                     )
                     (if (= clef "nouvelle")
                        (demande "Le nom du fichier de la nouvelle pile (par exemple ma_pile) :" nouvelle_pile_nommée)
                     )
                  )
               )
            )
         )
      )
   )
)
(defun nouvelle_pile_nommée (nom)
   (setq nom (nettoie nom))
   (if (= nom "")
      (return ())
   )
   (setq titre nom)
   (if (endwith nom ".json")
      (setq titre (extract nom 0 (- (longueur nom) 5)))
      (setq nom (+ nom ".json"))
   )
   (setg fichier nom)
   (setg pile (nouvelle_pile))
   (set@ pile "titre" (remplace titre "_" " "))
   (sauve_données fichier (json pile))
   (change_objet "titre" (at pile "titre"))
   (menu_des_piles)
   (ouvre_carte 0)
)
(defun menu_des_piles ()
   (setg piles (piles_disponibles))
   (taille_texte 12)
   (liste_déroulante "piles" 600 12 (mapcar (λ (p) (at p 0)) piles) pile_choisie)
   (change_objet "piles" (at pile "titre"))
   (actions_possibles)
)
(defun pile_choisie (clef titre)
   (setg fichier (fichier_de piles titre))
   (setg pile (lit_pile fichier))
   (change_objet "titre" (at pile "titre"))
   (ouvre_carte 0)
)
