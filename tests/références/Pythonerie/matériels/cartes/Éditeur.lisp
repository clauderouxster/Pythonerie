(setq choix_scripts
   (p+
      (list AUCUN)
      (mapcar (λ (s) (+ (_texte (at s 0)) " : " (_texte (at s 1)))) (at biblios "liste"))
   )
)
(defun carte ()
   (return (at pile "cartes" n))
)
(defun élément_choisi ()
   (return (at (carte) "éléments" choisi))
)
