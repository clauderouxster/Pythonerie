(setq LIGNES 14)
(setq HAUT 100)
(setq HAUTEUR_LIGNE 34)
(setq X_TABLEAU 390)
(setq X_IDENTIFIANT (+ X_TABLEAU 44))
(setq X_NOM (+ X_TABLEAU 224))
(setq élèves (list))
(setq page 0)
(setq message "Chargement de la liste enregistrée…")
(defun nombre_de_pages ()
   (return (+ (_/ (longueur élèves) LIGNES) 1))
)
(defun lit_les_cases ()
   (loop i 
      (irange 0 LIGNES 1)
      (setq k (p+ (* page LIGNES) i))
      (setq identifiant (nettoie (valeur_objet (+ "id" (_texte i)))))
      (setq nom (nettoie (valeur_objet (+ "nom" (_texte i)))))
      (if (< k (longueur élèves))
         (set@ élèves k (list identifiant nom))
         (check (orvalue (!= identifiant "") (!= nom ""))
            (while (< (longueur élèves) k) (push élèves (list "" "")))
            (push élèves (list identifiant nom))
         )
      )
   )
)
(defun montre_les_cases ()
   (loop i 
      (irange 0 LIGNES 1)
      (setq k (p+ (* page LIGNES) i))
      (ife (< k (longueur élèves))
         (block
            (change_objet (+ "id" (_texte i)) (at élèves k 0))
            (change_objet (+ "nom" (_texte i)) (at élèves k 1))
         )
         (change_objet (+ "id" (_texte i)) "")
         (change_objet (+ "nom" (_texte i)) "")
      )
   )
)
(defun élèves_remplis ()
   (return (filtercar (λ (e) (orvalue (!= (at e 0) "") (!= (at e 1) ""))) élèves))
)
(defun clef_de (texte)
   (return (minuscules (nettoie texte)))
)
(defun quantité (n mot)
   (if (> n 1)
      (return (+ (_texte n) " " (_texte mot) "s"))
   )
   (return (+ (_texte n) " " (_texte mot)))
)
(defun a_un_chiffre (texte)
   (loop i 
      (irange 0 10 1)
      (if (in_it texte (chaîne i))
         (return true)
      )
   )
   (return false)
)
(defun découpe_ligne (ligne)
   (loop sép 
      (list "\t" ";")
      (check (in_it ligne sép)
         (setq morceaux
            (mapcar (λ (m) (nettoie m)) (filtercar (λ (m) (!= (nettoie m) "")) (découpe ligne sép)))
         )
         (if (= (longueur morceaux) 0)
            (return (list "" ""))
         )
         (setq identifiant (at morceaux 0))
         (setq nom (join (extract morceaux 1) " "))
         (if (andvalue (a_un_chiffre nom) (¬ (a_un_chiffre identifiant)))
            (setq (identifiant nom) (list nom identifiant))
         )
         (return (list identifiant nom))
      )
   )
   (return (list "" (nettoie ligne)))
)
(defun ajoute_au_tableau ()
   (lit_les_cases)
   (setq texte (valeur_objet "liste"))
   (setq déjà (dictionary))
   (loop e 
      (élèves_remplis)
      (if (!= (at e 0) "")
         (set@ déjà (clef_de (at e 0)) (at e 1))
         (set@ déjà (+ "nom:" (clef_de (at e 1))) (at e 1))
      )
   )
   (setq ajoutés 0)
   (setq doublons (list))
   (loop ligne 
      (découpe texte "\n")
      (setq e (découpe_ligne ligne))
      (if (andvalue (= (at e 0) "") (= (at e 1) ""))
         (continue)
      )
      (setq clef (clef_de (at e 0)))
      (if (= (at e 0) "")
         (setq clef (+ "nom:" (clef_de (at e 1))))
      )
      (check (in_it déjà clef)
         (if (!= (at e 0) "")
            (push doublons (at e 0))
            (push doublons (at e 1))
         )
         (continue)
      )
      (set@ déjà clef (at e 1))
      (push élèves e)
      (+= ajoutés 1)
   )
   (check (andvalue (= ajoutés 0) (= (longueur doublons) 0))
      (setg message "La zone de gauche est vide : colles-y d'abord ta liste.")
      (return ())
   )
   (setg élèves (élèves_remplis))
   (setg page (_/ (- (longueur élèves) 1) LIGNES))
   (if (< page 0)
      (setg page 0)
   )
   (montre_les_cases)
   (change_objet "liste" "")
   (setq ajout (+ (quantité ajoutés "élève") " ajouté"))
   (if (> ajoutés 1)
      (setq ajout (+ ajout "s"))
   )
   (setg message (p+ (+ ajout ", ") (quantité (longueur élèves) "élève") " dans le tableau."))
   (check (> (longueur doublons) 0)
      (setg message (p+ (+ message " Déjà dans le tableau : ") (join (extract doublons 0 4) ", ")))
      (if (> (longueur doublons) 4)
         (setg message (+ message (+ "… (" (_texte (longueur doublons)) " en tout)")))
      )
      (setg message (+ message "."))
   )
   (setq sans (longueur (filtercar (λ (e) (= (at e 0) "")) élèves)))
   (if (> sans 0)
      (setg message (p+ (+ message " Il manque ") (quantité sans "identifiant") "."))
   )
)
(defun vide_le_tableau ()
   (setg élèves (list))
   (setg page 0)
   (montre_les_cases)
   (setg message "Tableau vidé. Clique sur Enregistrer pour vider aussi la liste du serveur.")
)
(defun identifiants_en_double (remplis)
   (setq vus (dictionary))
   (setq doubles (list))
   (loop e remplis
      (setq clef (clef_de (at e 0)))
      (if (andvalue (in_it vus clef) (¬ (in_it doubles (at e 0))))
         (push doubles (at e 0))
      )
      (set@ vus clef true)
   )
   (return doubles)
)
(defun enregistre ()
   (lit_les_cases)
   (setq remplis (élèves_remplis))
   (setq manquants (mapcar (λ (e) (at e 1)) (filtercar (λ (e) (= (at e 0) "")) remplis)))
   (check (> (longueur manquants) 0)
      (setg message (+ "Il manque l'identifiant de : " (join (extract manquants 0 5) ", ")))
      (if (> (longueur manquants) 5)
         (setg message (+ message "…"))
      )
      (return ())
   )
   (setq doubles (identifiants_en_double remplis))
   (check (> (longueur doubles) 0)
      (setg message
         (+ "Ces identifiants sont en double dans le tableau : " (join (extract doubles 0 5) ", "))
      )
      (return ())
   )
   (setq liste (mapcar (λ (e) (dictionary "identifiant" (at e 0) "nom" (at e 1))) remplis))
   (setg message "Enregistrement en cours… (une erreur s'écrit dans la console)")
   (sauve_élèves liste enregistré)
)
(defun enregistré (n)
   (setg message
      (+
         (_texte (entier n))
         " élèves enregistrés sur le serveur. Pour le mode classe : python3 serveur.py --professeur ton_identifiant"
      )
   )
   (dessine)
)
(defun chargée (liste)
   (setg élèves (mapcar (λ (e) (list (at e "identifiant") (at e "nom"))) liste))
   (setg page 0)
   (montre_les_cases)
   (if (= (longueur élèves) 0)
      (setg message "Pas encore de liste : colle-la à gauche, ou tape-la dans le tableau.")
      (setg message (+ "La liste enregistrée : " (_texte (longueur élèves)) " élèves."))
   )
   (dessine)
)
(defun change_de_page (sens)
   (lit_les_cases)
   (setq nouvelle (p+ page sens))
   (check (andvalue (>= nouvelle 0) (< nouvelle (nombre_de_pages)))
      (setg page nouvelle)
      (montre_les_cases)
   )
)
(defun commande (clef texte)
   (if (= clef "ajouter")
      (ajoute_au_tableau)
      (if (= clef "vider")
         (vide_le_tableau)
         (if (= clef "enregistrer")
            (enregistre)
            (if (= clef "recharger")
               (block
                  (setg message "Chargement de la liste enregistrée…")
                  (lit_dans_serveur "élèves.json" chargée)
               )
               (if (= clef "précédente")
                  (change_de_page -1)
                  (if (= clef "suivante")
                     (change_de_page 1)
                  )
               )
            )
         )
      )
   )
   (dessine)
)
(defun case_changée (clef valeur)
   (lit_les_cases)
   (dessine)
)
(defun touche (t)
   (setq clef (saisie_active))
   (if (orvalue (= clef "") (= clef "liste"))
      (return ())
   )
   (setq colonne "id")
   (if (startwith clef "nom")
      (setq colonne "nom")
   )
   (setq i (entier (extract clef (longueur colonne))))
   (if (andvalue (orvalue (= t "bas") (= t "entrée")) (< i (- LIGNES 1)))
      (active_saisie (+ (_texte colonne) (_texte (+ i 1))))
      (if (andvalue (= t "haut") (> i 0))
         (active_saisie (+ (_texte colonne) (_texte (- i 1))))
      )
   )
)
(defun dessine ()
   (fond "blanc")
   (couleur "bleu marine")
   (taille_texte 26)
   (texte 20 18 "Ma classe : les élèves autorisés")
   (taille_texte 15)
   (couleur "gris foncé")
   (texte 20 66 "Colle ta liste ici (une ligne par élève) :")
   (couleur "gris clair")
   (rectangle_plein X_TABLEAU (- HAUT 34) 560 28)
   (couleur "noir")
   (texte (+ X_TABLEAU 6) (- HAUT 28) "N°")
   (texte (+ X_IDENTIFIANT 4) (- HAUT 28) "Identifiant")
   (texte (+ X_NOM 4) (- HAUT 28) "Nom")
   (loop i 
      (irange 0 LIGNES 1)
      (texte (+ X_TABLEAU 6) (p+ HAUT (* i HAUTEUR_LIGNE) 7) (chaîne (p+ (* page LIGNES) i 1)))
   )
   (couleur "gris foncé")
   (setq y (p+ HAUT (* LIGNES HAUTEUR_LIGNE) 14))
   (
      texte
      (+ X_TABLEAU 120)
      (+ y 6)
      (+
         "Page "
         (_texte (+ page 1))
         " / "
         (_texte (nombre_de_pages))
         " — "
         (_texte (longueur (élèves_remplis)))
         " élèves"
      )
   )
   (couleur "bleu foncé")
   (texte 20 650 message)
)
(canevas 980 690)
(cache_tortue)
(police "Inter, sans-serif")
(taille_texte 15)
(largeur_saisie 340)
(zone_édition "liste" 20 92 22 case_changée)
(largeur_saisie 170)
(loop i 
   (irange 0 LIGNES 1)
   (saisie (+ "id" (_texte i)) X_IDENTIFIANT (p+ HAUT (* i HAUTEUR_LIGNE)) case_changée)
)
(largeur_saisie 320)
(loop i 
   (irange 0 LIGNES 1)
   (saisie (+ "nom" (_texte i)) X_NOM (p+ HAUT (* i HAUTEUR_LIGNE)) case_changée)
)
(bouton "ajouter" 20 560 "Ajouter au tableau ▶" commande)
(bouton "vider" 20 604 "Vider le tableau" commande)
(setq y_boutons (p+ HAUT (* LIGNES HAUTEUR_LIGNE) 14))
(bouton "précédente" X_TABLEAU y_boutons "◀" commande)
(bouton "suivante" (+ X_TABLEAU 50) y_boutons "▶" commande)
(bouton "enregistrer" (+ X_TABLEAU 400) y_boutons "Enregistrer" commande)
(bouton "recharger" (+ X_TABLEAU 400) (+ y_boutons 44) "Recharger" commande)
(quand_touche touche)
(dessine)
(lit_dans_serveur "élèves.json" chargée)
