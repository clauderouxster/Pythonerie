(import "outils" ())
(setq capitales (lit_csv (charge_données "capitales.csv")))
(setq bravo (charge_son "bravo.wav"))
(setq raté (charge_son "raté.wav"))
(setq points 0)
(setq tour 0)
(defun question_suivante ()
   (check (= tour 5)
      (setq mot "capitales")
      (if (<= points 1)
         (setq mot "capitale")
      )
      (println (+ "Tu as trouvé " (_texte points) " " (_texte mot) " sur 5."))
      (return ())
   )
   (setg tour (+ tour 1))
   (setq (pays capitale) (choisis capitales))
   (demande (+ "Quelle est la capitale du pays " (_texte pays) " ?") corrige (list pays capitale))
)
(defun corrige (réponse question)
   (setq (pays capitale) question)
   (ife (même_mot réponse capitale)
      (block
         (setg points (+ points 1))
         (joue_son bravo)
         (println "Bravo !" (_texte capitale) "est bien la capitale du pays" (_texte pays))
      )
      (joue_son raté)
      (println "Raté : la capitale du pays" (_texte pays) "est" (_texte capitale))
   )
   (question_suivante)
)
(question_suivante)
