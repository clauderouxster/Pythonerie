(setq JOURS_PAR_IMAGE 2)
(setq PLANÈTES
   (list
      (list "Mercure" "mercure.jpg" 0.38 6 88 1408 0)
      (list "Vénus" "vénus.jpg" 0.95 8.5 225 -5832 177)
      (list "Terre" "terre.jpg" 1 11.5 365 24 23)
      (list "Mars" "mars.jpg" 0.53 14.5 687 25 25)
      (list "Jupiter" "jupiter.jpg" 3 21 4333 10 3)
      (list "Saturne" "saturne.jpg" 2.5 29 10759 11 27)
      (list "Uranus" "uranus.jpg" 1.7 36 30687 -17 98)
      (list "Neptune" "neptune.jpg" 1.6 42 60190 16 28)
   )
)
(setq scène (nouvelle_scène))
(setq noms (dictionary))
(setq orbites (list))
(setq rotations (list))
(setq soleil (sphère scène 0 0 0 4))
(texture soleil (charge_image "soleil.jpg"))
(lumineux soleil)
(set@ noms (chaîne soleil) "le Soleil")
(lumière scène 0 0 0 3)
(loop p PLANÈTES
   (setq (nom image rayon distance année jour inclinaison) p)
   (setq orbite (groupe scène))
   (tourne orbite 0 (aléatoire 0 359) 0)
   (setq axe (groupe orbite distance 0 0))
   (oriente_3d axe 0 0 inclinaison)
   (setq planète (sphère axe 0 0 0 rayon))
   (texture planète (charge_image image))
   (set@ noms (chaîne planète) nom)
   (push orbites (list orbite (/ 360 année)))
   (push rotations (list planète (/ 48 jour)))
   (check (= nom "Saturne")
      (setq anneaux (anneau axe 0 0 0 (* rayon 1.3) (* rayon 2.3)))
      (texture anneaux (charge_image "anneau_saturne.png"))
   )
   (check (= nom "Terre")
      (setq orbite_lune (groupe orbite distance 0 0))
      (setq lune (sphère orbite_lune 2 0 0 0.27))
      (texture lune (charge_image "lune.jpg"))
      (set@ noms (chaîne lune) "la Lune")
      (push orbites (list orbite_lune (/ 360 27.3)))
   )
)
(caméra scène 0 42 52 0 0 0)
(montre_3d scène)
(fond "noir")
(caméra_libre)
(setq jours 0)
(setq choisi "Clique sur une planète")
(defun image ()
   (setg jours (p+ jours JOURS_PAR_IMAGE))
   (loop o orbites
      (tourne (at o 0) 0 (* (at o 1) JOURS_PAR_IMAGE) 0)
   )
   (loop r rotations
      (tourne (at r 0) 0 (at r 1) 0)
   )
   (efface)
   (couleur "blanc")
   (taille_texte 18)
   (texte 12 10 (+ "Jour " (_texte jours) "  (année " (_texte (+ (_/ jours 365) 1)) ")"))
   (texte 12 36 choisi)
)
(defun touché (n)
   (if (in_it noms (chaîne n))
      (setg choisi (at noms (chaîne n)))
   )
)
(quand_clic_objet touché)
(println "Textures : Solar System Scope, licence CC BY 4.0 (www.solarsystemscope.com)")
(animer image 16)
