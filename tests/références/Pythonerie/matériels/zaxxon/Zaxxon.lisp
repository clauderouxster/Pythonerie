(setq écran (appareil))
(check (!= (at écran 0) "ordinateur")
   (setq long
      (
         entier
         (*
            600
            (minimum (/ (maximum (at écran 1) (at écran 2)) (minimum (at écran 1) (at écran 2))) 1.8)
         )
      )
   )
   (setq long (maximum long 800))
   (portrait 600 long)
   (paysage long 600)
)
(import "outils/projection" ())
(import "outils/forteresse" ())
(setq plan (charge_données "forteresse.txt"))
(setq son_tir (charge_son "tir.wav"))
(setq son_explosion (charge_son "explosion.wav"))
(setq son_boum (charge_son "boum.wav"))
(setq son_essence (charge_son "ding.wav"))
(setq son_alarme (charge_son "alarme.wav"))
(setq LARGEUR 6)
(setq HAUT_MAX 3.4)
(setq HAUT_MIN 0.3)
(setq HAUT_MUR 3.7)
(setq VUE 21)
(setq couleurs
   (dictionary "canon" (list 200 70 60) "réservoir" (list 70 140 220) "radar" (list 215 185 60))
)
(setq points (dictionary "canon" 200 "réservoir" 150 "radar" 500))
(setq GRIS_SOL (list 115 120 135))
(setq GRIS_MUR (list 150 155 175))
(setq vaisseau_f 0.0)
(setq vaisseau_l 3.0)
(setq vaisseau_h 1.2)
(setq cam_f -3.0)
(setq vitesse 0.07)
(setq invincible 0)
(setq souris_x 300.0)
(setq souris_y 300.0)
(setq mode_souris false)
(setq objets (list))
(setq murs (list))
(setq fin_forteresse 0)
(setq tirs (list))
(setq balles (list))
(setq éclats (list))
(setq score 0)
(setq vies 3)
(setq essence 100.0)
(setq niveau 1)
(setq message "")
(setq durée_message 0)
(setq alarme 0)
(setq tic 0)
(setq état "attente")
(setq étoiles (list))
(setq ZOOM 1)
(setq HAUT_VUE 0)
(setq ancienne_largeur 0)
(setq ancienne_hauteur 0)
(defun place_la_vue ()
   (setg ZOOM (minimum 1 (minimum (/ (largeur) 800) (/ (hauteur) 600))))
   (setg HAUT_VUE (/ (- (hauteur) (* 600 ZOOM)) 2))
   (setg ÉCHELLE (* 26 ZOOM))
   (setg ÉCHELLE_H (* 34 ZOOM))
   (setg ORIGINE_X (p+ (/ (- (largeur) (* 800 ZOOM)) 2) (* 90 ZOOM)))
   (setg ORIGINE_Y (p+ HAUT_VUE (* 440 ZOOM)))
   (setg étoiles
      (mapcar (λ (i) (list (aléatoire 0 (largeur)) (aléatoire 0 (hauteur)))) (irange 0 40 1))
   )
   (setg ancienne_largeur (largeur))
   (setg ancienne_hauteur (hauteur))
)
(defun prépare_forteresse (départ)
   (setq r (lit_forteresse plan départ))
   (setg objets (p+ objets (at r 0)))
   (setg murs (p+ murs (at r 1)))
   (setg fin_forteresse (at r 2))
)
(defun commence ()
   (setg vaisseau_f 0.0)
   (setg vaisseau_l 3.0)
   (setg vaisseau_h 1.2)
   (setg cam_f -3.0)
   (setg objets (list))
   (setg murs (list))
   (prépare_forteresse 12)
   (setg tirs (list))
   (setg balles (list))
   (setg éclats (list))
   (setg score 0)
   (setg vies 3)
   (setg essence 100.0)
   (setg niveau 1)
   (setg vitesse 0.07)
   (setg invincible 60)
   (setg message "")
   (setg état "jeu")
)
(defun feu ()
   (check (!= état "jeu")
      (commence)
      (return ())
   )
   (if (>= (longueur tirs) 3)
      (return ())
   )
   (push tirs (list (p+ vaisseau_f 0.6) vaisseau_l vaisseau_h 40))
   (joue_son son_tir)
)
(defun explose (f l h n c)
   (setq teinte (nuance c 1))
   (loop i 
      (irange 0 n 1)
      (push
         éclats
         (list
            f
            l
            h
            (p+ (* (- (hasard) 0.5) 0.3) vitesse)
            (* (- (hasard) 0.5) 0.3)
            (* (hasard) 0.25)
            (aléatoire 15 35)
            teinte
         )
      )
   )
)
(defun souris (x y)
   (setg souris_x x)
   (setg souris_y y)
   (setg mode_souris true)
)
(setq TACTILE (!= (at (appareil) 0) "ordinateur"))
(setq TIRER "Clic ou Espace")
(if TACTILE
   (setq TIRER "Touche 🔥 Feu")
)
(defun bouton_feu (clef texte)
   (feu)
)
(defun clic (x y)
   (if (andvalue TACTILE (= état "jeu"))
      (return ())
   )
   (feu)
)
(defun clavier (t)
   (setq t (minuscules t))
   (if (= t "espace")
      (feu)
      (if (in_it (list "gauche" "droite" "haut" "bas" "q" "d" "z" "s") t)
         (setg mode_souris false)
      )
   )
)
(defun pilote_clavier ()
   (if (orvalue (touche_enfoncée "gauche") (touche_enfoncée "q"))
      (-= vaisseau_l 0.09)
   )
   (if (orvalue (touche_enfoncée "droite") (touche_enfoncée "d"))
      (setg vaisseau_l (p+ vaisseau_l 0.09))
   )
   (if (orvalue (touche_enfoncée "haut") (touche_enfoncée "z"))
      (setg vaisseau_h (p+ vaisseau_h 0.06))
   )
   (if (orvalue (touche_enfoncée "bas") (touche_enfoncée "s"))
      (-= vaisseau_h 0.06)
   )
)
(defun pilote_souris ()
   (setq d (- vaisseau_f cam_f))
   (setq l (- (/ (- souris_x ORIGINE_X) ÉCHELLE) d))
   (setq h (/ (- (p+ ORIGINE_Y (* (* (- l d) ÉCHELLE) 0.58)) souris_y) ÉCHELLE_H))
   (setg vaisseau_l (p+ vaisseau_l (* (- l vaisseau_l) 0.12)))
   (setg vaisseau_h (p+ vaisseau_h (* (- h vaisseau_h) 0.12)))
)
(defun garde_dans_la_forteresse ()
   (setg vaisseau_l (maximum 0.3 (minimum (- LARGEUR 0.3) vaisseau_l)))
   (setg vaisseau_h (maximum HAUT_MIN (minimum HAUT_MAX vaisseau_h)))
)
(defun perd_un_vaisseau ()
   (if (> invincible 0)
      (return ())
   )
   (explose vaisseau_f vaisseau_l vaisseau_h 25 (list 255 200 80))
   (joue_son son_boum)
   (-= vies 1)
   (setg balles (list))
   (ife (<= vies 0)
      (setg état "perdu")
      (setg invincible 100)
      (setg essence (maximum essence 50.0))
   )
)
(defun passe_les_murs (avant après)
   (loop m murs
      (if (andvalue
            (andvalue (< avant (at m 0)) (>= après (at m 0)))
            (¬ (dans_la_fenêtre m vaisseau_l vaisseau_h 0.2))
         )
         (perd_un_vaisseau)
      )
   )
)
(defun avance_tirs ()
   (setq restants (list))
   (setq touchés (list))
   (loop t tirs
      (setq f (p+ (at t 0) 0.45))
      (setq arrêté (<= (at t 3) 1))
      (loop m murs
         (check (andvalue
               (andvalue (< (at t 0) (at m 0)) (>= f (at m 0)))
               (¬ (dans_la_fenêtre m (at t 1) (at t 2) 0.05))
            )
            (setq arrêté true)
            (explose (at m 0) (at t 1) (at t 2) 4 (list 120 220 255))
         )
      )
      (loop i 
         (irange 0 (longueur objets) 1)
         (setq o (at objets i))
         (check (andvalue
               (andvalue
                  (andvalue (andvalue (¬ arrêté) (¬ (in_it touchés i))) (< (absolu (- (at o 1) f)) 0.5))
                  (< (absolu (- (at o 2) (at t 1))) 0.55)
               )
               (< (at t 2) (p+ (at o 3) 0.4))
            )
            (setq arrêté true)
            (push touchés i)
         )
      )
      (if (¬ arrêté)
         (push restants (list f (at t 1) (at t 2) (- (at t 3) 1)))
      )
   )
   (setg tirs restants)
   (check (> (longueur touchés) 0)
      (setq gardés (list))
      (loop i 
         (irange 0 (longueur objets) 1)
         (setq o (at objets i))
         (if (in_it touchés i)
            (block
               (setg score (p+ score (at points (at o 0))))
               (explose (at o 1) (at o 2) (/ (at o 3) 2) 14 (at couleurs (at o 0)))
               (joue_son son_explosion)
               (check (= (at o 0) "réservoir")
                  (setg essence (minimum 100.0 (+ essence 30)))
                  (joue_son son_essence)
               )
            )
            (push gardés o)
         )
      )
      (setg objets gardés)
   )
)
(defun avance_canons ()
   (setq nouveaux (list))
   (loop o objets
      (setq attente (at o 4))
      (setq écart (- (at o 1) vaisseau_f))
      (check (andvalue (andvalue (= (at o 0) "canon") (> écart 2)) (< écart 10))
         (-= attente 1)
         (check (<= attente 0)
            (vise o)
            (setq attente (maximum 25 (- (aléatoire 70 140) (* niveau 10))))
         )
      )
      (if (> (at o 1) (- cam_f 2))
         (push nouveaux (list (at o 0) (at o 1) (at o 2) (at o 3) attente))
      )
   )
   (setg objets nouveaux)
)
(defun vise (o)
   (setq df (- vaisseau_f (at o 1)))
   (setq dl (- vaisseau_l (at o 2)))
   (setq dh (- vaisseau_h 0.6))
   (setq d (racine (p+ (* df df) (* dl dl) (* dh dh))))
   (setq v (+ 0.12 (* niveau 0.02)))
   (setq écart_l (* (- (hasard) 0.5) 0.08))
   (push
      balles
      (list (- (at o 1) 0.4) (at o 2) 0.6 (* (/ df d) v) (p+ (* (/ dl d) v) écart_l) (* (/ dh d) v))
   )
)
(defun avance_balles ()
   (setq restantes (list))
   (loop b balles
      (setq f (p+ (at b 0) (at b 3)))
      (setq l (p+ (at b 1) (at b 4)))
      (setq h (p+ (at b 2) (at b 5)))
      (if (andvalue
            (andvalue (< (absolu (- f vaisseau_f)) 0.4) (< (absolu (- l vaisseau_l)) 0.45))
            (< (absolu (- h vaisseau_h)) 0.45)
         )
         (perd_un_vaisseau)
         (if (andvalue (> f (- cam_f 1)) (> h 0))
            (push restantes (list f l h (at b 3) (at b 4) (at b 5)))
         )
      )
   )
   (setg balles restantes)
)
(defun touche_le_sol ()
   (loop o objets
      (if (andvalue
            (andvalue (< (absolu (- (at o 1) vaisseau_f)) 0.45) (< (absolu (- (at o 2) vaisseau_l)) 0.6))
            (< vaisseau_h (p+ (at o 3) 0.15))
         )
         (perd_un_vaisseau)
      )
   )
)
(defun avance_éclats ()
   (setq restants (list))
   (loop e éclats
      (if (> (at e 6) 1)
         (push
            restants
            (list
               (p+ (at e 0) (at e 3))
               (p+ (at e 1) (at e 4))
               (maximum 0.0 (p+ (at e 2) (at e 5)))
               (at e 3)
               (at e 4)
               (- (at e 5) 0.015)
               (- (at e 6) 1)
               (at e 7)
            )
         )
      )
   )
   (setg éclats restants)
)
(defun consomme_essence ()
   (-= essence (+ 0.035 (* niveau 0.005)))
   (check (<= essence 0)
      (setg essence 0.0)
      (setg message "Panne d'essence !")
      (setg durée_message 90)
      (perd_un_vaisseau)
      (setg essence 60.0)
   )
   (check (< essence 25)
      (-= alarme 1)
      (check (<= alarme 0)
         (joue_son son_alarme)
         (setg alarme 30)
      )
   )
)
(defun avance_jeu ()
   (setq avant vaisseau_f)
   (setg vaisseau_f (p+ vaisseau_f vitesse))
   (setg cam_f (- vaisseau_f 3))
   (if mode_souris
      (pilote_souris)
      (pilote_clavier)
   )
   (garde_dans_la_forteresse)
   (passe_les_murs avant vaisseau_f)
   (touche_le_sol)
   (avance_tirs)
   (avance_canons)
   (avance_balles)
   (consomme_essence)
   (setg murs (filtercar (λ (m) (> (at m 0) (- cam_f 2))) murs))
   (check (> vaisseau_f (+ fin_forteresse 2))
      (+= niveau 1)
      (setg vitesse (p+ vitesse 0.012))
      (+= score 1000)
      (setg message (+ "Forteresse franchie ! Niveau " (_texte niveau)))
      (setg durée_message 150)
      (prépare_forteresse (p+ vaisseau_f VUE))
   )
   (if (> invincible 0)
      (-= invincible 1)
   )
)
(defun défile ()
   (setg vaisseau_f (p+ vaisseau_f 0.04))
   (setg cam_f (- vaisseau_f 3))
   (check (> vaisseau_f fin_forteresse)
      (setg vaisseau_f 0.0)
      (setg cam_f -3.0)
      (setg objets (list))
      (setg murs (list))
      (prépare_forteresse 12)
   )
)
(defun dessine_sol ()
   (setq début (- cam_f 1))
   (setq fin (p+ cam_f VUE))
   (couleur (nuance GRIS_SOL 0.45))
   (
      polygone_plein
      (list
         (point_écran début LARGEUR 0)
         (point_écran fin LARGEUR 0)
         (point_écran fin LARGEUR -1.2)
         (point_écran début LARGEUR -1.2)
      )
   )
   (couleur (nuance GRIS_SOL 1))
   (
      polygone_plein
      (list
         (point_écran début 0 0)
         (point_écran début LARGEUR 0)
         (point_écran fin LARGEUR 0)
         (point_écran fin 0 0)
      )
   )
   (couleur (nuance GRIS_SOL 0.8))
   (épaisseur 1)
   (loop l 
      (irange 1 LARGEUR 1)
      (ligne_monde début l 0 fin l 0)
   )
   (setq f (* (entier (/ début RANGÉE)) RANGÉE))
   (while (< f fin) (if (> f début) (ligne_monde f 0 0 f LARGEUR 0)) (setq f (p+ f RANGÉE)))
   (boîte début -0.5 0 (+ VUE 1) 0.5 0.6 GRIS_MUR)
)
(defun dessine_ombre ()
   (couleur (rgb 60 62 72))
   (
      ellipse_pleine
      (écran_x vaisseau_f vaisseau_l)
      (écran_y vaisseau_f vaisseau_l 0)
      (* 20 ZOOM)
      (* 10 ZOOM)
   )
)
(defun dessine_objet (o)
   (setq f (at o 1))
   (setq l (at o 2))
   (setq c (at couleurs (at o 0)))
   (if (= (at o 0) "canon")
      (block
         (boîte (- f 0.35) (- l 0.35) 0 0.7 0.7 0.45 c)
         (boîte (- f 0.75) (- l 0.1) 0.25 0.45 0.2 0.18 (list 90 90 100))
      )
      (if (= (at o 0) "réservoir")
         (block
            (boîte (- f 0.4) (- l 0.4) 0 0.8 0.8 0.9 c)
            (couleur "blanc")
            (taille_texte 15)
            (texte (- (écran_x (- f 0.4) l) 5) (écran_y (- f 0.4) l 0.75) "E")
         )
         (check (= (at o 0) "radar")
            (boîte (- f 0.3) (- l 0.3) 0 0.6 0.6 0.6 (list 120 120 135))
            (couleur (nuance c 1))
            (ellipse_pleine (écran_x f l) (écran_y f l 1.05) (p+ 4 (* 10 (absolu (sinus (* tic 4))))) 7)
         )
      )
   )
)
(defun dessine_mur (m)
   (setq f (at m 0))
   (setq a (at m 1))
   (setq b (at m 2))
   (setq épais 0.25)
   (if (> a 0)
      (boîte f 0 0 épais a HAUT_MUR GRIS_MUR)
   )
   (if (> b 0)
      (boîte f a 0 épais FENÊTRE_L b GRIS_MUR)
   )
   (boîte f a (p+ b FENÊTRE_H) épais FENÊTRE_L (- (- HAUT_MUR b) FENÊTRE_H) GRIS_MUR)
   (if (< (p+ a FENÊTRE_L) LARGEUR)
      (boîte f (p+ a FENÊTRE_L) 0 épais (- (- LARGEUR a) FENÊTRE_L) HAUT_MUR GRIS_MUR)
   )
   (couleur "cyan")
   (épaisseur 2)
   (ligne_monde f a b f (p+ a FENÊTRE_L) b)
   (ligne_monde f (p+ a FENÊTRE_L) b f (p+ a FENÊTRE_L) (p+ b FENÊTRE_H))
   (ligne_monde f (p+ a FENÊTRE_L) (p+ b FENÊTRE_H) f a (p+ b FENÊTRE_H))
   (ligne_monde f a (p+ b FENÊTRE_H) f a b)
   (épaisseur 1)
)
(defun dessine_vaisseau ()
   (if (andvalue (> invincible 0) (= (_% (_/ invincible 5) 2) 0))
      (return ())
   )
   (setq x (écran_x vaisseau_f vaisseau_l))
   (setq y (écran_y vaisseau_f vaisseau_l vaisseau_h))
   (couleur (rgb 90 95 110))
   (ligne x y x (écran_y vaisseau_f vaisseau_l 0))
   (setq ax 0.866)
   (setq ay -0.5)
   (setq cx 0.866)
   (setq cy 0.5)
   (setq ax (* ax ZOOM))
   (setq ay (* ay ZOOM))
   (setq cx (* cx ZOOM))
   (setq cy (* cy ZOOM))
   (setq nez (list (p+ x (* ax 30)) (p+ y (* ay 30))))
   (setq aile_g (list (- (- x (* ax 10)) (* cx 20)) (- (- y (* ay 10)) (* cy 20))))
   (setq aile_d (list (p+ (- x (* ax 10)) (* cx 20)) (p+ (- y (* ay 10)) (* cy 20))))
   (setq queue (list (- x (* ax 15)) (- y (* ay 15))))
   (couleur (rgb 225 228 240))
   (polygone_plein (list nez aile_d queue aile_g))
   (couleur (rgb 150 155 175))
   (polygone_plein (list nez aile_d queue))
   (couleur (rgb 200 70 60))
   (
      triangle_plein
      (at queue 0)
      (at queue 1)
      (- x (* ax 5))
      (- y (* ay 5))
      (- x (* ax 11))
      (- (- y (* ay 11)) (* 15 ZOOM))
   )
   (couleur "cyan")
   (ellipse_pleine (p+ x (* ax 10)) (- (p+ y (* ay 10)) 2) 6 4)
   (couleur "orange")
   (disque (- (at queue 0) (* ax 4)) (- (at queue 1) (* ay 4)) (p+ 4 (aléatoire 0 2)))
)
(defun dessine_monde ()
   (setq i (- (longueur objets) 1))
   (setq j (- (longueur murs) 1))
   (setq vaisseau_dessiné (!= état "jeu"))
   (while (orvalue (>= i 0) (>= j 0))
      (setq fo -1000)
      (if (>= i 0)
         (setq fo (at objets i 1))
      )
      (setq fm -1000)
      (if (>= j 0)
         (setq fm (at murs j 0))
      )
      (setq f (maximum fo fm))
      (if (< f (- cam_f 2))
         (break)
      )
      (check (andvalue (¬ vaisseau_dessiné) (< f vaisseau_f))
         (dessine_vaisseau)
         (setq vaisseau_dessiné true)
      )
      (ife (>= fo fm)
         (block (if (< fo (p+ cam_f VUE)) (dessine_objet (at objets i))) (-= i 1))
         (if (< fm (p+ cam_f VUE))
            (dessine_mur (at murs j))
         )
         (-= j 1)
      )
   )
   (if (¬ vaisseau_dessiné)
      (dessine_vaisseau)
   )
)
(defun dessine_tirs ()
   (loop t tirs
      (couleur (rgb 60 62 72))
      (disque (écran_x (at t 0) (at t 1)) (écran_y (at t 0) (at t 1) 0) 2)
      (couleur "jaune")
      (disque (écran_x (at t 0) (at t 1)) (écran_y (at t 0) (at t 1) (at t 2)) 4)
   )
   (loop b balles
      (couleur (rgb 60 62 72))
      (disque (écran_x (at b 0) (at b 1)) (écran_y (at b 0) (at b 1) 0) 2)
      (couleur "orange")
      (disque (écran_x (at b 0) (at b 1)) (écran_y (at b 0) (at b 1) (at b 2)) 5)
   )
   (loop e éclats
      (couleur (at e 7))
      (disque (écran_x (at e 0) (at e 1)) (écran_y (at e 0) (at e 1) (at e 2)) 3)
   )
)
(defun dessine_tableau_de_bord ()
   (setq haut (p+ HAUT_VUE (* 120 ZOOM)))
   (setq bas (p+ HAUT_VUE (* 420 ZOOM)))
   (couleur (rgb 30 32 45))
   (rectangle_plein 18 haut 18 (- bas haut))
   (couleur "gris clair")
   (épaisseur 1)
   (rectangle 18 haut 18 (- bas haut))
   (setq y (- bas (* (/ vaisseau_h HAUT_MAX) (- bas haut))))
   (couleur "vert clair")
   (rectangle_plein 19 y 16 (- bas y))
   (couleur "blanc")
   (triangle_plein 38 y 48 (- y 6) 48 (+ y 6))
   (taille_texte 12)
   (texte 14 (- haut 18) "ALT")
   (taille_texte 14)
   (couleur "blanc")
   (setq bas_essence (- (hauteur) 40))
   (texte 20 bas_essence "Essence")
   (couleur (rgb 30 32 45))
   (rectangle_plein 90 bas_essence 200 14)
   (if (< essence 25)
      (couleur "rouge")
      (couleur "jaune")
   )
   (rectangle_plein 90 bas_essence (* essence 2) 14)
   (couleur "gris clair")
   (rectangle 90 bas_essence 200 14)
   (taille_texte 18)
   (couleur "blanc")
   (texte 20 12 (+ "Score : " (_texte score)))
   (texte (- (/ (largeur) 2) 70) 12 (+ "Niveau " (_texte niveau)))
   (texte (- (largeur) 160) 12 (+ "Vaisseaux : " (_texte vies)))
)
(defun texte_centré (y t)
   (texte (/ (- (largeur) (largeur_texte t)) 2) (p+ HAUT_VUE y) t)
)
(defun dessine ()
   (fond "noir")
   (couleur "blanc")
   (loop étoile étoiles
      (point (at étoile 0) (at étoile 1))
   )
   (dessine_sol)
   (if (= état "jeu")
      (dessine_ombre)
   )
   (dessine_monde)
   (dessine_tirs)
   (dessine_tableau_de_bord)
   (check (> durée_message 0)
      (couleur "jaune")
      (taille_texte 26)
      (texte_centré 70 message)
   )
   (if (= état "attente")
      (block
         (couleur "cyan")
         (taille_texte 54)
         (texte_centré 150 "ZAXXON")
         (couleur "blanc")
         (taille_texte 20)
         (texte_centré 230 (+ (_texte TIRER) " : décoller"))
      )
      (check (= état "perdu")
         (couleur "rouge clair")
         (taille_texte 34)
         (texte_centré 160 "Partie terminée")
         (couleur "blanc")
         (taille_texte 20)
         (texte_centré 220 (+ "Score : " (_texte score) ", niveau " (_texte niveau)))
         (texte_centré 255 (+ (_texte TIRER) " : rejouer"))
      )
   )
)
(defun recale ()
   (place_la_vue)
   (place_bouton_feu)
)
(defun place_bouton_feu ()
   (check TACTILE
      (taille_texte 26)
      (bouton "feu" (- (largeur) 140) (- (hauteur) 65) "🔥 Feu" bouton_feu)
   )
)
(defun image ()
   (if (orvalue (!= (largeur) ancienne_largeur) (!= (hauteur) ancienne_hauteur))
      (recale)
   )
   (+= tic 1)
   (if (= état "jeu")
      (avance_jeu)
      (if (= état "attente")
         (défile)
      )
   )
   (avance_éclats)
   (if (> durée_message 0)
      (-= durée_message 1)
   )
   (dessine)
)
(cache_tortue)
(place_la_vue)
(prépare_forteresse 12)
(quand_souris souris)
(quand_glisse souris)
(place_bouton_feu)
(quand_clic clic)
(quand_touche clavier)
(animer image 20)
