(setq RANGÉE 1.5)
(setq FENÊTRE_L 2)
(setq FENÊTRE_H 1.6)
(defun lit_forteresse (plan départ)
   (setq objets (list))
   (setq murs (list))
   (setq f départ)
   (loop rangée 
      (découpe plan "\n")
      (setq rangée (nettoie rangée))
      (if (orvalue (= rangée "") (startwith rangée "#"))
         (continue)
      )
      (if (startwith rangée "mur")
         (block
            (setq morceaux (découpe rangée " "))
            (push murs (list f (entier (at morceaux 1)) (entier (at morceaux 2))))
         )
         (loop i 
            (intervalle (minimum 6 (longueur rangée)))
            (setq c (majuscules (at rangée i)))
            (if (= c "C")
               (push objets (list "canon" f (p+ i 0.5) 0.75 (aléatoire 30 120)))
               (if (= c "E")
                  (push objets (list "réservoir" f (p+ i 0.5) 0.9 0))
                  (if (= c "R")
                     (push objets (list "radar" f (p+ i 0.5) 1.2 0))
                  )
               )
            )
         )
      )
      (setq f (p+ f RANGÉE))
   )
   (return (list objets murs f))
)
(defun dans_la_fenêtre (mur l h marge)
   (setq a (at mur 1))
   (setq b (at mur 2))
   (return
      (andvalue
         (andvalue (andvalue (> l (p+ a marge)) (< l (- (p+ a FENÊTRE_L) marge))) (> h (p+ b marge)))
         (< h (- (p+ b FENÊTRE_H) marge))
      )
   )
)
